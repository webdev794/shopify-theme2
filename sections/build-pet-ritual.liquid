          "default": 2999
        },
        {
          "type": "product",
          "id": "option_1_product",
          "label": "Option 1 product (optional)"
        },
        {
          "type": "text",
          "id": "option_2_label",
          "label": "Option 2 label",
          "default": "Salmon Sensitive"
        },
        {
          "type": "number",
          "id": "option_2_price",
