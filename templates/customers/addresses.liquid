{{ 'customer-accounts.css' | asset_url | stylesheet_tag }}
<div class="customer customer--addresses">
  <div class="customer__container">
    <p class="customer__back"><a href="{{ routes.account_url }}">← Return to account</a></p>
    <h1 class="customer__heading">Addresses</h1>
    <div class="customer__address-list">
      {% for address in customer.addresses %}
        <div class="customer__address-card{% if address == customer.default_address %} is-default{% endif %}">
          {% if address == customer.default_address %}<span class="customer__default-badge">Default</span>{% endif %}
          {{ address | format_address }}
        </div>
      {% endfor %}
    </div>
    <h2 class="customer__subheading">Add a new address</h2>
    {% form 'customer_address', customer.new_address, class: 'customer__form' %}
      <div class="customer__field-row">
        <div class="customer__field"><label for="AddressFirstName">First name</label><input type="text" name="address[first_name]" id="AddressFirstName" autocomplete="given-name"></div>
        <div class="customer__field"><label for="AddressLastName">Last name</label><input type="text" name="address[last_name]" id="AddressLastName" autocomplete="family-name"></div>
      </div>
      <div class="customer__field"><label for="AddressAddress1">Address</label><input type="text" name="address[address1]" id="AddressAddress1" autocomplete="address-line1"></div>
      <div class="customer__field"><label for="AddressCity">City</label><input type="text" name="address[city]" id="AddressCity" autocomplete="address-level2"></div>
      <div class="customer__field"><label for="AddressZip">Postal/ZIP</label><input type="text" name="address[zip]" id="AddressZip" autocomplete="postal-code"></div>
      <div class="customer__field"><label for="AddressCountry">Country</label><input type="text" name="address[country]" id="AddressCountry" autocomplete="country-name"></div>
      <button type="submit" class="button button--primary">Add address</button>
    {% endform %}
  </div>
</div>
