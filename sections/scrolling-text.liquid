{% comment %}
  Scrolling Text Section
  Version: 1.0
  Description: A full-width scrolling text marquee for announcements, promotions, or brand messages
{% endcomment %}

{{ 'scrolling-text.css' | asset_url | stylesheet_tag }}

<div class="scrolling-text" 
     data-section-id="{{ section.id }}" 
     data-section-type="scrolling-text" data-scroll-velocity="{{ section.settings.scroll_velocity }}" data-base-speed="{{ section.settings.speed | default: 30 }}"
     data-pause-on-hover="{{ section.settings.pause_on_hover }}"
     role="region"
     aria-label="{{ section.settings.aria_label | escape }}"
     style="
       --st-bg: {{ section.settings.background_color }};
       --st-text-color: {{ section.settings.text_color }};
       --st-font-size: {{ section.settings.font_size }}px;
       --st-speed: {{ section.settings.speed }}s;
       --st-gap: {{ section.settings.gap }}px;
     ">
  <div class="scrolling-text__wrapper">
    <div class="scrolling-text__track">
      {%- assign repeat_count = section.settings.repeat_count | default: 3 -%}
      {%- for i in (1..repeat_count) -%}
        {%- for block in section.blocks -%}
          <div class="scrolling-text__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="scrolling-text__icon">
                {%- render 'icon', icon: block.settings.icon -%}
              </span>
            {%- endif -%}
            <span class="scrolling-text__text">
              {{ block.settings.text | escape }}
            </span>
            {%- if section.settings.show_divider -%}
              <span class="scrolling-text__divider">{{ section.settings.divider_symbol }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.scrolling_text.name",
  "tag": "section",
  "class": "scrolling-text-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.scrolling_text.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:sections.scrolling_text.settings.speed.label",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s",
      "info": "t:sections.scrolling_text.settings.speed.info"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:sections.scrolling_text.settings.gap.label",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "repeat_count",
      "label": "t:sections.scrolling_text.settings.repeat_count.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "info": "t:sections.scrolling_text.settings.repeat_count.info"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.scrolling_text.settings.show_divider.label",
      "default": true
    },
    {
      "type": "text",
      "id": "divider_symbol",
      "label": "t:sections.scrolling_text.settings.divider_symbol.label",
      "default": "•"
    },
    {
      "type": "header",
      "content": "t:sections.scrolling_text.settings.header__2.content"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:sections.scrolling_text.settings.font_size.label",
      "min": 14,
      "max": 48,
      "step": 2,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.scrolling_text.settings.background_color.label",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.scrolling_text.settings.text_color.label",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "t:sections.scrolling_text.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.scrolling_text.settings.pause_on_hover.label",
      "default": true,
      "info": "t:sections.scrolling_text.settings.pause_on_hover.info"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.scrolling_text.settings.aria_label.label",
      "default": "Scrolling announcement bar"
    },
    {
      "type": "checkbox",
      "id": "scroll_velocity",
      "label": "Link speed to page scroll",
      "default": true,
      "info": "Ticker speeds up as the visitor scrolls"
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "t:sections.scrolling_text.blocks.text_item.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.scrolling_text.blocks.text_item.settings.text.label",
          "default": "Free shipping on orders over $50",
          "info": "t:sections.scrolling_text.blocks.text_item.settings.text.info"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.label",
          "options": [
            {
              "value": "none",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__1.label"
            },
            {
              "value": "star",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__2.label"
            },
            {
              "value": "heart",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__3.label"
            },
            {
              "value": "check",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__4.label"
            },
            {
              "value": "truck",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__5.label"
            },
            {
              "value": "shield",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__6.label"
            },
            {
              "value": "clock",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__7.label"
            },
            {
              "value": "gift",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__8.label"
            },
            {
              "value": "tag",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__9.label"
            },
            {
              "value": "phone",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__10.label"
            },
            {
              "value": "chat",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__11.label"
            },
            {
              "value": "globe",
              "label": "t:sections.scrolling_text.blocks.text_item.settings.icon.options__12.label"
            }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.scrolling_text.presets.name",
      "blocks": [
        {
          "type": "text_item",
          "settings": {
            "text": "Free shipping on orders over $50",
            "icon": "truck"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "30-day money-back guarantee",
            "icon": "shield"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "Subscribe and save 10%",
            "icon": "star"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "Customer support available 24/7",
            "icon": "chat"
          }
        }
      ]
    }
  ]
}
{% endschema %}