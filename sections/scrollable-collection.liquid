{% comment %}
  Scrollable Collection Section
  Version: 1.0
  Description: A horizontally scrollable collection of products with add-to-cart functionality
{% endcomment %}

{{ 'scrollable-collection.css' | asset_url | stylesheet_tag }}

<div class="scrollable-collection" 
     data-section-id="{{ section.id }}" 
     data-section-type="scrollable-collection"
     role="region"
     aria-label="{{ section.settings.aria_label | escape }}"
     style="
       --sc-background: {{ section.settings.background_color }};
       --sc-card-background: {{ section.settings.card_background }};
       --sc-text-color: {{ section.settings.text_color }};
       --sc-accent-color: {{ section.settings.accent_color }};
     ">
  
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="scrollable-collection__header">
        <div class="scrollable-collection__header-left">
          <h2 class="scrollable-collection__heading">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="scrollable-collection__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        
        {%- if section.settings.show_view_all and section.settings.collection != blank -%}
          <a href="{{ collections[section.settings.collection].url }}" class="scrollable-collection__view-all">
            {{ section.settings.view_all_text | default: 'View All' | escape }}
            <span class="scrollable-collection__view-all-arrow">→</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="scrollable-collection__wrapper">
    <div class="scrollable-collection__track">
      {%- assign products = collections[section.settings.collection].products -%}
      {%- if products.size > 0 -%}
        {%- assign product_limit = section.settings.product_limit | default: 12 -%}
        {%- for product in products limit: product_limit -%}
          <div class="scrollable-collection__product" data-product-id="{{ product.id }}">
            <div class="scrollable-collection__product-card">
              <a href="{{ product.url }}" class="scrollable-collection__product-link">
                <div class="scrollable-collection__product-image-wrapper">
                  {%- if product.featured_image != blank -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center' }}"
                      srcset="{{ product.featured_image | image_url: width: 400, height: 400, crop: 'center' }} 1x, {{ product.featured_image | image_url: width: 800, height: 800, crop: 'center' }} 2x"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="400"
                      height="400"
                      class="scrollable-collection__product-image"
                    >
                  {%- else -%}
                    <div class="scrollable-collection__product-placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'scrollable-collection__placeholder-svg' }}
                    </div>
                  {%- endif -%}

                  {%- if product.compare_at_price > product.price -%}
                    <span class="scrollable-collection__badge">{{ 'products.product.on_sale' | t }}</span>
                  {%- endif -%}

                  {%- if section.settings.show_quick_add -%}
                    <button class="scrollable-collection__quick-add" 
                            data-product-id="{{ product.id }}" 
                            data-variant-id="{{ product.first_available_variant.id }}"
                            type="button"
                            aria-label="{{ 'products.product.quick_add' | t }}">
                      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                        <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                      </svg>
                    </button>
                  {%- endif -%}
                </div>

                <div class="scrollable-collection__product-info">
                  {%- if section.settings.show_vendor and product.vendor != blank -%}
                    <p class="scrollable-collection__product-vendor">{{ product.vendor }}</p>
                  {%- endif -%}

                  <h3 class="scrollable-collection__product-title">{{ product.title }}</h3>

                  {%- if section.settings.show_rating -%}
                    <div class="scrollable-collection__product-rating">
                      <span class="scrollable-collection__stars">
                        {%- assign rating = product.metafields.reviews.rating.value | round -%}
                        {%- for i in (1..5) -%}
                          {%- if i <= rating -%}
                            ★
                          {%- else -%}
                            ☆
                          {%- endif -%}
                        {%- endfor -%}
                      </span>
                      {%- if product.metafields.reviews.rating_count.value -%}
                        <span class="scrollable-collection__review-count">
                          ({{ product.metafields.reviews.rating_count.value }})
                        </span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <div class="scrollable-collection__product-price">
                    {%- if product.compare_at_price > product.price -%}
                      <span class="scrollable-collection__product-price-compare">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                    <span class="scrollable-collection__product-price-current">{{ product.price | money }}</span>
                  </div>
                </div>
              </a>

              <div class="scrollable-collection__product-actions">
                {%- if product.available -%}
                  <button class="scrollable-collection__add-to-cart btn btn--primary btn--small" 
                          data-product-id="{{ product.id }}" 
                          data-variant-id="{{ product.first_available_variant.id }}"
                          type="button">
                    {{ 'products.product.add_to_cart' | t }}
                  </button>
                {%- else -%}
                  <button class="scrollable-collection__sold-out btn btn--disabled btn--small" disabled>
                    {{ 'products.product.sold_out' | t }}
                  </button>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="scrollable-collection__empty">
          <p>{{ 'sections.scrollable_collection.empty' | t }}</p>
          {%- if shop.editor_mode -%}
            <p><small>Select a collection in section settings</small></p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if products.size > section.settings.visible_count -%}
      <div class="scrollable-collection__controls">
        <button class="scrollable-collection__control scrollable-collection__control--prev" type="button" aria-label="{{ 'sections.scrollable_collection.scroll_left' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>
        <button class="scrollable-collection__control scrollable-collection__control--next" type="button" aria-label="{{ 'sections.scrollable_collection.scroll_right' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'scrollable-collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.scrollable_collection.name",
  "tag": "section",
  "class": "scrollable-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.scrollable_collection.settings.heading.label",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.scrollable_collection.settings.subheading.label",
      "default": "Explore our curated selection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.scrollable_collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:sections.scrollable_collection.settings.product_limit.label",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "visible_count",
      "label": "t:sections.scrollable_collection.settings.visible_count.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "t:sections.scrollable_collection.settings.visible_count.info"
    },
    { "type": "header", "content": "t:sections.scrollable_collection.settings.header__1.content" },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.scrollable_collection.settings.show_vendor.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:sections.scrollable_collection.settings.show_rating.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.scrollable_collection.settings.show_quick_add.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.scrollable_collection.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "t:sections.scrollable_collection.settings.view_all_text.label",
      "default": "View All"
    },
    { "type": "header", "content": "t:sections.scrollable_collection.settings.header__2.content" },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.scrollable_collection.settings.background_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:sections.scrollable_collection.settings.card_background.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.scrollable_collection.settings.text_color.label",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.scrollable_collection.settings.accent_color.label",
      "default": "#0066cc"
    },
    { "type": "header", "content": "t:sections.scrollable_collection.settings.header__3.content" },
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.scrollable_collection.settings.aria_label.label",
      "default": "Scrollable product collection"
    }
  ],
  "presets": [
    {
      "name": "t:sections.scrollable_collection.presets.name",
      "category": "Collection"
    }
  ]
}
{% endschema %}
