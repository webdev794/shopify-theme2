{%- comment -%}
  The Suvara Ritual
  Modified Images with Text Carousel — editorial story section
  Large image ~60% | Text ~40%  |  2–3 lifestyle slides that continue the Hero narrative
{%- endcomment -%}

{%- liquid
  assign carousel_label = section.settings.carousel_label
  if carousel_label == blank
    assign carousel_label = 'The Suvara Ritual'
  endif
-%}

{{ 'images-with-text-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'images-with-text-carousel.js' | asset_url }}" defer></script>

<div
  class="iwt-carousel iwt-carousel--image-{{ section.settings.image_position }}{% if section.settings.full_width %} iwt-carousel--full-width{% endif %}"
  style="
    --iwt-background: {{ section.settings.color_background }};
    --iwt-foreground: {{ section.settings.color_foreground }};
    --iwt-accent: {{ section.settings.color_accent }};
    --iwt-aspect: {{ section.settings.aspect_ratio }};
  "
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ carousel_label | escape }}"
  data-iwt-carousel
  {% if section.settings.autoplay %}
    data-autoplay
    data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  {% endif %}
>
  <div class="iwt-carousel__scroller" data-iwt-scroller tabindex="0">
    {%- for block in section.blocks -%}
      {%- liquid
        assign image = block.settings.image
        assign focal_style = nil
        if image.presentation.focal_point
          assign focal_style = 'object-position: ' | append: image.presentation.focal_point
        endif

        if section.index == 1 and forloop.first
          assign loading = 'eager'
          assign fetchpriority = 'high'
        else
          assign loading = 'lazy'
          assign fetchpriority = 'auto'
        endif
      -%}

      <div
        class="iwt-carousel__slide"
        role="group"
        aria-roledescription="slide"
        aria-label="Slide {{ forloop.index }} of {{ forloop.length }}"
        {{ block.shopify_attributes }}
        data-iwt-slide
      >
        <div class="iwt-carousel__media">
          {%- if image != blank -%}
            {{
              image
              | image_url: width: 2000
              | image_tag:
                class: 'iwt-carousel__image',
                widths: '550, 750, 1100, 1500, 2000',
                sizes: '(max-width: 989px) 100vw, 60vw',
                loading: loading,
                fetchpriority: fetchpriority,
                alt: image.alt,
                style: focal_style
            }}
          {%- else -%}
            {%- assign placeholder_index = forloop.index0 | modulo: 2 | plus: 1 -%}
            {{ 'lifestyle-' | append: placeholder_index | placeholder_svg_tag: 'iwt-carousel__placeholder' }}
          {%- endif -%}
        </div>

        <div class="iwt-carousel__content">
          {%- if block.settings.caption != blank -%}
            <p class="iwt-carousel__caption">{{ block.settings.caption | escape }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="iwt-carousel__heading iwt-carousel__heading--{{ section.settings.heading_size }}">
              {{ block.settings.heading }}
            </h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="iwt-carousel__text">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a
              {% if block.settings.button_link != blank %}href="{{ block.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
              class="iwt-carousel__button button {% if block.settings.button_style == 'secondary' %}button--secondary iwt-carousel__button--secondary{% else %}button--primary iwt-carousel__button--primary{% endif %}"
            >
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="iwt-carousel__controls">
      {%- if section.settings.show_arrows -%}
        <button
          type="button"
          class="iwt-carousel__arrow iwt-carousel__arrow--prev"
          aria-label="Previous slide"
          data-iwt-prev
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if section.settings.show_dots -%}
        <div class="iwt-carousel__dots" data-iwt-dots>
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="iwt-carousel__dot"
              aria-label="Go to slide {{ forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
              data-iwt-dot="{{ forloop.index0 }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_arrows -%}
        <button
          type="button"
          class="iwt-carousel__arrow iwt-carousel__arrow--next"
          aria-label="Next slide"
          data-iwt-next
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if section.settings.autoplay -%}
        <button
          type="button"
          class="iwt-carousel__playback"
          aria-label="Pause carousel"
          data-play-label="Play carousel"
          data-iwt-playback
        >
          <svg class="iwt-carousel__playback-icon iwt-carousel__playback-icon--pause" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
          <svg class="iwt-carousel__playback-icon iwt-carousel__playback-icon--play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7 4.5v15l13-7.5-13-7.5z"/>
          </svg>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "The Suvara Ritual",
  "tag": "section",
  "class": "section-iwt-carousel section-suvara-ritual",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "carousel_label",
      "label": "Accessibility label",
      "default": "The Suvara Ritual",
      "info": "Used by screen readers"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "left", "label": "Left (~60%)" },
        { "value": "right", "label": "Right (~60%)" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "4 / 3",
      "info": "Recommended: 4:3 or 3:4 for editorial lifestyle images"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Carousel controls"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true,
      "info": "Gentle auto-advance helps the story feel continuous after the Hero"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 4,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#F7F4EE"
    },
    {
      "type": "color",
      "id": "color_foreground",
      "label": "Text",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent / buttons",
      "default": "#1A1A1A"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Ritual slide",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle image",
          "info": "Use emotional, photographic ritual imagery (woman applying serum, close-up of skin, natural light). Avoid hard product packshots."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Eyebrow / caption",
          "default": "THE SUVARA RITUAL"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Your skin deserves a moment of its own."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Thoughtfully crafted essentials designed to make your everyday ritual feel extraordinary.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Discover Our Story"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The Suvara Ritual",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "caption": "THE SUVARA RITUAL",
            "heading": "Your skin deserves a moment of its own.",
            "text": "<p>Thoughtfully crafted essentials designed to make your everyday ritual feel extraordinary.</p>",
            "button_label": "Discover Our Story",
            "button_style": "primary"
          }
        },
        {
          "type": "slide",
          "settings": {
            "caption": "THE SUVARA RITUAL",
            "heading": "Nourish. Restore. Glow.",
            "text": "<p>A simple, intentional sequence that turns daily care into a quiet luxury.</p>",
            "button_label": "Discover Our Story",
            "button_style": "primary"
          }
        },
        {
          "type": "slide",
          "settings": {
            "caption": "THE SUVARA RITUAL",
            "heading": "Made for the everyday extraordinary.",
            "text": "<p>Clean formulas. Sensorial textures. Results you can feel and see.</p>",
            "button_label": "Discover Our Story",
            "button_style": "primary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
