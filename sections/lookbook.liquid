{{ 'lookbook.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lookbook.js' | asset_url }}" defer></script>

<section
  class="petlio-lookbook"
  data-section-type="lookbook"
  data-section-id="{{ section.id }}"
  style="
    --lookbook-dot: {{ section.settings.color_dot }};
    --lookbook-card-bg: {{ section.settings.color_card_background }};
    --lookbook-card-fg: {{ section.settings.color_card_foreground }};
  "
>
  <div class="petlio-lookbook__container">

    <header class="petlio-lookbook__header">

      <div class="petlio-lookbook__chapter">
        <span class="petlio-lookbook__chapter-number">06</span>
        <span class="petlio-lookbook__chapter-line"></span>
        <span class="petlio-lookbook__chapter-label">
          SHOP / DISCOVER
        </span>
      </div>

      {% if section.settings.heading != blank %}
        <h2 class="petlio-lookbook__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="petlio-lookbook__intro">
          {{ section.settings.text }}
        </div>
      {% endif %}

    </header>


    <div class="petlio-lookbook__scene">

      <div class="petlio-lookbook__scene-background">

        <div class="petlio-lookbook__arch"></div>

        <div class="petlio-lookbook__sun"></div>

        <div class="petlio-lookbook__floor"></div>

        <div class="petlio-lookbook__shape petlio-lookbook__shape--one"></div>
        <div class="petlio-lookbook__shape petlio-lookbook__shape--two"></div>

        <div class="petlio-lookbook__plant petlio-lookbook__plant--left">
          <span></span>
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="petlio-lookbook__plant petlio-lookbook__plant--right">
          <span></span>
          <span></span>
          <span></span>
        </div>

      </div>


      <div class="petlio-lookbook__scene-copy">

        <span class="petlio-lookbook__scene-kicker">
          ONE LOOK
        </span>

        <span class="petlio-lookbook__scene-title">
          Everything together.
        </span>

        <span class="petlio-lookbook__scene-note">
          Tap a point to discover.
        </span>

      </div>


      {% for block in section.blocks %}

        {% assign product = block.settings.product %}

        {% if product != blank %}

          <div
            class="petlio-lookbook__hotspot-wrap"
            data-hotspot
            data-product-id="{{ product.id }}"
            data-hotspot-index="{{ forloop.index }}"
            style="
              --hotspot-x: {{ block.settings.position_x }}%;
              --hotspot-y: {{ block.settings.position_y }}%;
            "
            {{ block.shopify_attributes }}
          >

            <button
              type="button"
              class="petlio-lookbook__hotspot"
              data-hotspot-button
              aria-expanded="false"
              aria-controls="lookbook-product-{{ section.id }}-{{ forloop.index }}"
              aria-label="View {{ product.title | escape }}"
            >
              <span class="petlio-lookbook__hotspot-ring"></span>
              <span class="petlio-lookbook__hotspot-dot"></span>
              <span class="petlio-lookbook__hotspot-plus">
                +
              </span>
            </button>


            <div
              id="lookbook-product-{{ section.id }}-{{ forloop.index }}"
              class="petlio-lookbook__product"
              data-product-card
              hidden
            >

              <div class="petlio-lookbook__product-image">

                {% if product.featured_image %}

                  {{
                    product.featured_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 700',
                      sizes: '(max-width: 749px) 72vw, 320px',
                      alt: product.title
                  }}

                {% endif %}

              </div>


              <div class="petlio-lookbook__product-content">

                {% if product.vendor != blank %}
                  <span class="petlio-lookbook__product-vendor">
                    {{ product.vendor }}
                  </span>
                {% endif %}

                <h3 class="petlio-lookbook__product-title">
                  {{ product.title }}
                </h3>

                <div class="petlio-lookbook__product-price">
                  {{ product.price | money }}
                </div>

                <a
                  class="petlio-lookbook__product-link"
                  href="{{ product.url }}"
                >
                  View product
                  <span aria-hidden="true">→</span>
                </a>

              </div>

              <button
                type="button"
                class="petlio-lookbook__product-close"
                data-product-close
                aria-label="Close product"
              >
                ×
              </button>

            </div>

          </div>

        {% endif %}

      {% endfor %}


      {% if section.blocks.size == 0 %}

        <div class="petlio-lookbook__empty">
          <span>06</span>
          <p>
            Add products to create your shoppable look.
          </p>
        </div>

      {% endif %}


      <div class="petlio-lookbook__scene-footer">

        <span class="petlio-lookbook__footer-line"></span>

        <span>
          Made for the moments in between.
        </span>

        <span class="petlio-lookbook__footer-line"></span>

      </div>

    </div>


    <footer class="petlio-lookbook__bottom">

      <div class="petlio-lookbook__bottom-number">
        06
      </div>

      <p>
        Find something they love.
        <strong>Make it part of their everyday.</strong>
      </p>

      <span class="petlio-lookbook__bottom-arrow">
        ↓
      </span>

    </footer>

  </div>
</section>


{% schema %}
{
  "name": "Shoppable Lookbook",
  "tag": "section",
  "class": "section-shoppable-lookbook",
  "max_blocks": 8,
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p><strong>SHOPPABLE LOOKBOOK</strong></p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p><em>Take the whole look home.</em></p>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color",
      "id": "color_dot",
      "label": "Hotspot color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_card_background",
      "label": "Product card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_card_foreground",
      "label": "Product card text",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "Horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 36
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "default": 64
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Lookbook",
      "blocks": [
        {
          "type": "hotspot"
        },
        {
          "type": "hotspot"
        }
      ]
    }
  ]
}
{% endschema %}