{%- comment -%}
  Map / Store Location
{%- endcomment -%}

{%- liquid
  assign address = section.settings.map_address | strip
  assign image = section.settings.image
  assign focal_style = nil
  if image.presentation.focal_point
    assign focal_style = 'object-position: ' | append: image.presentation.focal_point
  endif
  assign show_embed = false
  if section.settings.map_type == 'embed' and address != blank
    assign show_embed = true
  endif

  assign address_encoded = address | url_encode
  assign directions_url = 'https://www.google.com/maps/search/?api=1&query=' | append: address_encoded
-%}

{{ 'map.css' | asset_url | stylesheet_tag }}

<div
  class="map map--{{ section.settings.layout }} map--card-{{ section.settings.card_position }} map--height-{{ section.settings.height }}{% if section.settings.full_width %} map--full-width{% endif %}{% if section.settings.desaturate %} map--desaturate{% endif %}"
  style="
    --map-card-background: {{ section.settings.color_card_background }};
    --map-card-foreground: {{ section.settings.color_card_foreground }};
  "
>
  <div class="map__media">
    {%- if show_embed -%}
      <iframe
        class="map__iframe"
        src="https://www.google.com/maps?q={{ address_encoded }}&z={{ section.settings.zoom }}&output=embed&hl={{ request.locale.iso_code }}"
        title="{{ 'sections.map.map_title' | t }}"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    {%- elsif image != blank -%}
      {{
        image
        | image_url: width: 3000
        | image_tag:
          class: 'map__image',
          widths: '750, 1100, 1500, 2000, 3000',
          sizes: '100vw',
          loading: 'lazy',
          alt: image.alt,
          style: focal_style
      }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'map__placeholder' }}
    {%- endif -%}
  </div>

  <div class="map__card-wrapper">
    <div class="map__card">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            {%- if block.settings.heading != blank -%}
              <h2 class="map__heading map__heading--{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              {%- if block.settings.is_address -%}
                <address class="map__text" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </address>
              {%- else -%}
                <div class="map__text" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            {%- endif -%}

          {%- when 'button' -%}
            {%- if block.settings.button_label != blank -%}
              {%- liquid
                assign button_url = block.settings.button_link
                if button_url == blank and address != blank
                  assign button_url = directions_url
                endif
              -%}
              <a
                {% if button_url != blank %}href="{{ button_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
                class="map__button button {% if block.settings.button_style == 'secondary' %}button--secondary map__button--secondary{% else %}button--primary map__button--primary{% endif %}"
                {% if button_url == directions_url %}target="_blank" rel="noopener"{% endif %}
                {{ block.shopify_attributes }}
              >
                {{ block.settings.button_label | escape }}
                {%- if button_url == directions_url -%}
                  <span class="map__visually-hidden">{{ 'sections.map.opens_new_tab' | t }}</span>
                {%- endif -%}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.map.name",
  "tag": "section",
  "class": "section-map",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "t:sections.map.settings.header__1.content" },
    {
      "type": "text",
      "id": "map_address",
      "label": "t:sections.map.settings.map_address.label",
      "default": "Times Square, New York, NY",
      "info": "t:sections.map.settings.map_address.info"
    },
    {
      "type": "select",
      "id": "map_type",
      "label": "t:sections.map.settings.map_type.label",
      "options": [
        { "value": "embed", "label": "t:sections.map.settings.map_type.options__1.label" },
        { "value": "image", "label": "t:sections.map.settings.map_type.options__2.label" }
      ],
      "default": "embed",
      "info": "t:sections.map.settings.map_type.info"
    },
    {
      "type": "range",
      "id": "zoom",
      "label": "t:sections.map.settings.zoom.label",
      "min": 8,
      "max": 18,
      "step": 1,
      "default": 14,
      "info": "t:sections.map.settings.zoom.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.map.settings.image.label",
      "info": "t:sections.map.settings.image.info"
    },
    {
      "type": "checkbox",
      "id": "desaturate",
      "label": "t:sections.map.settings.desaturate.label",
      "default": false,
      "info": "t:sections.map.settings.desaturate.info"
    },
    { "type": "header", "content": "t:sections.map.settings.header__2.content" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.map.settings.layout.label",
      "options": [
        { "value": "overlay", "label": "t:sections.map.settings.layout.options__1.label" },
        { "value": "side", "label": "t:sections.map.settings.layout.options__2.label" }
      ],
      "default": "overlay"
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "t:sections.map.settings.card_position.label",
      "options": [
        { "value": "left", "label": "t:sections.map.settings.card_position.options__1.label" },
        { "value": "right", "label": "t:sections.map.settings.card_position.options__2.label" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.map.settings.height.label",
      "options": [
        { "value": "small", "label": "t:sections.map.settings.height.options__1.label" },
        { "value": "medium", "label": "t:sections.map.settings.height.options__2.label" },
        { "value": "large", "label": "t:sections.map.settings.height.options__3.label" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.map.settings.full_width.label",
      "default": true
    },
    { "type": "header", "content": "t:sections.map.settings.header__3.content" },
    {
      "type": "color",
      "id": "color_card_background",
      "label": "t:sections.map.settings.color_card_background.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_card_foreground",
      "label": "t:sections.map.settings.color_card_foreground.label",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.map.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.map.blocks.heading.settings.heading.label",
          "default": "Visit our store"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.map.blocks.heading.settings.heading_size.label",
          "options": [
            { "value": "small", "label": "t:sections.map.blocks.heading.settings.heading_size.options__1.label" },
            { "value": "medium", "label": "t:sections.map.blocks.heading.settings.heading_size.options__2.label" },
            { "value": "large", "label": "t:sections.map.blocks.heading.settings.heading_size.options__3.label" }
          ],
          "default": "medium"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.map.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.map.blocks.text.settings.text.label",
          "default": "<p>1 Times Square<br>New York, NY 10036</p>"
        },
        {
          "type": "checkbox",
          "id": "is_address",
          "label": "t:sections.map.blocks.text.settings.is_address.label",
          "default": false,
          "info": "t:sections.map.blocks.text.settings.is_address.info"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.map.blocks.button.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.map.blocks.button.settings.button_label.label",
          "default": "Get directions"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.map.blocks.button.settings.button_link.label",
          "info": "t:sections.map.blocks.button.settings.button_link.info"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:sections.map.blocks.button.settings.button_style.label",
          "options": [
            { "value": "primary", "label": "t:sections.map.blocks.button.settings.button_style.options__1.label" },
            { "value": "secondary", "label": "t:sections.map.blocks.button.settings.button_style.options__2.label" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.map.presets.name",
      "blocks": [
        { "type": "heading" },
        {
          "type": "text",
          "settings": {
            "is_address": true
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Mon–Fri: 10am–7pm<br>Sat–Sun: 11am–5pm</p>",
            "is_address": false
          }
        },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
