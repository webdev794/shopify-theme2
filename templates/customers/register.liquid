{{ 'customer-accounts.css' | asset_url | stylesheet_tag }}
<div class="customer customer--register">
  <div class="customer__container">
    <h1 class="customer__heading">{{ 'customer.register.title' | t | default: 'Create account' }}</h1>
    {% form 'create_customer', class: 'customer__form' %}
      {% if form.errors %}<div class="customer__errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <div class="customer__field-row">
        <div class="customer__field"><label for="RegisterFirstName">First name</label><input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name"></div>
        <div class="customer__field"><label for="RegisterLastName">Last name</label><input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name"></div>
      </div>
      <div class="customer__field"><label for="RegisterEmail">Email</label><input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required></div>
      <div class="customer__field"><label for="RegisterPassword">Password</label><input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password" required></div>
      <button type="submit" class="button button--primary customer__submit">{{ 'customer.register.submit' | t | default: 'Create' }}</button>
    {% endform %}
    <p class="customer__footer-link"><a href="{{ routes.account_login_url }}">Already have an account? Sign in</a></p>
  </div>
</div>
