{% comment %}
  Renders the storefront password ("coming soon") page: optional logo and
  background image, the unlock form, an optional email signup so visitors
  can be notified at launch, social links, and the store-owner admin
  login link.

  https://shopify.dev/docs/storefronts/themes/architecture/templates
{% endcomment %}

<div
  class="password-page{% if section.settings.background_image != blank %} password-page--has-image{% endif %}"
>
  {% if section.settings.background_image != blank %}
    <div class="password-page__background">
      {{
        section.settings.background_image
        | image_url: width: 1920
        | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,1920', sizes: '100vw', alt: ''
      }}
    </div>
  {% endif %}

  <div class="password-page__content">
    {% if section.settings.logo != blank %}
      <div class="password-page__logo">
        {{
          section.settings.logo
          | image_url: width: 300
          | image_tag: loading: 'eager', widths: '150,225,300', alt: shop.name
        }}
      </div>
    {% else %}
      <p class="password-page__shop-name">{{ shop.name }}</p>
    {% endif %}

    <h1 class="password-page__heading">
      {% if section.settings.heading != blank %}
        {{ section.settings.heading }}
      {% else %}
        {{ 'password.title' | t }}
      {% endif %}
    </h1>

    {% if section.settings.subheading != blank %}
      <div class="password-page__subheading rte">{{ section.settings.subheading }}</div>
    {% endif %}

    {% if shop.password_message != blank %}
      <div class="password-page__message rte">{{ shop.password_message }}</div>
    {% endif %}

    <div class="password-page__unlock">
      {% form 'storefront_password', class: 'password-form' %}
        {% if form.errors %}
          <p class="password-form__error">{{ 'password.error' | t }}</p>
        {% endif %}

        <label for="password-{{ section.id }}" class="visually-hidden">
          {{ 'password.password' | t }}
        </label>
        <input
          type="password"
          name="password"
          id="password-{{ section.id }}"
          class="password-form__input"
          placeholder="{{ 'password.password' | t }}"
          required
        >
        <button type="submit" class="button button--primary password-form__submit">
          {{ 'password.enter' | t }}
        </button>
      {% endform %}
    </div>

    {% if section.settings.enable_newsletter %}
      <div class="password-page__newsletter">
        {% form 'customer', class: 'password-newsletter' %}
          {% if form.posted_successfully? %}
            <p class="password-newsletter__success">{{ 'general.newsletter.success' | t }}</p>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label for="newsletter-email-{{ section.id }}" class="visually-hidden">
              {{ 'general.newsletter.email_label' | t }}
            </label>
            <input
              type="email"
              name="contact[email]"
              id="newsletter-email-{{ section.id }}"
              class="password-newsletter__input"
              placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
              required
            >
            <button type="submit" class="button button--secondary password-newsletter__submit">
              {{ 'general.newsletter.submit' | t }}
            </button>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}

    {% if section.settings.show_social_icons %}
      <div class="password-page__social">
        {% if settings.social_facebook_link != blank %}
          <a href="{{ settings.social_facebook_link }}" class="password-page__social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5H16l.4-3H13.5V8.4c0-.87.24-1.46 1.5-1.46H16.5V4.35c-.26-.03-1.15-.1-2.19-.1-2.17 0-3.66 1.32-3.66 3.76v2.5H8.2v3h2.45V21h2.85z"/></svg>
          </a>
        {% endif %}
        {% if settings.social_twitter_link != blank %}
          <a href="{{ settings.social_twitter_link }}" class="password-page__social-link" aria-label="X" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 3H22l-7.6 8.7L23.3 21h-6.9l-5.4-6.6L4.8 21H1.7l8.1-9.3L1 3h7.1l4.9 6.1L18.9 3zM17.6 19h1.9L7.5 5H5.4l12.2 14z"/></svg>
          </a>
        {% endif %}
        {% if settings.social_instagram_link != blank %}
          <a href="{{ settings.social_instagram_link }}" class="password-page__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
        {% endif %}
        {% if settings.social_youtube_link != blank %}
          <a href="{{ settings.social_youtube_link }}" class="password-page__social-link" aria-label="YouTube" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.6-.46-5.3a3 3 0 0 0-2.1-2.1C18.7 4 12 4 12 4s-6.7 0-8.44.6a3 3 0 0 0-2.1 2.1C1 8.4 1 12 1 12s0 3.6.46 5.3a3 3 0 0 0 2.1 2.1C5.3 20 12 20 12 20s6.7 0 8.44-.6a3 3 0 0 0 2.1-2.1C23 15.6 23 12 23 12z"/><path d="M9.75 8.75v6.5L15.5 12z" fill="#fff"/></svg>
          </a>
        {% endif %}
      </div>
    {% endif %}

    <a href="/admin" class="password-page__admin-link" rel="nofollow">
      {{ 'password.admin_login' | t }}
    </a>
  </div>
</div>

{% stylesheet %}
  .password-page {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    overflow: hidden;
  }

  .password-page__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .password-page__background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .password-page--has-image .password-page__background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
  }

  .password-page__content {
    position: relative;
    z-index: 1;
    max-width: 26rem;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .password-page--has-image .password-page__content {
    color: #fff;
  }

  .password-page__logo img {
    max-width: 160px;
    height: auto;
  }

  .password-page__shop-name {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .password-page__heading {
    font-size: clamp(1.85rem, 1.4rem + 1.8vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .password-page__subheading {
    opacity: 0.85;
    line-height: 1.6;
  }

  .password-page__message {
    font-size: 0.9rem;
    opacity: 0.85;
    line-height: 1.6;
    padding: 0.75rem 1rem;
    border-radius: 0.4rem;
    background: rgba(127, 127, 127, 0.12);
  }

  .password-form,
  .password-newsletter {
    display: flex;
    width: 100%;
    max-width: 24rem;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .password-form__input,
  .password-newsletter__input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 1.125rem;
    border-radius: 2px;
    border: 1px solid var(--color-border, #ccc);
    font-size: 1rem;
    background: transparent;
    color: inherit;
  }

  .password-page--has-image .password-form__input,
  .password-page--has-image .password-newsletter__input {
    border-color: rgba(255, 255, 255, 0.4);
  }

  .password-form__input::placeholder,
  .password-newsletter__input::placeholder {
    color: currentColor;
    opacity: 0.6;
  }

  .password-form__submit,
  .password-newsletter__submit {
    padding: 0.75rem 1.5rem;
    border-radius: 2px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .password-form__submit:hover,
  .password-newsletter__submit:hover {
    transform: translateY(-2px);
  }

  /* Updated to use --color-error instead of --color-sale */
  .password-form__error {
    width: 100%;
    font-size: 0.85rem;
    color: var(--color-error, #c62828);
    margin: 0;
  }

  .password-newsletter__success {
    font-size: 0.9rem;
    opacity: 0.9;
  }

  .password-page__social {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .password-page__social-link {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    background: transparent;
    color: inherit;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .password-page__social-link:hover {
    border-color: currentColor;
  }

  .password-page__social-link svg {
    width: 16px;
    height: 16px;
  }

  .password-page__admin-link {
    margin-top: 1.5rem;
    font-size: 0.8rem;
    opacity: 0.7;
    color: inherit;
  }

  .password-page__admin-link:hover {
    opacity: 1;
    text-decoration: underline;
  }

  @media screen and (max-width: 480px) {
    .password-form,
    .password-newsletter {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.password.settings.logo.label"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.password.settings.background_image.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.password.settings.heading.label",
      "info": "t:sections.password.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:sections.password.settings.subheading.label"
    },
    {
      "type": "checkbox",
      "id": "enable_newsletter",
      "label": "t:sections.password.settings.enable_newsletter.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "t:sections.password.settings.show_social_icons.label",
      "default": true
    }
  ]
}
{% endschema %}