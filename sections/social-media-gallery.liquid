{% comment %}
  Social Media Gallery Section
  Version: 1.0
  Description: Display social media posts with links to your social profiles
{% endcomment %}

<link rel="preload" href="{{ 'social-media-gallery.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript>{{ 'social-media-gallery.css' | asset_url | stylesheet_tag }}</noscript>

<div class="social-media-gallery" data-section-id="{{ section.id }}" data-section-type="social-media-gallery" role="region" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="social-media-gallery__header">
        <h2 class="social-media-gallery__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="social-media-gallery__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="social-media-gallery__grid">
      {%- for block in section.blocks -%}
        <div class="social-media-gallery__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="social-media-gallery__link" target="_blank" rel="noopener noreferrer">
          {%- else -%}
            <div class="social-media-gallery__link social-media-gallery__link--static">
          {%- endif -%}
            <div class="social-media-gallery__card">
              {%- if block.settings.image != blank -%}
                <div class="social-media-gallery__image-wrapper">
                  <img
                    src="{{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }}"
                    srcset="{{ block.settings.image | image_url: width: 600, height: 600, crop: 'center' }} 1x, {{ block.settings.image | image_url: width: 1200, height: 1200, crop: 'center' }} 2x"
                    alt="{{ block.settings.image.alt | default: block.settings.caption | escape }}"
                    loading="lazy"
                    width="600"
                    height="600"
                    class="social-media-gallery__image"
                  >
                  {%- if block.settings.platform != 'none' -%}
                    <div class="social-media-gallery__platform-badge">
                      {%- render 'social-icon', platform: block.settings.platform -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- else -%}
                <div class="social-media-gallery__placeholder">
                  <div class="social-media-gallery__placeholder-icon">
                    {%- render 'social-icon', platform: block.settings.platform -%}
                  </div>
                  <span class="social-media-gallery__placeholder-text">
                    {%- if block.settings.username != blank -%}
                      @{{ block.settings.username }}
                    {%- else -%}
                      {{ 'sections.social_gallery.username_placeholder' | t }}
                    {%- endif -%}
                  </span>                
                </div>
              {%- endif -%}

              <div class="social-media-gallery__content">
                {%- if block.settings.caption != blank -%}
                  <p class="social-media-gallery__caption">{{ block.settings.caption | escape }}</p>
                {%- endif -%}
                <div class="social-media-gallery__meta">
                  {%- if block.settings.likes != blank -%}
                    <span class="social-media-gallery__likes">
                      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                      </svg>
                      {{ block.settings.likes }}
                    </span>
                  {%- endif -%}
                  {%- if block.settings.comments != blank -%}
                    <span class="social-media-gallery__comments">
                      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                        <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/>
                      </svg>
                      {{ block.settings.comments }}
                    </span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="social-media-gallery__empty">
          <p>{{ 'sections.social_gallery.empty' | t }}</p>
          {%- if shop.editor_mode -%}
            <p><small>Click "Add block" to add social posts</small></p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_follow_button and section.settings.follow_link != blank -%}
      <div class="social-media-gallery__footer">
        <a href="{{ section.settings.follow_link }}" class="social-media-gallery__follow-btn btn btn--primary" target="_blank" rel="noopener noreferrer">
          {%- if section.settings.follow_platform != 'none' -%}
            {%- render 'social-icon', platform: section.settings.follow_platform, class: 'social-media-gallery__follow-icon' -%}
          {%- endif -%}
          {{ section.settings.follow_text | default: 'Follow Us' | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.social_gallery.name",
  "tag": "section",
  "class": "social-media-gallery-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.social_gallery.settings.heading.label",
      "default": "Follow Us on Social Media"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.social_gallery.settings.subheading.label",
      "default": "Join our community and stay updated"
    },
    { "type": "header", "content": "t:sections.social_gallery.settings.header__1.content" },
    {
      "type": "checkbox",
      "id": "show_follow_button",
      "label": "t:sections.social_gallery.settings.show_follow_button.label",
      "default": true
    },
    {
      "type": "select",
      "id": "follow_platform",
      "label": "t:sections.social_gallery.settings.follow_platform.label",
      "options": [
        { "value": "none", "label": "t:sections.social_gallery.settings.follow_platform.options__1.label" },
        { "value": "instagram", "label": "t:sections.social_gallery.settings.follow_platform.options__2.label" },
        { "value": "facebook", "label": "t:sections.social_gallery.settings.follow_platform.options__3.label" },
        { "value": "twitter", "label": "t:sections.social_gallery.settings.follow_platform.options__4.label" },
        { "value": "pinterest", "label": "t:sections.social_gallery.settings.follow_platform.options__5.label" },
        { "value": "tiktok", "label": "t:sections.social_gallery.settings.follow_platform.options__6.label" },
        { "value": "youtube", "label": "t:sections.social_gallery.settings.follow_platform.options__7.label" },
        { "value": "linkedin", "label": "t:sections.social_gallery.settings.follow_platform.options__8.label" }
      ],
      "default": "instagram"
    },
    {
      "type": "text",
      "id": "follow_text",
      "label": "t:sections.social_gallery.settings.follow_text.label",
      "default": "Follow Us"
    },
    {
      "type": "url",
      "id": "follow_link",
      "label": "t:sections.social_gallery.settings.follow_link.label",
      "info": "t:sections.social_gallery.settings.follow_link.info"
    },
    { "type": "header", "content": "t:sections.social_gallery.settings.header__2.content" },
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.social_gallery.settings.aria_label.label",
      "default": "Social media gallery"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "t:sections.social_gallery.blocks.post.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.social_gallery.blocks.post.settings.image.label",
          "info": "t:sections.social_gallery.blocks.post.settings.image.info"
        },
        {
          "type": "select",
          "id": "platform",
          "label": "t:sections.social_gallery.blocks.post.settings.platform.label",
          "options": [
            { "value": "none", "label": "t:sections.social_gallery.blocks.post.settings.platform.options__1.label" },
            { "value": "instagram", "label": "t:sections.social_gallery.blocks.post.settings.platform.options__2.label" },
            { "value": "facebook", "label": "t:sections.social_gallery.blocks.post.settings.platform.options__3.label" },
            { "value": "twitter", "label": "t:sections.social_gallery.blocks.post.settings.platform.options__4.label" },
            { "value": "pinterest", "label": "t:sections.social_gallery.blocks.post.settings.platform.options__5.label" },
            { "value": "tiktok", "label": "t:sections.social_gallery.blocks.post.settings.platform.options__6.label" },
            { "value": "youtube", "label": "t:sections.social_gallery.blocks.post.settings.platform.options__7.label" },
            { "value": "linkedin", "label": "t:sections.social_gallery.blocks.post.settings.platform.options__8.label" }
          ],
          "default": "instagram"
        },
        {
          "type": "text",
          "id": "username",
          "label": "t:sections.social_gallery.blocks.post.settings.username.label",
          "info": "t:sections.social_gallery.blocks.post.settings.username.info"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.social_gallery.blocks.post.settings.caption.label",
          "default": "Check out our latest post!"
        },
        {
          "type": "text",
          "id": "likes",
          "label": "t:sections.social_gallery.blocks.post.settings.likes.label",
          "default": "1.2k"
        },
        {
          "type": "text",
          "id": "comments",
          "label": "t:sections.social_gallery.blocks.post.settings.comments.label",
          "default": "45"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.social_gallery.blocks.post.settings.link.label",
          "info": "t:sections.social_gallery.blocks.post.settings.link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.social_gallery.presets.name",
      "blocks": [
        {
          "type": "post",
          "settings": {
            "platform": "instagram",
            "caption": "Beautiful sunset views 🌅",
            "likes": "2.4k",
            "comments": "156"
          }
        },
        {
          "type": "post",
          "settings": {
            "platform": "instagram",
            "caption": "New collection just dropped ✨",
            "likes": "1.8k",
            "comments": "89"
          }
        },
        {
          "type": "post",
          "settings": {
            "platform": "instagram",
            "caption": "Behind the scenes 🎬",
            "likes": "3.1k",
            "comments": "234"
          }
        },
        {
          "type": "post",
          "settings": {
            "platform": "instagram",
            "caption": "Customer favorites 💕",
            "likes": "967",
            "comments": "43"
          }
        }
      ]
    }
  ]
}
{% endschema %}
