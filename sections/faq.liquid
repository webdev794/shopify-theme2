{{ 'faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'faq.js' | asset_url }}" defer></script>
<div class="faq faq--{{ section.settings.layout }}" data-section-type="faq" data-section-id="{{ section.id }}"
  style="--faq-bg: {{ section.settings.background_color }}; --faq-text: {{ section.settings.text_color }}; --faq-accent: {{ section.settings.accent_color }};">
  <div class="faq__container">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="faq__header">
        {% if section.settings.subheading != blank %}<p class="faq__subheading">{{ section.settings.subheading | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
        {% if section.settings.description != blank %}<div class="faq__description">{{ section.settings.description }}</div>{% endif %}
      </div>
    {% endif %}
    <div class="faq__list" data-faq-list>
      {% for block in section.blocks %}
        <details class="faq__item" data-faq-item {{ block.shopify_attributes }} {% if section.settings.open_first and forloop.first %}open{% endif %}>
          <summary class="faq__question">
            <span class="faq__question-text">{{ block.settings.question | escape }}</span>
            <span class="faq__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span>
          </summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {% else %}
        <details class="faq__item" open>
          <summary class="faq__question"><span class="faq__question-text">What is your return policy?</span><span class="faq__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span></summary>
          <div class="faq__answer rte"><p>We offer free returns within 30 days of purchase.</p></div>
        </details>
      {% endfor %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.faq.settings.heading.label",
      "default": "Frequently asked questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.faq.settings.subheading.label",
      "default": "Help center"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.faq.settings.description.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.faq.settings.layout.label",
      "options": [
        { "value": "narrow", "label": "t:sections.faq.settings.layout.options__1.label" },
        { "value": "wide", "label": "t:sections.faq.settings.layout.options__2.label" }
      ],
      "default": "narrow"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:sections.faq.settings.open_first.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.faq.settings.header__colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.faq.settings.background_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.faq.settings.text_color.label",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.faq.settings.accent_color.label",
      "default": "#121212"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.faq.blocks.item.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.blocks.item.settings.question.label",
          "default": "How can we help you?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.blocks.item.settings.answer.label",
          "default": "<p>Add your answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.presets.name",
      "category": "Text",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer free returns within 30 days of purchase.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Standard shipping takes 3–7 business days.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we ship to most countries worldwide.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}