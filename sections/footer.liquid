{%- comment -%}
  Footer — Minimalist Luxury variant
  Ultra-clean, generous whitespace, gold accent.
  Focus on brand storytelling and elegant navigation.
{%- endcomment -%}

{{ 'footer.css' | asset_url | stylesheet_tag }}

<footer class="footer color-scheme-{{ section.settings.color_scheme | default: 'default' }}">
  <div class="footer__inner page-width">
    
    <!-- ── Brand ── -->
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="footer__logo">
        {%- if section.settings.logo -%}
          {{ section.settings.logo | image_url: width: 280 | image_tag: 
            alt: shop.name, 
            widths: '140, 280', 
            sizes: '140px', 
            class: 'footer__logo-img' 
          }}
        {%- else -%}
          <span class="footer__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <div class="footer__accent-line" aria-hidden="true"></div>

      {%- if section.settings.tagline != blank -%}
        <p class="footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
    </div>

    <!-- ── Navigation ── -->
    <nav class="footer__nav" aria-label="Footer navigation">
      <ul class="footer__menu" role="list">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}" class="footer__link" {% if link.current %}aria-current="page"{% endif %}>
              {{ link.title | escape }}
            </a>
          </li>
        {%- endfor -%}
        
        {%- if section.settings.show_contact_link -%}
          <li>
            <a href="{{ routes.page_url | append: '/pages/contact' }}" class="footer__link">
              Contact
            </a>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- ── Newsletter (optional) ── -->
    {%- if section.settings.show_newsletter -%}
      <div class="footer__newsletter-wrapper">
        <h3 class="footer__newsletter-title">{{ section.settings.newsletter_heading | default: 'Subscribe' }}</h3>
        {%- form 'customer', class: 'footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="FooterNewsletterEmail" class="visually-hidden">
            Email
          </label>
          <input
            id="FooterNewsletterEmail"
            type="email"
            name="contact[email]"
            class="footer__newsletter-input"
            value="{{ form.email }}"
            placeholder="Your email"
            required
            autocomplete="email"
          >
          <button type="submit" class="footer__newsletter-submit" aria-label="Subscribe">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </button>
        {%- endform -%}
        {%- if form.errors -%}
          <p class="footer__form-message footer__form-message--error" role="alert">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </p>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p class="footer__form-message footer__form-message--success" role="status">
            Thanks for subscribing!
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- ── Social Links ── -->
    {%- if section.settings.show_social -%}
      <ul class="footer__social" role="list">
        {%- if settings.social_instagram_link != blank -%}
          <li>
            <a href="{{ settings.social_instagram_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
              {% render 'icon-instagram' %}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <li>
            <a href="{{ settings.social_facebook_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Facebook">
              {% render 'icon-facebook' %}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <li>
            <a href="{{ settings.social_tiktok_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="TikTok">
              {% render 'icon-tiktok' %}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}
          <li>
            <a href="{{ settings.social_pinterest_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Pinterest">
              {% render 'icon-pinterest' %}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <li>
            <a href="{{ settings.social_youtube_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="YouTube">
              {% render 'icon-youtube' %}
            </a>
          </li>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <li>
            <a href="{{ settings.social_twitter_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Twitter">
              {% render 'icon-twitter' %}
            </a>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    <!-- ── Payment Icons ── -->
    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payment" role="list" aria-label="Payment methods">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <!-- ── Bottom Bar ── -->
    <div class="footer__bottom">
      <div class="footer__copyright">
        <span>&copy; {{ 'now' | date: '%Y' }}</span>
        <span class="footer__divider">•</span>
        <span>{{ shop.name | link_to: routes.root_url }}</span>
        <span class="footer__divider">•</span>
        <span class="footer__powered">{{ powered_by_link }}</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section--footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text"
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "info": "Set your social media URLs in Theme settings → Social media."
    },
    {
      "type": "header",
      "content": "Payment"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Footer menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave blank to use the menu's title."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}