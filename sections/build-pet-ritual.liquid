{% comment %}
  Build Your Pet’s Daily Ritual - Interactive configurator
{% endcomment %}

{{ 'build-pet-ritual.css' | asset_url | stylesheet_tag }}

<section class="build-pet-ritual section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="ritual__header">
      {% if section.settings.heading != blank %}
        <h2 class="ritual__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="ritual__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="ritual__layout">
      <div class="ritual__steps" data-steps>
        {% for block in section.blocks %}
          <div class="ritual__step" {{ block.shopify_attributes }} data-step-index="{{ forloop.index0 }}">
            <div class="ritual__step-header">
              <span class="ritual__step-num">{{ forloop.index }}</span>
              <h3 class="ritual__step-title">{{ block.settings.title }}</h3>
            </div>
            {% if block.settings.description != blank %}
              <p class="ritual__step-desc">{{ block.settings.description }}</p>
            {% endif %}

            <div class="ritual__options">
              {% if block.settings.option_1_label != blank %}
                <label class="ritual__option">
                  <input type="radio" 
                         name="step-{{ forloop.index0 }}" 
                         value="{{ block.settings.option_1_label | handleize }}"
                         data-label="{{ block.settings.option_1_label }}"
                         data-price="{{ block.settings.option_1_price | default: 0 }}"
                         data-product="{{ block.settings.option_1_product }}">
                  <span class="ritual__option-content">
                    <span class="ritual__option-label">{{ block.settings.option_1_label }}</span>
                    {% if block.settings.option_1_price != blank %}
                      <span class="ritual__option-price">{{ block.settings.option_1_price | money }}</span>
                    {% endif %}
                  </span>
                </label>
              {% endif %}
              {% if block.settings.option_2_label != blank %}
                <label class="ritual__option">
                  <input type="radio" 
                         name="step-{{ forloop.index0 }}" 
                         value="{{ block.settings.option_2_label | handleize }}"
                         data-label="{{ block.settings.option_2_label }}"
                         data-price="{{ block.settings.option_2_price | default: 0 }}"
                         data-product="{{ block.settings.option_2_product }}">
                  <span class="ritual__option-content">
                    <span class="ritual__option-label">{{ block.settings.option_2_label }}</span>
                    {% if block.settings.option_2_price != blank %}
                      <span class="ritual__option-price">{{ block.settings.option_2_price | money }}</span>
                    {% endif %}
                  </span>
                </label>
              {% endif %}
              {% if block.settings.option_3_label != blank %}
                <label class="ritual__option">
                  <input type="radio" 
                         name="step-{{ forloop.index0 }}" 
                         value="{{ block.settings.option_3_label | handleize }}"
                         data-label="{{ block.settings.option_3_label }}"
                         data-price="{{ block.settings.option_3_price | default: 0 }}"
                         data-product="{{ block.settings.option_3_product }}">
                  <span class="ritual__option-content">
                    <span class="ritual__option-label">{{ block.settings.option_3_label }}</span>
                    {% if block.settings.option_3_price != blank %}
                      <span class="ritual__option-price">{{ block.settings.option_3_price | money }}</span>
                    {% endif %}
                  </span>
                </label>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="ritual__summary" data-summary>
        <div class="ritual__summary-card">
          <div class="ritual__avatar">🐕</div>
          <h3 class="ritual__summary-title">Your Pet’s Ritual</h3>
          <ul class="ritual__selected" data-selected-list>
            <li class="ritual__empty">Select options to build the ritual</li>
          </ul>
          <div class="ritual__total">
            <span>Total</span>
            <strong data-total-price>{{ 0 | money }}</strong>
          </div>
          <button type="button" class="ritual__add-btn" data-add-ritual disabled>
            {{ section.settings.button_label | default: 'Add Complete Ritual to Cart' }}
          </button>
          <p class="ritual__note">{{ section.settings.note | default: 'You can edit quantities in cart' }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'build-pet-ritual.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Build Pet Ritual",
  "tag": "section",
  "class": "section-pet-ritual",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Pet’s Daily Ritual"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Create a complete care routine in a few clicks. Your pet will thank you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart button",
      "default": "Add Complete Ritual to Cart"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note under button",
