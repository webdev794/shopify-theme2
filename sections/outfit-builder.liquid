{{ 'outfit-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'outfit-builder.js' | asset_url }}" defer></script>

<section
  class="outfit-builder"
  data-section-type="outfit-builder"
  data-section-id="{{ section.id }}"
  data-max-items="{{ section.settings.max_items }}"
  style="
    --ob-bg: {{ section.settings.background_color }};
    --ob-text: {{ section.settings.text_color }};
    --ob-accent: {{ section.settings.accent_color }};
  "
>
  <div class="outfit-builder__container">

    <header class="outfit-builder__header">
      <div class="outfit-builder__chapter">
        <span class="outfit-builder__chapter-number">04</span>
        <span class="outfit-builder__chapter-line"></span>
        <span class="outfit-builder__chapter-label">
          {{ section.settings.chapter_label | escape }}
        </span>
      </div>

      {% if section.settings.subheading != blank %}
        <p class="outfit-builder__subheading">
          {{ section.settings.subheading | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="outfit-builder__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="outfit-builder__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    <div class="outfit-builder__layout">

      <div class="outfit-builder__catalog-wrap">

        <div class="outfit-builder__catalog-intro">
          <span>{{ section.settings.catalog_label | escape }}</span>
          <span class="outfit-builder__catalog-count">
            {{ section.blocks.size }} items
          </span>
        </div>

        <div class="outfit-builder__catalog" data-ob-catalog>

          {% for block in section.blocks %}
            {% assign product = block.settings.product %}

            {% if product != blank %}
              {% assign variant = product.selected_or_first_available_variant %}

              <article
                class="outfit-builder__card"
                data-ob-product
                data-product-id="{{ product.id }}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price }}"
                data-title="{{ product.title | escape }}"
                {{ block.shopify_attributes }}
              >

                <div class="outfit-builder__card-media">

                  <span class="outfit-builder__card-index" aria-hidden="true">
                    0{{ forloop.index }}
                  </span>

                  {% if product.featured_image %}
                    {{
                      product.featured_image
                      | image_url: width: 700
                      | image_tag:
                        class: 'outfit-builder__card-image',
                        loading: 'lazy',
                        widths: '320, 480, 600, 700',
                        sizes: '(max-width: 749px) 72vw, (max-width: 900px) 38vw, 22vw',
                        alt: product.title
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'outfit-builder__card-image' }}
                  {% endif %}

                  <span class="outfit-builder__selected-mark" aria-hidden="true">
                    ✓
                  </span>

                </div>

                <div class="outfit-builder__card-info">

                  <div class="outfit-builder__card-meta">
                    {% if product.vendor != blank %}
                      <span>{{ product.vendor }}</span>
                    {% endif %}

                    <span>{{ variant.price | money }}</span>
                  </div>

                  <h3 class="outfit-builder__card-title">
                    {{ product.title }}
                  </h3>

                  {% if product.variants.size > 1 and section.settings.show_variant_selector %}
                    <select
                      class="outfit-builder__variant-select"
                      data-ob-variant
                      aria-label="Choose {{ product.title }} variant"
                    >
                      {% for v in product.variants %}
                        <option
                          value="{{ v.id }}"
                          data-price="{{ v.price }}"
                          data-available="{{ v.available }}"
                          {% unless v.available %}disabled{% endunless %}
                          {% if v.id == variant.id %}selected{% endif %}
                        >
                          {{ v.title }} — {{ v.price | money }}
                        </option>
                      {% endfor %}
                    </select>
                  {% endif %}

                  <button
                    type="button"
                    class="outfit-builder__select-btn"
                    data-ob-select
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    <span class="outfit-builder__select-text">
                      {{ section.settings.select_button_text | default: 'Add to kit' }}
                    </span>
                    <span class="outfit-builder__select-arrow" aria-hidden="true">
                      +
                    </span>
                  </button>

                </div>
              </article>
            {% endif %}
          {% endfor %}

        </div>
      </div>

      <aside
        class="outfit-builder__summary"
        data-ob-summary
        aria-label="{{ section.settings.selection_label | escape }}"
      >

        <div class="outfit-builder__summary-top">
          <div>
            <span class="outfit-builder__summary-eyebrow">
              {{ section.settings.selection_eyebrow | escape }}
            </span>

            <h3 class="outfit-builder__summary-title">
              {{ section.settings.selection_label | default: 'Your kit' }}
            </h3>
          </div>

          <span
            class="outfit-builder__summary-count"
            data-ob-count
          >0/{{ section.settings.max_items }}</span>
        </div>

        <div class="outfit-builder__summary-note">
          <span class="outfit-builder__paw" aria-hidden="true">🐾</span>
          <p>
            {{ section.settings.summary_note | escape }}
          </p>
        </div>

        <ul
          class="outfit-builder__selection"
          data-ob-selection
          role="list"
        ></ul>

        <p
          class="outfit-builder__empty-msg"
          data-ob-empty
        >
          {{ section.settings.empty_text | default: 'Select items to build your kit' }}
        </p>

        <div class="outfit-builder__totals" data-ob-totals hidden>

          <div class="outfit-builder__total-row">
            <span>{{ section.settings.total_label | default: 'Total' }}</span>
            <strong data-ob-total-price>{{ 0 | money }}</strong>
          </div>

          <button
            type="button"
            class="outfit-builder__add-btn"
            data-ob-add-all
            disabled
          >
            <span>
              {{ section.settings.add_outfit_text | default: 'Add kit to cart' }}
            </span>
            <span aria-hidden="true">→</span>
          </button>

        </div>

      </aside>

    </div>

    <div class="outfit-builder__footer">
      <span class="outfit-builder__footer-line"></span>
      <span>{{ section.settings.footer_text | escape }}</span>
      <span class="outfit-builder__footer-line"></span>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "t:sections.outfit_builder.name",
  "tag": "section",
  "class": "section-outfit-builder",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Section content"
    },
    {
      "type": "text",
      "id": "chapter_label",
      "label": "Chapter label",
      "default": "04 \u00b7 THEIR KIT",
      "info": "Short label shown with the chapter marker (for example, \"Build a kit\")."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.outfit_builder.settings.heading.label",
      "default": "Build their kit."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.outfit_builder.settings.subheading.label",
      "default": "Everyday essentials, chosen together"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Choose the pieces that belong in their day \u2014 walk, rest, play, or travel. Build a small kit that feels made for them.</p>"
    },
    {
      "type": "header",
      "content": "Labels and copy"
    },
    {
      "type": "text",
      "id": "catalog_label",
      "label": "Catalog label",
      "default": "Choose pieces for their kit",
      "info": "Heading shown above the product catalog list."
    },
    {
      "type": "text",
      "id": "selection_eyebrow",
      "label": "Selection eyebrow label",
      "default": "THEIR KIT",
      "info": "Small label shown above the selection summary heading."
    },
    {
      "type": "text",
      "id": "summary_note",
      "label": "Summary note",
      "default": "Add a few things they\u2019ll actually use."
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Pick \u00b7 mix \u00b7 make it theirs"
    },
    {
      "type": "text",
      "id": "selection_label",
      "label": "t:sections.outfit_builder.settings.selection_label.label",
      "default": "Their kit"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "t:sections.outfit_builder.settings.total_label.label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "select_button_text",
      "label": "t:sections.outfit_builder.settings.select_button_text.label",
      "default": "Add to kit"
    },
    {
      "type": "text",
      "id": "add_outfit_text",
      "label": "t:sections.outfit_builder.settings.add_outfit_text.label",
      "default": "Add kit to cart"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "t:sections.outfit_builder.settings.empty_text.label",
      "default": "Pieces for their kit will appear here."
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "t:sections.outfit_builder.settings.max_items.label",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_variant_selector",
      "label": "t:sections.outfit_builder.settings.show_variant_selector.label",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F4F0E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#273028"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#273028"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.outfit_builder.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.outfit_builder.blocks.product.settings.product.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.outfit_builder.presets.name",
      "category": "Product",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}