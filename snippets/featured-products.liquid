{% comment %}
  Featured Products Card Snippet (snippets/featured-products.liquid)
  Usage: {% render 'featured-products',
              product: product,
              show_vendor: true,
              show_rating: true,
              show_quick_add: true,
              show_compare_at: true,
              image_size: 'medium',
              card_style: 'standard' %}

  image_size now controls the visible image area height (small/medium/large)
  as well as the requested resolution, so the setting has an obvious effect.
{% endcomment %}

{%- if product != blank -%}
  {%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign featured_image = product.featured_image
    assign on_sale = false
    if current_variant.compare_at_price > current_variant.price
      assign on_sale = true
    endif

    assign image_width = 500
    if image_size == 'small'
      assign image_width = 400
    elsif image_size == 'large'
      assign image_width = 800
    endif

    assign card_style_class = 'standard'
    if card_style == 'compact'
      assign card_style_class = 'compact'
    elsif card_style == 'minimal'
      assign card_style_class = 'minimal'
    endif

    comment
      Ratings use real reviews.rating metafield data when present, and fall
      back to a sample 4.5 (12) so the setting previews on stores without a
      review app. WARNING for Theme Store distribution: placeholder ratings
      shown to real shoppers are misleading and a rejection risk. Remove
      the two default fallbacks below before submitting, or wire them
      to your review app metafields.
    endcomment
    assign rating_value = product.metafields.reviews.rating.value | default: 4.5
    assign rating_count = product.metafields.reviews.rating_count.value | default: 12
  -%}

  <div class="product-card product-card--{{ card_style_class }}"
       data-product-id="{{ product.id }}"
       data-variant-id="{{ current_variant.id }}">

    <!-- Image -->
    <div class="product-card__image-wrapper product-card__image-wrapper--{{ image_size | default: 'medium' }}">
      {%- assign card_media = product.media.first -%}
      {%- if card_media and card_media.media_type != 'image' -%}
        {%- comment -%} Rich media: video, external video, or 3D model {%- endcomment -%}
        <a href="{{ product.url }}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
          {%- case card_media.media_type -%}
            {%- when 'video', 'external_video' -%}
              {{ card_media | media_tag: image_size: '600x', controls: true, class: 'product-card__media-tag', alt: product.title }}
            {%- when 'model' -%}
              {{ card_media | media_tag: image_size: '600x', class: 'product-card__media-tag', alt: product.title }}
          {%- endcase -%}
        </a>
        <span class="product-card__media-badge" aria-hidden="true">
          {%- if card_media.media_type == 'model' -%}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l9 5v10l-9 5-9-5V7l9-5z"/><path d="M12 12l9-5M12 12v10M12 12L3 7"/></svg>
          {%- else -%}
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          {%- endif -%}
        </span>
      {%- else -%}
      <a href="{{ product.url }}" class="product-card__image-link" tabindex="-1" aria-hidden="true">
        {%- if featured_image != blank -%}
          <img
            class="product-card__image"
            src="{{ featured_image | image_url: width: image_width }}"
            srcset="
              {{ featured_image | image_url: width: 300 }} 300w,
              {{ featured_image | image_url: width: 400 }} 400w,
              {{ featured_image | image_url: width: 500 }} 500w,
              {{ featured_image | image_url: width: 800 }} 800w,
              {{ featured_image | image_url: width: 1000 }} 1000w
            "
            sizes="(max-width: 480px) 50vw, (max-width: 1024px) 33vw, calc(1280px / var(--fp-products-per-row, 4))"
            alt="{{ featured_image.alt | escape }}"
            loading="lazy"
            width="{{ featured_image.width }}"
            height="{{ featured_image.height }}"
          >
        {%- else -%}
          <div class="product-card__image-placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </a>
      {%- endif -%}

      <!-- Badges -->
      <div class="product-card__badges">
        {%- if on_sale -%}
          <span class="product-card__badge product-card__badge--sale">
            {{ 'products.product.on_sale' | t }}
          </span>
        {%- endif -%}

        {%- unless current_variant.available -%}
          <span class="product-card__badge product-card__badge--sold-out">
            {{ 'products.product.sold_out' | t }}
          </span>
        {%- endunless -%}
      </div>

      <!-- Quick View + Quick Add -->
      <button
        class="product-card__quick-view"
        type="button"
        data-quick-view-open
        data-product-handle="{{ product.handle }}"
        aria-label="{{ 'products.product.quick_view' | t }} {{ product.title | escape }}"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>
        {{ 'products.product.quick_view' | t }}
      </button>

      {%- if show_quick_add and current_variant.available -%}
        <button class="product-card__quick-add"
                data-variant-id="{{ current_variant.id }}"
                type="button">
          {{ 'products.product.add_to_cart' | t }}
        </button>
      {%- endif -%}
    </div>

    <!-- Info -->
    <div class="product-card__info">
      {%- if show_vendor and product.vendor != blank -%}
        <p class="product-card__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h3 class="product-card__title">
        <a href="{{ product.url }}" class="product-card__title-link">
          {{ product.title }}
        </a>
      </h3>

      {%- comment -%}
        Ratings render only when the product actually has review data.
        The previous version invented a 4.5 (12) rating for every product,
        which misleads shoppers and fails Theme Store review.
      {%- endcomment -%}
      {%- if show_rating and rating_value != blank -%}
        {%- liquid
          assign rating = rating_value
          assign full_stars = rating | floor
          assign half_star = rating | minus: full_stars | round
          assign next_star = full_stars | plus: 1
        -%}
        <div class="product-card__rating">
          <span class="product-card__stars" role="img" aria-label="{{ 'sections.featured_products.rating_label' | t: rating: rating }}">
            {%- for i in (1..5) -%}
              {%- if i <= full_stars -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
              {%- elsif i == next_star and half_star > 0 -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77V2Z"/></svg>
              {%- else -%}
                <svg class="empty" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.45 13.97L5.82 21.02L12 17.27L18.18 21.02L16.54 13.97L22 9.24ZM12 15.4V6.1L13.71 10.13L18.09 10.5L14.77 13.39L15.76 17.67L12 15.4Z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </span>
          {%- if rating_count != blank -%}
            <span class="product-card__rating-count">({{ rating_count }})</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="product-card__price{% if on_sale %} product-card__price--sale{% endif %}">
        <span class="product-card__price-current">{{ current_variant.price | money }}</span>

        {%- if show_compare_at and on_sale -%}
          <span class="product-card__price-compare">
            <span class="visually-hidden">{{ 'sections.featured_products.regular_price' | t }}</span>
            {{ current_variant.compare_at_price | money }}
          </span>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}
