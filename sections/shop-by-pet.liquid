{% comment %}
  Petlio — Discover their world
  This section is the second chapter of the homepage.
  Each pet entry remains a direct collection/link destination,
  while the presentation is designed to feel like one continuous
  visual story rather than a conventional card grid.
{% endcomment %}

{{ 'shop-by-pet.css' | asset_url | stylesheet_tag }}

<section
  class="shop-by-pet"
  data-section-type="shop-by-pet"
  aria-labelledby="shop-by-pet-heading-{{ section.id }}"
  style="
    --sbp-bg: {{ section.settings.background_color }};
    --sbp-text: {{ section.settings.text_color }};
    --sbp-accent: {{ section.settings.accent_color }};
    --sbp-columns: {{ section.settings.columns }};
  "
>
  <div class="shop-by-pet__container">

    <div class="shop-by-pet__intro">
      <div class="shop-by-pet__intro-copy">
        {%- if section.settings.subheading != blank -%}
          <p class="shop-by-pet__eyebrow">
            <span class="shop-by-pet__eyebrow-dot" aria-hidden="true"></span>
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2
            id="shop-by-pet-heading-{{ section.id }}"
            class="shop-by-pet__heading"
          >
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="shop-by-pet__text">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>

      <div class="shop-by-pet__intro-mark" aria-hidden="true">
        <span>🐾</span>
      </div>
    </div>

    <div class="shop-by-pet__journey">
      <span class="shop-by-pet__journey-line" aria-hidden="true"></span>

      <div class="shop-by-pet__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign link_url = block.settings.link
            if block.settings.collection != blank
              assign link_url = block.settings.collection.url
            endif

            assign pet_label = block.settings.title | default: 'Pet'
            assign pet_down = pet_label | downcase
          -%}

          <a
            class="shop-by-pet__card shop-by-pet__card--{{ forloop.index }}"
            href="{{ link_url | default: '#' }}"
            role="listitem"
            aria-label="{{ pet_label | escape }} — {{ block.settings.button_label | default: 'Explore' | escape }}"
            {{ block.shopify_attributes }}
          >
            <div class="shop-by-pet__media">
              <span class="shop-by-pet__media-glow" aria-hidden="true"></span>

              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'shop-by-pet__image',
                    loading: 'lazy',
                    widths: '360, 540, 720, 900',
                    sizes: '(max-width: 749px) 76vw, (max-width: 989px) 44vw, 23vw',
                    alt: pet_label
                }}
              {%- else -%}
                <span
                  class="shop-by-pet__emoji"
                  aria-hidden="true"
                  data-pet="{{ pet_down }}"
                >
                  {%- case block.settings.pet_icon -%}
                    {%- when 'dog' -%}🐕
                    {%- when 'cat' -%}🐈
                    {%- when 'bird' -%}🦜
                    {%- when 'fish' -%}🐟
                    {%- when 'rabbit' -%}🐇
                    {%- when 'reptile' -%}🦎
                    {%- when 'horse' -%}🐴
                    {%- else -%}🐾
                  {%- endcase -%}
                </span>
              {%- endif -%}

              <span class="shop-by-pet__media-arrow" aria-hidden="true">↗</span>
            </div>

            <div class="shop-by-pet__body">
              <div class="shop-by-pet__name-row">
                <h3 class="shop-by-pet__title">{{ pet_label | escape }}</h3>
                <span class="shop-by-pet__number" aria-hidden="true">
                  0{{ forloop.index }}
                </span>
              </div>

              {%- if block.settings.caption != blank -%}
                <p class="shop-by-pet__caption">
                  {{ block.settings.caption | escape }}
                </p>
              {%- endif -%}

              <span class="shop-by-pet__cta">
                <span>{{ block.settings.button_label | default: 'Explore' | escape }}</span>
                <span class="shop-by-pet__cta-arrow" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        {%- else -%}
          {%- for pet in (1..4) -%}
            <div class="shop-by-pet__card shop-by-pet__card--placeholder" role="listitem">
              <div class="shop-by-pet__media">
                <span class="shop-by-pet__emoji" aria-hidden="true">🐾</span>
              </div>
              <div class="shop-by-pet__body">
                <div class="shop-by-pet__name-row">
                  <h3 class="shop-by-pet__title">Pet type</h3>
                  <span class="shop-by-pet__number" aria-hidden="true">0{{ pet }}</span>
                </div>
                <p class="shop-by-pet__caption">Add a collection or link</p>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="shop-by-pet__footer">
      <span class="shop-by-pet__footer-line" aria-hidden="true"></span>
      <p>Choose a world. We'll take you from there.</p>
      <span class="shop-by-pet__footer-line" aria-hidden="true"></span>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "t:sections.shop_by_pet.name",
  "tag": "section",
  "class": "section-shop-by-pet",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.shop_by_pet.settings.heading.label",
      "default": "Find their world."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.shop_by_pet.settings.subheading.label",
      "default": "For every kind of companion"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.shop_by_pet.settings.text.label",
      "default": "<p>Every companion has their own way of living, playing and resting. Start with theirs.</p>"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.shop_by_pet.settings.columns.label",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:sections.shop_by_pet.settings.header__colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.shop_by_pet.settings.background_color.label",
      "default": "#EEF0E5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.shop_by_pet.settings.text_color.label",
      "default": "#273028"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.shop_by_pet.settings.accent_color.label",
      "default": "#273028"
    }
  ],
  "blocks": [
    {
      "type": "pet",
      "name": "t:sections.shop_by_pet.blocks.pet.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.shop_by_pet.blocks.pet.settings.title.label",
          "default": "Dogs"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.shop_by_pet.blocks.pet.settings.caption.label",
          "default": "Play · Walk · Rest"
        },
        {
          "type": "select",
          "id": "pet_icon",
          "label": "t:sections.shop_by_pet.blocks.pet.settings.pet_icon.label",
          "default": "dog",
          "options": [
            { "value": "dog", "label": "t:sections.shop_by_pet.blocks.pet.settings.pet_icon.options__1.label" },
            { "value": "cat", "label": "t:sections.shop_by_pet.blocks.pet.settings.pet_icon.options__2.label" },
            { "value": "bird", "label": "t:sections.shop_by_pet.blocks.pet.settings.pet_icon.options__3.label" },
            { "value": "fish", "label": "t:sections.shop_by_pet.blocks.pet.settings.pet_icon.options__4.label" },
            { "value": "rabbit", "label": "t:sections.shop_by_pet.blocks.pet.settings.pet_icon.options__5.label" },
            { "value": "reptile", "label": "t:sections.shop_by_pet.blocks.pet.settings.pet_icon.options__6.label" },
            { "value": "horse", "label": "t:sections.shop_by_pet.blocks.pet.settings.pet_icon.options__7.label" },
            { "value": "paw", "label": "t:sections.shop_by_pet.blocks.pet.settings.pet_icon.options__8.label" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.shop_by_pet.blocks.pet.settings.image.label"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.shop_by_pet.blocks.pet.settings.collection.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.shop_by_pet.blocks.pet.settings.link.label",
          "info": "t:sections.shop_by_pet.blocks.pet.settings.link.info"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.shop_by_pet.blocks.pet.settings.button_label.label",
          "default": "Explore"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop_by_pet.presets.name",
      "category": "Collection",
      "blocks": [
        { "type": "pet", "settings": { "title": "Dogs", "pet_icon": "dog", "caption": "Play · Walk · Rest", "button_label": "Explore dogs" } },
        { "type": "pet", "settings": { "title": "Cats", "pet_icon": "cat", "caption": "Climb · Explore · Curl up", "button_label": "Explore cats" } },
        { "type": "pet", "settings": { "title": "Birds", "pet_icon": "bird", "caption": "Fly · Play · Perch", "button_label": "Explore birds" } },
        { "type": "pet", "settings": { "title": "Small pets", "pet_icon": "rabbit", "caption": "Play · Comfort · Care", "button_label": "Explore small pets" } }
      ]
    }
  ]
}
{% endschema %}
