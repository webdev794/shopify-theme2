{{ 'care-ritual.css' | asset_url | stylesheet_tag }}
<script src="{{ 'care-ritual.js' | asset_url }}" defer></script>

<section
  class="petlio-care"
  data-section-type="care-ritual"
  data-section-id="{{ section.id }}"
  style="
    --care-bg: {{ section.settings.background_color }};
    --care-text: {{ section.settings.text_color }};
    --care-accent: {{ section.settings.accent_color }};
  "
>
  <div class="petlio-care__container">

    <div class="petlio-care__chapter">
      <span class="petlio-care__chapter-number">07</span>
      <span class="petlio-care__chapter-line"></span>
      <span class="petlio-care__chapter-label">
        CARE / EVERYDAY
      </span>
    </div>


    <div class="petlio-care__layout">

      <div class="petlio-care__visual">

        <div class="petlio-care__image-wrap">

          {% if section.settings.image != blank %}

            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '600, 900, 1200, 1600',
                sizes: '(max-width: 749px) 100vw, 58vw',
                class: 'petlio-care__image',
                alt: section.settings.image.alt | default: section.settings.heading
            }}

          {% else %}

            <div class="petlio-care__placeholder">
              <span>CARE</span>
            </div>

          {% endif %}

        </div>


        <div class="petlio-care__image-note">
          <span class="petlio-care__image-note-dot"></span>
          Little moments matter.
        </div>

      </div>


      <div class="petlio-care__content">

        <div class="petlio-care__eyebrow">
          THE EVERYDAY
        </div>


        {% if section.settings.heading != blank %}
          <h2 class="petlio-care__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}


        {% if section.settings.text != blank %}
          <div class="petlio-care__text">
            {{ section.settings.text }}
          </div>
        {% endif %}


        {% if section.settings.button_label != blank %}

          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="petlio-care__button"
          >
            <span>{{ section.settings.button_label }}</span>
            <span class="petlio-care__button-arrow" aria-hidden="true">
              →
            </span>
          </a>

        {% endif %}


        <div class="petlio-care__details">

          <div class="petlio-care__detail">
            <span class="petlio-care__detail-number">01</span>
            <span>Thoughtful essentials</span>
          </div>

          <div class="petlio-care__detail">
            <span class="petlio-care__detail-number">02</span>
            <span>Made for everyday life</span>
          </div>

          <div class="petlio-care__detail">
            <span class="petlio-care__detail-number">03</span>
            <span>For every kind of companion</span>
          </div>

        </div>

      </div>

    </div>


    <div class="petlio-care__closing">

      <span class="petlio-care__closing-line"></span>

      <p>
        {{ section.settings.closing_text }}
      </p>

      <span class="petlio-care__closing-line"></span>

    </div>

  </div>
</section>


{% schema %}
{
  "name": "Care ritual",
  "tag": "section",
  "class": "section-care-ritual",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>For every little moment.</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text",
      "default": "<p>Because caring for them is part of the everyday. Thoughtful essentials, made to fit naturally into the life you share.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore care"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "closing_text",
      "label": "Closing text",
      "default": "The best things are often the little things."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#e9e2d7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1d2921"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#71806d"
    }
  ],
  "presets": [
    {
      "name": "Care ritual"
    }
  ]
}
{% endschema %}