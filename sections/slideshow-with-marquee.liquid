{% comment %}
  Slideshow with Marquee Section
  Version: 1.0
  Description: A full-width slideshow with a scrolling marquee text overlay
{% endcomment %}

{{ 'slideshow-with-marquee.css' | asset_url | stylesheet_tag }}

<div class="slideshow-with-marquee" 
     data-section-id="{{ section.id }}"
     data-section-type="slideshow-with-marquee"
     data-autoplay="{{ section.settings.autoplay }}"
     data-autoplay-speed="{{ section.settings.autoplay_speed }}"
     data-stop-on-hover="{{ section.settings.stop_on_hover }}"
     data-slide-height="{{ section.settings.slide_height }}"
     role="region"
     aria-label="{{ section.settings.aria_label | escape }}"
     style="
       --sm-marquee-bg: {{ section.settings.marquee_bg }};
       --sm-marquee-text-color: {{ section.settings.marquee_text_color }};
       --sm-overlay-color: {{ section.settings.overlay_color }};
       --sm-text-color: {{ section.settings.text_color }};
     ">
  <div class="slideshow-with-marquee__wrapper">
    <div class="slideshow-with-marquee__slideshow">
      {%- for block in section.blocks -%}
        <div class="slideshow-with-marquee__slide" 
             data-index="{{ forloop.index0 }}"
             {% if forloop.first %}data-active="true"{% endif %}
             {{ block.shopify_attributes }}>
          
          {%- if block.settings.image != blank -%}
            <div class="slideshow-with-marquee__image-wrapper">
              {%- liquid
                assign slide_alt = block.settings.heading
                if block.settings.image.alt != blank
                  assign slide_alt = block.settings.image.alt
                endif
              -%}
              <img
                src="{{ block.settings.image | image_url: width: 1600 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 750 }} 750w,
                  {{ block.settings.image | image_url: width: 1100 }} 1100w,
                  {{ block.settings.image | image_url: width: 1600 }} 1600w,
                  {{ block.settings.image | image_url: width: 2000 }} 2000w
                "
                sizes="100vw"
                alt="{{ slide_alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="2000"
                height="800"
                class="slideshow-with-marquee__image"
              >
            </div>
          {%- else -%}
            <div class="slideshow-with-marquee__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow-with-marquee__placeholder-svg' }}
            </div>
          {%- endif -%}

          <div class="slideshow-with-marquee__content">
            <div class="slideshow-with-marquee__content-inner page-width">
              {%- if block.settings.heading != blank -%}
                <h2 class="slideshow-with-marquee__heading">
                  {{ block.settings.heading | escape }}
                </h2>
              {%- endif -%}
              
              {%- if block.settings.subheading != blank -%}
                <p class="slideshow-with-marquee__subheading">
                  {{ block.settings.subheading | escape }}
                </p>
              {%- endif -%}

              {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" class="slideshow-with-marquee__button btn">
                  {{ block.settings.button_text | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="slideshow-with-marquee__empty">
          <p>{{ 'sections.slideshow_with_marquee.empty' | t }}</p>
          {%- if shop.editor_mode -%}
            <p><small>Click "Add block" to add slides</small></p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="slideshow-with-marquee__controls">
        <button class="slideshow-with-marquee__control slideshow-with-marquee__control--prev" type="button" aria-label="{{ 'sections.slideshow_with_marquee.previous_slide' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>
        <div class="slideshow-with-marquee__dots">
          {%- for block in section.blocks -%}
            <button class="slideshow-with-marquee__dot{% if forloop.first %} slideshow-with-marquee__dot--active{% endif %}" 
                    data-index="{{ forloop.index0 }}" 
                    type="button"
                    aria-label="{{ 'sections.slideshow_with_marquee.go_to_slide' | t: index: forloop.index }}">
              <span class="slideshow-with-marquee__dot-indicator"></span>
            </button>
          {%- endfor -%}
        </div>
        <button class="slideshow-with-marquee__control slideshow-with-marquee__control--next" type="button" aria-label="{{ 'sections.slideshow_with_marquee.next_slide' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
          </svg>
        </button>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_marquee and section.settings.marquee_text != blank -%}
    <div class="slideshow-with-marquee__marquee" style="--marquee-duration: {{ section.settings.marquee_speed }}s;">
      <div class="slideshow-with-marquee__marquee-track">
        {%- assign marquee_repeats = 4 -%}
        {%- for i in (1..marquee_repeats) -%}
          <span class="slideshow-with-marquee__marquee-text">{{ section.settings.marquee_text | escape }}</span>
          <span class="slideshow-with-marquee__marquee-divider">•</span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'slideshow-with-marquee.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.slideshow_with_marquee.name",
  "tag": "section",
  "class": "slideshow-with-marquee-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "t:sections.slideshow_with_marquee.settings.header__1.content" },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow_with_marquee.settings.autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.slideshow_with_marquee.settings.autoplay_speed.label",
      "min": 3000,
      "max": 9000,
      "step": 1000,
      "default": 5000,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "stop_on_hover",
      "label": "t:sections.slideshow_with_marquee.settings.stop_on_hover.label",
      "default": true
    },
    {
      "type": "range",
      "id": "slide_height",
      "label": "t:sections.slideshow_with_marquee.settings.slide_height.label",
      "min": 400,
      "max": 800,
      "step": 50,
      "default": 600,
      "unit": "px"
    },
    { "type": "header", "content": "t:sections.slideshow_with_marquee.settings.header__2.content" },
    {
      "type": "checkbox",
      "id": "show_marquee",
      "label": "t:sections.slideshow_with_marquee.settings.show_marquee.label",
      "default": true
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "t:sections.slideshow_with_marquee.settings.marquee_text.label",
      "default": "Free shipping available • Easy returns • Exclusive offers for subscribers • Shop now"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "t:sections.slideshow_with_marquee.settings.marquee_speed.label",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "s"
    },
    { "type": "header", "content": "t:sections.slideshow_with_marquee.settings.header__3.content" },
    {
      "type": "color",
      "id": "marquee_bg",
      "label": "t:sections.slideshow_with_marquee.settings.marquee_bg.label",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "t:sections.slideshow_with_marquee.settings.marquee_text_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:sections.slideshow_with_marquee.settings.overlay_color.label",
      "default": "rgba(0, 0, 0, 0.3)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.slideshow_with_marquee.settings.text_color.label",
      "default": "#ffffff"
    },
    { "type": "header", "content": "t:sections.slideshow_with_marquee.settings.header__4.content" },
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.slideshow_with_marquee.settings.aria_label.label",
      "default": "Slideshow with marquee"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow_with_marquee.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.slideshow_with_marquee.blocks.slide.settings.image.label",
          "info": "t:sections.slideshow_with_marquee.blocks.slide.settings.image.info"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.slideshow_with_marquee.blocks.slide.settings.heading.label",
          "default": "Slide Title"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "t:sections.slideshow_with_marquee.blocks.slide.settings.subheading.label",
          "default": "A compelling message for your customers"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:sections.slideshow_with_marquee.blocks.slide.settings.button_text.label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.slideshow_with_marquee.blocks.slide.settings.button_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow_with_marquee.presets.name",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "heading": "New Collection",
            "subheading": "Discover our latest arrivals",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Limited Time Offer",
            "subheading": "Up to 50% off select items",
            "button_text": "View Deals"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "Subscribe and Save",
            "subheading": "Get 10% off your first order",
            "button_text": "Learn More"
          }
        }
      ]
    }
  ]
}
{% endschema %}