{% comment %}
  Text with Icons Section
  Version: 1.0
  Design: Clean, accessible, responsive
{% endcomment %}

{{ 'text-with-icons.css' | asset_url | stylesheet_tag: preload: true }}

<div class="text-with-icons" data-section-id="{{ section.id }}" data-section-type="text-with-icons">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="text-with-icons__header">
        <h2 class="text-with-icons__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="text-with-icons__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="text-with-icons__grid text-with-icons__grid--columns-{{ section.settings.columns }} text-with-icons__grid--align-{{ section.settings.alignment }}">
      {%- for block in section.blocks -%}
        <div class="text-with-icons__item" {{ block.shopify_attributes }}>
          <div class="text-with-icons__card">
            {%- if block.settings.icon != 'none' -%}
              <div class="text-with-icons__icon-wrapper">
                {%- render 'icon', icon: block.settings.icon -%}
              </div>
            {%- endif -%}

            <div class="text-with-icons__content">
              {%- if block.settings.title != blank -%}
                <h3 class="text-with-icons__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="text-with-icons__text rte">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" class="text-with-icons__button link">
                  {{ block.settings.button_text | escape }}
                  <span class="text-with-icons__button-arrow">→</span>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.text_with_icons.name",
  "tag": "section",
  "class": "text-with-icons-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.text_with_icons.settings.heading.label",
      "default": "Why Choose Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.text_with_icons.settings.subheading.label",
      "default": "Discover what makes us different"
    },
    { "type": "header", "content": "t:sections.text_with_icons.settings.header__1.content" },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.text_with_icons.settings.columns.label",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.text_with_icons.settings.alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.text_with_icons.settings.alignment.options__1.label" },
        { "value": "center", "label": "t:sections.text_with_icons.settings.alignment.options__2.label" },
        { "value": "right", "label": "t:sections.text_with_icons.settings.alignment.options__3.label" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.text_with_icons.blocks.item.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.text_with_icons.blocks.item.settings.icon.label",
          "options": [
            { "value": "none", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__1.label" },
            { "value": "truck", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__2.label" },
            { "value": "shield", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__3.label" },
            { "value": "star", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__4.label" },
            { "value": "heart", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__5.label" },
            { "value": "gift", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__6.label" },
            { "value": "clock", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__7.label" },
            { "value": "check", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__8.label" },
            { "value": "cart", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__9.label" },
            { "value": "tag", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__10.label" },
            { "value": "lock", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__11.label" },
            { "value": "globe", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__12.label" },
            { "value": "chat", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__13.label" },
            { "value": "phone", "label": "t:sections.text_with_icons.blocks.item.settings.icon.options__14.label" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.text_with_icons.blocks.item.settings.title.label",
          "default": "Feature Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.text_with_icons.blocks.item.settings.text.label",
          "default": "<p>Describe your feature or benefit here.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "t:sections.text_with_icons.blocks.item.settings.button_text.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.text_with_icons.blocks.item.settings.button_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.text_with_icons.presets.name",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free Shipping",
            "text": "<p>Enjoy free shipping on all orders over $50</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "shield",
            "title": "Secure Payments",
            "text": "<p>Your payment information is always secure</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "star",
            "title": "Premium Quality",
            "text": "<p>Handpicked products from trusted brands</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
