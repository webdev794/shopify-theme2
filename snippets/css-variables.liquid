{% liquid
  assign primary_key = settings.type_primary_font | default: 'work_sans'
  assign heading_key = settings.type_heading_font | default: 'work_sans'

  case primary_key
    when 'system'
      assign primary_family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif'
    when 'work_sans'
      assign primary_family = '"Work Sans", sans-serif'
    when 'inter'
      assign primary_family = 'Inter, sans-serif'
    when 'montserrat'
      assign primary_family = 'Montserrat, sans-serif'
    when 'poppins'
      assign primary_family = 'Poppins, sans-serif'
    when 'roboto'
      assign primary_family = 'Roboto, sans-serif'
    when 'open_sans'
      assign primary_family = '"Open Sans", sans-serif'
    when 'lato'
      assign primary_family = 'Lato, sans-serif'
    when 'nunito'
      assign primary_family = 'Nunito, sans-serif'
    when 'raleway'
      assign primary_family = 'Raleway, sans-serif'
    when 'source_sans_3'
      assign primary_family = '"Source Sans 3", sans-serif'
    when 'dm_sans'
      assign primary_family = '"DM Sans", sans-serif'
    when 'plus_jakarta_sans'
      assign primary_family = '"Plus Jakarta Sans", sans-serif'
    when 'outfit'
      assign primary_family = 'Outfit, sans-serif'
    when 'manrope'
      assign primary_family = 'Manrope, sans-serif'
    when 'space_grotesk'
      assign primary_family = '"Space Grotesk", sans-serif'
    when 'playfair_display'
      assign primary_family = '"Playfair Display", serif'
    when 'merriweather'
      assign primary_family = 'Merriweather, serif'
    when 'lora'
      assign primary_family = 'Lora, serif'
    when 'oswald'
      assign primary_family = 'Oswald, sans-serif'
    else
      assign primary_family = '"Work Sans", sans-serif'
  endcase

  case heading_key
    when 'system'
      assign heading_family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif'
    when 'work_sans'
      assign heading_family = '"Work Sans", sans-serif'
    when 'inter'
      assign heading_family = 'Inter, sans-serif'
    when 'montserrat'
      assign heading_family = 'Montserrat, sans-serif'
    when 'poppins'
      assign heading_family = 'Poppins, sans-serif'
    when 'roboto'
      assign heading_family = 'Roboto, sans-serif'
    when 'open_sans'
      assign heading_family = '"Open Sans", sans-serif'
    when 'lato'
      assign heading_family = 'Lato, sans-serif'
    when 'nunito'
      assign heading_family = 'Nunito, sans-serif'
    when 'raleway'
      assign heading_family = 'Raleway, sans-serif'
    when 'source_sans_3'
      assign heading_family = '"Source Sans 3", sans-serif'
    when 'dm_sans'
      assign heading_family = '"DM Sans", sans-serif'
    when 'plus_jakarta_sans'
      assign heading_family = '"Plus Jakarta Sans", sans-serif'
    when 'outfit'
      assign heading_family = 'Outfit, sans-serif'
    when 'manrope'
      assign heading_family = 'Manrope, sans-serif'
    when 'space_grotesk'
      assign heading_family = '"Space Grotesk", sans-serif'
    when 'playfair_display'
      assign heading_family = '"Playfair Display", serif'
    when 'merriweather'
      assign heading_family = 'Merriweather, serif'
    when 'lora'
      assign heading_family = 'Lora, serif'
    when 'oswald'
      assign heading_family = 'Oswald, sans-serif'
    else
      assign heading_family = '"Work Sans", sans-serif'
  endcase
%}
{% style %}
  :root {
    /* ============================================
       TYPOGRAPHY
       ============================================ */
    --font-primary--family: {{ primary_family }};
    --font-primary--style: normal;
    --font-primary--weight: 400;

    --font-heading--family: {{ heading_family }};
    --font-heading--style: normal;
    --font-heading--weight: 700;

    /* ============================================
       LAYOUT
       ============================================ */
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /* ============================================
       PRIMARY COLORS (Merchant Settings)
       ============================================ */
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};

    /* ============================================
       SECONDARY COLORS (Merchant Settings)
       ============================================ */
    --color-background-secondary: {{ settings.background_color_secondary }};
    --color-foreground-secondary: {{ settings.foreground_color_secondary }};

    /* ============================================
       ACCENT / BUTTONS (Merchant Settings)
       ============================================ */
    --color-accent-background: {{ settings.accent_background }};
    --color-accent-foreground: {{ settings.accent_foreground }};

    /* ============================================
       BORDER RADIUS
       ============================================ */
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    /* ============================================
       STATUS COLORS
       These are semantic colors used across the theme
       for consistent status messaging, validation,
       badges, and UI feedback.
       ============================================ */

    /* ── Sale / Discounts ──
       Used for sale badges, sale prices, and promotional indicators */
    --color-sale: {{ settings.color_sale }};

    /* ── Sold Out / Unavailable ──
       Used for sold-out badges and unavailable product states */
    --color-sold-out: {{ settings.color_sold_out }};

    /* ── Success States ──
       Used for form success messages, valid inputs, and positive feedback */
    --color-success: {{ settings.color_success }};
    --color-success-bg: {{ settings.color_success_bg }};
    --color-success-text: {{ settings.color_success_text }};

    /* ── Error States ──
       Used for form errors, invalid inputs, and negative feedback */
    --color-error: {{ settings.color_error }};
    --color-error-bg: {{ settings.color_error_bg }};
    --color-error-text: {{ settings.color_error_text }};

    /* ── Star Ratings ──
       Used for product review stars (darkened for 3:1 non-text contrast) */
    --color-star: {{ settings.color_star }};

    /* ── Disabled States ──
       Used for disabled UI elements and inactive states */
    --color-disabled: {{ settings.color_disabled }};
    --color-disabled-dark: {{ settings.color_disabled_dark }};

    /* ============================================
       HEADER FALLBACK VARIABLES
       These ensure the header works even if section
       settings aren't fully configured.
       ============================================ */
    --header-background: var(--color-background, #ffffff);
    --header-foreground: var(--color-foreground, #1a1a1a);
    --header-hover: var(--color-accent-background, #121212);

    /* ============================================
       HERO FALLBACK VARIABLES
       Ensures hero sections work with minimal setup.
       ============================================ */
    --hero-foreground: var(--color-foreground, #1a1a1a);

    /* ============================================
       BORDER COLOR FALLBACK
       Used across the theme for borders and dividers.
       ============================================ */
    --color-border: color-mix(in srgb, var(--color-foreground, #1a1a1a) 15%, transparent);
  }
{% endstyle %}