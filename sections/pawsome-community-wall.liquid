{% comment %}
  Paw-some Community Wall - UGC style grid for pet parents
{% endcomment %}

{{ 'pawsome-community-wall.css' | asset_url | stylesheet_tag }}

<section class="pawsome-community section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="community__header">
      {% if section.settings.heading != blank %}
        <h2 class="community__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="community__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="community__filters" data-filters>
        <button type="button" class="community__filter is-active" data-filter="all">All</button>
        {% assign tags = '' %}
        {% for block in section.blocks %}
          {% if block.settings.tag != blank %}
            {% unless tags contains block.settings.tag %}
              {% assign tags = tags | append: block.settings.tag | append: ',' %}
              <button type="button" class="community__filter" data-filter="{{ block.settings.tag | handleize }}">
                {{ block.settings.tag }}
              </button>
            {% endunless %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="community__grid" data-grid>
      {% for block in section.blocks %}
        <div class="community__card" 
             {{ block.shopify_attributes }}
             data-tag="{{ block.settings.tag | handleize | default: 'all' }}">
          <div class="community__image-wrap">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'community__image' }}
            {% else %}
              <div class="community__placeholder">🐾</div>
            {% endif %}
            {% if block.settings.pet_name != blank %}
              <span class="community__pet-name">{{ block.settings.pet_name }}</span>
            {% endif %}
          </div>
          <div class="community__body">
            {% if block.settings.story != blank %}
              <p class="community__story">{{ block.settings.story }}</p>
            {% endif %}
            {% if block.settings.owner_name != blank %}
              <div class="community__owner">— {{ block.settings.owner_name }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.cta_text != blank and section.settings.cta_url != blank %}
      <div class="community__cta">
        <a href="{{ section.settings.cta_url }}" class="community__cta-btn">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<script src="{{ 'pawsome-community-wall.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Paw-some Community Wall",
  "tag": "section",
  "class": "section-community-wall",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Paw-some Community"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real pets. Real stories. Real love from our pack."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Share Your Pet’s Story"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Pet Story",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Pet photo"
        },
        {
          "type": "text",
          "id": "pet_name",
          "label": "Pet name",
          "default": "Buddy"
        },
        {
          "type": "text",
          "id": "owner_name",
          "label": "Owner name",
          "default": "Sarah M."
        },
        {
          "type": "textarea",
          "id": "story",
          "label": "Short story",
          "default": "Since switching to their food, Buddy has so much more energy on our morning walks!"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Filter tag (e.g. Dogs, Cats, Puppies)",
          "default": "Dogs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Paw-some Community Wall",
      "blocks": [
        {
          "type": "story",
          "settings": {
            "pet_name": "Luna",
            "owner_name": "Priya R.",
            "story": "Luna’s coat has never been shinier. The fish oil treats are her absolute favourite!",
            "tag": "Cats"
          }
        },
        {
          "type": "story",
          "settings": {
            "pet_name": "Max",
            "owner_name": "James T.",
            "story": "We tried three beds before this one. Max actually sleeps through the night now.",
            "tag": "Dogs"
          }
        },
        {
          "type": "story",
          "settings": {
            "pet_name": "Biscuit",
            "owner_name": "Emily K.",
            "story": "Our senior pup has more spring in her step since starting the joint support chews.",
            "tag": "Seniors"
          }
        },
        {
          "type": "story",
          "settings": {
            "pet_name": "Mochi",
            "owner_name": "Alex & Sam",
            "story": "The puzzle toy keeps Mochi busy for ages. Best purchase for a rainy day!",
            "tag": "Dogs"
          }
        }
      ]
    }
  ]
}
{% endschema %}
