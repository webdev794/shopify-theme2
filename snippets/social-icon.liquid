{%- comment -%}
  Renders social icon links from Theme Settings → Social media
  (settings.social_*_link). Single source of truth for footer, newsletter,
  password page, and any other section that needs social icons.

  To add a platform:
    1. Add social_<platform>_link in settings_schema.json (Social media group)
    2. Add the platform id to platform_ids below
    3. Add a matching {% when '<platform>' %} SVG case and label

  Accepts:
  - wrapper_class: {String} class for the outer <ul> (optional)
  - link_class: {String} class for each <a> (optional)
{%- endcomment -%}

{%- liquid
  assign wrapper_class = wrapper_class | default: 'social-icons'
  assign link_class = link_class | default: 'social-icons__link'
  assign platform_ids = 'instagram,facebook,twitter,tiktok,youtube,pinterest,linkedin,snapchat,threads,tumblr,vimeo' | split: ','
-%}

<ul class="{{ wrapper_class }}" role="list">
  {%- for platform in platform_ids -%}
    {%- assign setting_key = 'social_' | append: platform | append: '_link' -%}
    {%- assign url = settings[setting_key] -%}
    {%- if url != blank -%}
      {%- liquid
        case platform
          when 'twitter'
            assign platform_label = 'X'
          when 'tiktok'
            assign platform_label = 'TikTok'
          when 'youtube'
            assign platform_label = 'YouTube'
          when 'linkedin'
            assign platform_label = 'LinkedIn'
          else
            assign platform_label = platform | capitalize
        endcase
      -%}
      <li>
        <a
          href="{{ url }}"
          class="{{ link_class }}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="{{ platform_label }}"
        >
          {%- case platform -%}
            {%- when 'instagram' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
            {%- when 'facebook' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2.1-.1-2.1 0-3.6 1.3-3.6 3.7V11H8.3v3h2.4v7h2.8z"/></svg>
            {%- when 'twitter' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M17.6 3H21l-7.4 8.5L22.2 21h-6.8l-5.3-6.3L4 21H.6L8.5 12 .2 3h7l4.8 5.7L17.6 3zm-1.2 16h1.9L6.6 4.9H4.6L16.4 19z"/></svg>
            {%- when 'tiktok' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16.5 3c.3 1.9 1.6 3.4 3.5 3.7v3c-1.3 0-2.5-.4-3.5-1.1v5.9c0 3.4-2.6 5.5-5.4 5.5A5.3 5.3 0 0 1 5.8 14a5.4 5.4 0 0 1 5.9-5.3v3.1a2.4 2.4 0 0 0-3 2.3c0 1.3 1.1 2.4 2.4 2.4 1.4 0 2.4-1 2.4-2.6V3h3z"/></svg>
            {%- when 'youtube' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12c0 1.6.1 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.3-1.6.4-3.2.4-4.8s-.1-3.2-.4-4.8zM10 15.2V8.8l5.3 3.2L10 15.2z"/></svg>
            {%- when 'pinterest' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.3-.1-.8-.2-2 0-2.9.2-.8 1.3-5.4 1.3-5.4s-.3-.7-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.5-.3 1.1.5 1.9 1.6 1.9 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.2-3.8-3.1 0-5 2.3-5 4.8 0 .9.3 1.5.7 2 .1.1.1.2.1.3l-.3 1.1c0 .2-.1.2-.3.1-1.2-.5-1.8-1.9-1.8-3.5 0-2.9 2.5-6.4 7.3-6.4 3.9 0 6.5 2.8 6.5 5.9 0 4-2.3 7-5.6 7-1.1 0-2.2-.6-2.5-1.3l-.7 2.6c-.2.9-.9 2-1.3 2.7 1 .3 2.1.5 3.2.5 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
            {%- when 'linkedin' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M6.94 5a2 2 0 11-4-.002 2 2 0 014 .002zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-3.96 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.68-2.91V8.48z"/></svg>
            {%- when 'snapchat' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12.04 2c-2.3 0-3.9 1.7-3.9 4.1v.5c0 .3-.1.5-.4.6-1.7.7-2.7 1.8-2.7 2.9 0 .6.3 1.1.9 1.4.2.1.3.3.2.5-.1.5-.5 1.1-1.5 1.4-.2.1-.3.2-.3.4 0 .5.9 1 2 1.2.3 0 .5.2.5.5 0 1.1.9 2.4 2.3 3.2.3.2.4.5.3.8-.2.5-.5 1-.5 1.5 0 .6.5 1.1 1.2 1.1h3.8c.7 0 1.2-.5 1.2-1.1 0-.5-.3-1-.5-1.5-.1-.3 0-.6.3-.8 1.4-.8 2.3-2.1 2.3-3.2 0-.3.2-.5.5-.5 1.1-.2 2-.7 2-1.2 0-.2-.1-.3-.3-.4-1-.3-1.4-.9-1.5-1.4 0-.2.1-.4.2-.5.6-.3.9-.8.9-1.4 0-1.1-1-2.2-2.7-2.9-.3-.1-.4-.3-.4-.6v-.5C15.94 3.7 14.34 2 12.04 2z"/></svg>
            {%- when 'threads' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12.2 9.4c-.7 0-1.3.3-1.7.8V8.5h-1.7v7.8h1.7v-.5c.4.4 1 .7 1.7.7 1.5 0 2.6-1.2 2.6-3.1s-1.1-3-2.6-3zm0 4.7c-.7 0-1.2-.6-1.2-1.6s.5-1.6 1.2-1.6 1.2.6 1.2 1.6-.5 1.6-1.2 1.6zM12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm5.4 12.1c-.5 2.4-2.5 3.9-5.1 3.9-1.2 0-2.2-.3-3-.9v3.2H7.5V8.5h1.8v.9c.7-.7 1.7-1.1 2.9-1.1 2.6 0 4.6 1.6 5.1 4 0 .1.1.4.1.6 0 .4 0 .8-.1 1.2z"/></svg>
            {%- when 'tumblr' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M14.6 21c-3.3 0-5.8-1.7-5.8-5.8V10H6.5V6.9c2.5-.5 3.5-2.2 3.7-4.1h2.6v3.7h3.3V10h-3.3v4.5c0 1.4.7 1.9 1.8 1.9.6 0 1.3-.1 1.9-.4v3.1c-.8.5-1.9.9-3.1.9z"/></svg>
            {%- when 'vimeo' -%}
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M22.3 7.1c-.1 1.8-1.3 4.3-3.7 7.4-2.5 3.3-4.6 4.9-6.3 4.9-.9 0-1.6-.9-2.3-2.7l-1.3-4.7c-.5-1.8-1-2.7-1.6-2.7-.1 0-.6.3-1.5.9L5 8.7c1.1-1 2.2-1.9 3.3-2.8 1.5-1.2 2.6-1.9 3.4-1.9 1.1 0 1.8.6 2.1 1.9.3 1.3.5 2.2.7 2.6.5 1.6 1 2.4 1.6 2.4.4 0 1.1-.7 2-2.1.9-1.4 1.3-2.5 1.4-3.2.1-1.2-.4-1.8-1.4-1.8-.5 0-1 .1-1.6.3 1.1-3.5 3.1-5.2 6.1-5.1 2.2.1 3.2 1.5 3.1 4.1z"/></svg>
          {%- endcase -%}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
