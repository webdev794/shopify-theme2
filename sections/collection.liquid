{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection

  NOTE: check templates/collection.json for the "type" value of its main
  section, and name this file to match (e.g. type "main-collection-product-grid"
  means this file should be sections/main-collection-product-grid.liquid).
{% endcomment %}

{% assign title_font_base = section.settings.card_title_font %}
{% assign title_font_italic = title_font_base | font_modify: 'weight', '500' | font_modify: 'style', 'italic' %}
{% assign label_font = section.settings.card_label_font %}
{% assign label_font_bold = label_font | font_modify: 'weight', '600' %}

<div class="collection full-width" id="collection-{{ section.id }}">
  {% style %}
    {{ title_font_base | font_face: font_display: 'swap' }}
    {{ title_font_base | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {{ title_font_base | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {{ title_font_base | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {{ title_font_italic | font_face: font_display: 'swap' }}

    {{ label_font | font_face: font_display: 'swap' }}
    {{ label_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
    {{ label_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {{ label_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {{ label_font_bold | font_face: font_display: 'swap' }}

    #collection-{{ section.id }} {
      --collection-font-title: {{ title_font_italic.family }}, {{ title_font_italic.fallback_families }};
      --collection-font-label: {{ label_font.family }}, {{ label_font.fallback_families }};
    }
  {% endstyle %}

  <div class="collection__header">
    {% if section.settings.show_collection_image and collection.image %}
      <div class="collection__banner">
        <div class="collection__banner-backdrop" aria-hidden="true">
          {{
            collection.image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              widths: '750, 1100, 1600',
              sizes: '100vw',
              alt: '',
              class: 'collection__banner-backdrop-image'
          }}
        </div>
        {{
          collection.image
          | image_url: width: 3200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1500, 2000, 2600, 3200',
            sizes: '100vw',
            alt: collection.image.alt | default: collection.title,
            class: 'collection__banner-image'
        }}
      </div>
    {% endif %}

    <div class="collection__header-content collection__page-width">
      <h1 class="collection__title">{{ collection.title }}</h1>

      {% if collection.description != blank %}
        <div class="collection__description rte">{{ collection.description }}</div>
      {% endif %}
    </div>
  </div>

  {% paginate collection.products by 24 %}
    <div class="collection__page-width">
      <div class="collection__layout">
        {% if section.settings.enable_filtering %}
          <aside class="collection__filters">
            {% render 'facets', filters: collection.filters, clear_url: collection.url, section: section %}
          </aside>
        {% endif %}

        <div class="collection__main">
          <div class="collection__toolbar">
            <p class="collection__count">
              {{ 'collections.general.items_with_count' | t: count: paginate.items }}
            </p>

            {% if section.settings.enable_sorting and collection.sort_options.size > 1 %}
              <form class="collection__sort" method="get">
                <label for="sort-by-{{ section.id }}">{{ 'collections.sorting.title' | t }}</label>
                <select
                  name="sort_by"
                  id="sort-by-{{ section.id }}"
                  class="collection__sort-select"
                  onchange="this.form.submit()"
                >
                  {% for option in collection.sort_options %}
                    <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                      {{ option.name }}
                    </option>
                  {% endfor %}
                </select>
              </form>
            {% endif %}
          </div>

          {% if paginate.items == 0 %}
            <div class="collection__empty">
              <p>{{ 'collections.general.no_matches' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
                {{ 'collections.general.view_all' | t }}
              </a>
            </div>
          {% else %}
            <div
              class="collection__grid"
              style="
                --columns-desktop: {{ section.settings.columns_desktop }};
                --columns-mobile: {{ section.settings.columns_mobile }};
              "
            >
              {% for product in collection.products %}
                <div class="product-card">
                  <div class="product-card__media">
                    <a
                      href="{{ product.url }}"
                      class="product-card__media-link"
                      aria-label="{{ product.title | escape }}"
                    >
                      {% if product.featured_image %}
                        {{
                          product.featured_image
                          | image_url: width: 600, height: 600, crop: 'center'
                          | image_tag:
                            loading: 'lazy',
                            widths: '250,350,450,600',
                            sizes: '(min-width: 1400px) 16vw, (min-width: 990px) 20vw, 50vw',
                            alt: product.featured_image.alt | default: product.title,
                            class: 'product-card__image product-card__image--primary'
                        }}
                        {% if product.images.size > 1 %}
                          {{
                            product.images[1]
                            | image_url: width: 600, height: 600, crop: 'center'
                            | image_tag:
                              loading: 'lazy',
                              widths: '250,350,450,600',
                              sizes: '(min-width: 1400px) 16vw, (min-width: 990px) 20vw, 50vw',
                              alt: '',
                              class: 'product-card__image product-card__image--secondary'
                          }}
                        {% endif %}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-card__image' }}
                      {% endif %}
                    </a>

                    <div class="product-card__badges">
                      {% unless product.available %}
                        <span class="badge badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
                      {% else %}
                        {% if section.settings.show_sale_badge and product.compare_at_price_max > product.price_min %}
                          <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
                        {% endif %}
                      {% endunless %}
                    </div>

                    {% if section.settings.show_quick_add and product.available %}
                      <div class="product-card__quick-add">
                        {% if product.has_only_default_variant %}
                          {% form 'product', product %}
                            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                            <button type="submit" class="product-card__quick-add-button">
                              {{ 'products.product.add_to_cart' | t }}
                            </button>
                          {% endform %}
                        {% else %}
                          <a href="{{ product.url }}" class="product-card__quick-add-button">
                            {{ 'products.product.choose_options' | t }}
                          </a>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>

                  <div class="product-card__content">
                    {% if section.settings.show_vendor and product.vendor != blank %}
                      <p class="product-card__vendor">{{ product.vendor }}</p>
                    {% endif %}

                    <h3 class="product-card__title">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>

                    <div class="product-card__price">
                      {% assign product_on_sale = false %}
                      {% if product.compare_at_price_max > product.price_min %}
                        {% assign product_on_sale = true %}
                      {% endif %}

                      {% if product.price_varies %}
                        <span class="price price--range{% if product_on_sale %} price--sale{% endif %}">
                          {{ product.price_min | money }} &ndash; {{ product.price_max | money }}
                        </span>
                      {% elsif product_on_sale %}
                        <span class="price price--sale">{{ product.price_min | money }}</span>
                      {% else %}
                        <span class="price">{{ product.price_min | money }}</span>
                      {% endif %}

                      {% if product_on_sale %}
                        <span class="price price--compare">
                          <s>{{ product.compare_at_price_max | money }}</s>
                        </span>
                      {% endif %}
                    </div>
                    {% render 'unit-price', object: product.selected_or_first_available_variant %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          <div class="collection__pagination">
            {{ paginate | default_pagination }}
          </div>
        </div>
      </div>
    </div>
  {% endpaginate %}
</div>

{% stylesheet %}
  .collection {
    --collection-ink: var(--color-foreground, #171310);
    --collection-ivory: var(--color-background, #faf7f2);
    --collection-bronze: var(--color-accent-background, #c9a063);
    --collection-wine: var(--color-sale, #6e1f31);
    --collection-taupe: var(--color-foreground-secondary, #8c7b6b);
    --collection-border: color-mix(in srgb, var(--color-foreground, #171310) 12%, transparent);

    padding-block: 2.5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    background: var(--collection-ivory);
    color: var(--collection-ink);
    font-family: var(--collection-font-label);
  }

  .collection__page-width {
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  /* ---------- Filters layout ---------- */
  .collection__layout {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .collection__main {
    min-width: 0;
  }

  @media screen and (min-width: 990px) {
    .collection__layout {
      flex-direction: row;
      align-items: flex-start;
      gap: 2.5rem;
    }

    .collection__filters {
      flex: 0 0 220px;
      position: sticky;
      top: 1.5rem;
    }

    .collection__main {
      flex: 1;
    }
  }

  /* ---------- Header ---------- */
  .collection__header {
    display: flex;
    flex-direction: column;
  }

  .collection__header-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
  }

  .collection__banner {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 22rem;
    overflow: hidden;
    background-color: var(--collection-ivory);
  }

  .collection__banner-backdrop {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .collection__banner-backdrop-image {
    position: absolute;
    inset: -8%;
    width: 116%;
    height: 116%;
    object-fit: cover;
    object-position: center;
    filter: blur(32px) saturate(1.1);
    transform: scale(1.02);
    opacity: 0.55;
  }

  .collection__banner-image {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: scale-down;
    object-position: center;
    display: block;
  }

  @media screen and (min-width: 750px) {
    .collection__banner {
      aspect-ratio: 3 / 1;
      max-height: 24rem;
    }
  }

  .collection__title {
    font-family: var(--collection-font-title);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.9rem, 1.5rem + 1.4vw, 3rem);
  }

  .collection__description {
    color: var(--collection-taupe);
    max-width: 60ch;
    line-height: 1.6;
  }

  /* ---------- Toolbar ---------- */
  .collection__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-block: 1px solid var(--collection-border);
    padding-block: 0.75rem;
  }

  .collection__count {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--collection-taupe);
  }

  .collection__sort {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--collection-taupe);
  }

  .collection__sort-select {
    padding: 0.4rem 0.7rem;
    border-radius: 0.3rem;
    border: 1px solid var(--collection-border);
    background: var(--collection-ivory);
    color: var(--collection-ink);
    font-family: var(--collection-font-label);
    font-size: 0.8rem;
  }

  /* ---------- Empty state ---------- */
  .collection__empty {
    text-align: center;
    padding-block: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--collection-taupe);
  }

  .collection__empty .button--primary {
    display: inline-block;
    padding: 0.7rem 1.6rem;
    border-radius: 999px;
    background: var(--collection-ink);
    color: var(--collection-ivory);
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ---------- Grid Layout ---------- */
  .collection__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile, 2), 1fr);
    gap: 0.9rem 0.7rem;
  }

  @media screen and (min-width: 750px) {
    .collection__grid {
      grid-template-columns: repeat(var(--columns-desktop, 5), 1fr);
      gap: 1.5rem 1.15rem;
    }
  }

  /* ---------- Product Card Image Hard Fix ---------- */
  .product-card {
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
  }

  .product-card__media {
    position: relative !important;
    width: 100% !important;
    padding-top: 100% !important; /* Forces 1:1 Aspect Ratio Box */
    height: 0 !important;
    border-radius: 0.4rem;
    overflow: hidden;
    background: var(--collection-ivory);
  }

  .product-card__media-link {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  .product-card__image {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important; /* Crops image to fill exact box dimensions */
    object-position: center !important;
    display: block !important;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-card__image--primary {
    transform: scale(1.03);
  }

  .product-card__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-card__media:hover .product-card__image--secondary,
  .product-card__media:focus-within .product-card__image--secondary {
    opacity: 1;
  }

  .product-card__badges {
    position: absolute;
    top: 0.55rem;
    left: 0.55rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    pointer-events: none;
    z-index: 2;
  }

  .badge {
    font-family: var(--collection-font-label);
    font-size: 0.62rem;
    font-weight: 600;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .badge--sale {
    background: var(--collection-wine);
    color: var(--collection-ivory);
  }

  .badge--sold-out {
    background: color-mix(in srgb, var(--collection-ink) 75%, transparent);
    color: var(--collection-ivory);
  }

  .product-card__quick-add {
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.5rem;
    opacity: 0;
    transform: translateY(0.4rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 2;
  }

  .product-card__media:hover .product-card__quick-add,
  .product-card__media:focus-within .product-card__quick-add {
    opacity: 1;
    transform: translateY(0);
  }

  .product-card__quick-add-button {
    width: 100%;
    text-align: center;
    padding: 0.55rem 0.8rem;
    border-radius: 0.3rem;
    border: none;
    background: var(--collection-ivory);
    color: var(--collection-ink);
    font-family: var(--collection-font-label);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(23, 19, 16, 0.18);
    display: block;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .product-card__quick-add-button:hover {
    background: var(--collection-ink);
    color: var(--collection-ivory);
  }

  .product-card__content {
    margin-top: 0;
    padding: 0.65rem 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex-grow: 1;
  }

  .product-card__vendor {
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--collection-taupe);
  }

  .product-card__title {
    font-family: var(--collection-font-title);
    font-style: italic;
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .product-card__title a:hover {
    color: var(--collection-bronze);
  }

  .product-card__price {
    font-size: 0.82rem;
    line-height: 1.4;
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    margin-top: auto;
    padding-inline: 0.05rem;
    overflow: visible;
  }

  .price--range {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--collection-ink);
  }

  .price--sale {
    color: var(--collection-wine);
    font-weight: 600;
  }

  .price--compare {
    color: var(--collection-taupe);
  }

  /* ---------- Pagination ---------- */
  .collection__pagination {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  .collection__pagination nav {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .collection__pagination nav a,
  .collection__pagination nav span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.1rem;
    height: 2.1rem;
    padding-inline: 0.5rem;
    border-radius: 0.3rem;
    font-size: 0.82rem;
    text-decoration: none;
    color: var(--collection-ink);
  }

  .collection__pagination nav a:hover {
    background: var(--collection-ivory);
  }

  .collection__pagination nav [aria-current='page'] {
    background: var(--collection-ink);
    color: var(--collection-ivory);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "t:sections.collection.settings.show_collection_image.label",
      "default": true
    },
    { "type": "header", "content": "t:sections.collection.settings.header__1.content" },
    {
      "type": "font_picker",
      "id": "card_title_font",
      "label": "t:sections.collection.settings.card_title_font.label",
      "default": "playfair_display_i4"
    },
    {
      "type": "font_picker",
      "id": "card_label_font",
      "label": "t:sections.collection.settings.card_label_font.label",
      "default": "jost_n4"
    },
    { "type": "header", "content": "t:sections.collection.settings.header__2.content" },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.collection.settings.columns_desktop.label",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.collection.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.collection.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.collection.settings.columns_mobile.options__2.label" },
        { "value": "3", "label": "t:sections.collection.settings.columns_mobile.options__3.label" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.collection.settings.image_ratio.label",
      "options": [
        { "value": "square", "label": "t:sections.collection.settings.image_ratio.options__1.label" },
        { "value": "portrait", "label": "t:sections.collection.settings.image_ratio.options__2.label" },
        { "value": "natural", "label": "t:sections.collection.settings.image_ratio.options__3.label" }
      ],
      "default": "square"
    },
    { "type": "header", "content": "t:sections.collection.settings.header__3.content" },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.collection.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "t:sections.collection.settings.show_sale_badge.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.collection.settings.show_quick_add.label",
      "default": true
    },
    { "type": "header", "content": "t:sections.collection.settings.header__4.content" },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.collection.settings.enable_filtering.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.collection.settings.enable_sorting.label",
      "default": true
    }
  ]
}
{% endschema %}