{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign looks = section.blocks | where: 'type', 'look'
-%}

{{ 'shop-the-look.css' | asset_url | stylesheet_tag }}
<script src="{{ 'shop-the-look.js' | asset_url }}" defer="defer"></script>

<section
  id="ShopLook-{{ section_id }}"
  class="shop-the-look"
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  style="
    --bg: {{ s.background_color }};
    --heading: {{ s.heading_color }};
    --text: {{ s.text_color }};
    --accent: {{ s.accent_color }};
    --border: {{ s.border_color }};
    --button-bg: {{ s.button_bg }};
    --button-text: {{ s.button_text }};
    --max-width: {{ s.max_width }}px;
    --stage-height: {{ s.stage_height }}px;
    --padding-top: {{ s.padding_top }}px;
    --padding-bottom: {{ s.padding_bottom }}px;
    --heading-size: {{ s.heading_size }}px;
    --badge-size: {{ s.badge_size }}px;
    --badge-background: {{ s.badge_background }};
    --badge-color: {{ s.badge_color }};
  "
>

  <div class="sl-container">

    {% if s.chapter_number != blank or s.chapter_label != blank %}
      <div class="sl-chapter" aria-hidden="true">
        {% if s.chapter_number != blank %}
          <span class="sl-chapter-number">{{ s.chapter_number | escape }}</span>
        {% endif %}
        <span class="sl-chapter-line"></span>
        {% if s.chapter_label != blank %}
          <span class="sl-chapter-label">{{ s.chapter_label | escape }}</span>
        {% endif %}
      </div>
    {% endif %}


    {% for block in looks %}

      {%- liquid
        assign primary_img = block.settings.primary_image
        if primary_img == blank and block.settings.product != blank
          assign primary_img = block.settings.product.featured_image
        endif

        assign secondary_img = block.settings.secondary_image
        if secondary_img == blank and block.settings.product != blank and block.settings.product.images.size > 1
          assign secondary_img = block.settings.product.images[1]
        endif

        assign look_heading = block.settings.heading
        if look_heading == blank and block.settings.product != blank
          assign look_heading = block.settings.product.title
        endif

        assign look_caption = block.settings.caption
        if look_caption == blank and block.settings.product != blank
          assign look_caption = block.settings.product.description | strip_html | truncatewords: 28
        endif
      -%}

      <div
        class="sl-slide {% if forloop.first %}is-active{% endif %}"
        data-slide="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >

        <div class="sl-layout">


          <!-- LEFT IMAGE -->

          <div class="sl-image-area">

            <div class="sl-primary-image">

              {% if primary_img != blank %}

                {{
                  primary_img
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 55vw, 100vw'
                }}

              {% else %}

                <div class="sl-primary-placeholder"></div>

              {% endif %}

            </div>

          </div>


          <!-- RIGHT CONTENT -->

          <div class="sl-content-area">

            {% if block.settings.eyebrow != blank %}
              <p class="sl-eyebrow">
                {{ block.settings.eyebrow }}
              </p>
            {% endif %}


            {% if look_heading != blank %}
              <h2 class="sl-heading">
                {{ look_heading }}
              </h2>
            {% endif %}


            {% if block.settings.product != blank %}
              <div class="sl-price">
                {% if block.settings.product.price_varies %}
                  {{ 'products.product.from_price_html' | t }}
                  {{ block.settings.product.price_min | money }}
                {% else %}
                  {{ block.settings.product.price | money }}
                {% endif %}
              </div>
            {% endif %}


            {% if look_caption != blank %}
              <div class="sl-caption">
                {{ look_caption }}
              </div>
            {% endif %}


            {% if block.settings.button_text != blank %}

              {% if block.settings.product != blank %}

                {% assign look_variant = block.settings.product.selected_or_first_available_variant %}

                <button
                  type="button"
                  class="sl-button sl-add-look"
                  {% if look_variant.available %}
                    data-variant-id="{{ look_variant.id }}"
                    data-text-idle="{{ block.settings.button_text | escape }}"
                    data-text-adding="{{ 'sections.shop_the_look.adding' | t }}"
                    data-text-added="{{ 'sections.shop_the_look.added' | t }}"
                    data-text-error="{{ 'sections.shop_the_look.error' | t }}"
                  {% else %}
                    disabled
                    aria-disabled="true"
                  {% endif %}
                >
                  <span class="sl-button-label">
                    {% if look_variant.available %}
                      {{ block.settings.button_text }}
                    {% else %}
                      {{ 'sections.shop_the_look.sold_out' | t }}
                    {% endif %}
                  </span>

                  <span class="sl-button-arrow" aria-hidden="true">
                    ↗
                  </span>
                </button>

              {% else %}

                <a
                  href="{{ block.settings.button_link | default: '#' }}"
                  class="sl-button"
                >
                  {{ block.settings.button_text }}

                  <span class="sl-button-arrow">
                    ↗
                  </span>
                </a>

              {% endif %}

            {% endif %}


            {% if looks.size > 1 %}

              <div class="sl-navigation">

                <button
                  class="sl-arrow sl-prev"
                  type="button"
                  aria-label="{{ 'sections.shop_the_look.previous' | t }}"
                >
                  ‹
                </button>

                <button
                  class="sl-arrow sl-next"
                  type="button"
                  aria-label="{{ 'sections.shop_the_look.next' | t }}"
                >
                  ›
                </button>

              </div>

            {% endif %}

          </div>


          <!-- OVERLAPPING IMAGE -->

          {% if secondary_img != blank %}

            <div class="sl-secondary-image">

              {{
                secondary_img
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy'
              }}

              {% if block.settings.secondary_link != blank %}

                <a
                  href="{{ block.settings.secondary_link }}"
                  class="sl-plus"
                  aria-label="{{ 'sections.shop_the_look.view' | t }}"
                >
                  +
                </a>

              {% endif %}

            </div>

          {% endif %}


          <!-- ROUND BADGE -->

          {% if s.show_badge %}

            <div class="sl-badge">

              <div class="sl-badge-circle">

                <div class="sl-badge-text">

                  <span style="--i:0;">S</span>
                  <span style="--i:1;">H</span>
                  <span style="--i:2;">O</span>
                  <span style="--i:3;">P</span>
                  <span style="--i:4;">T</span>
                  <span style="--i:5;">H</span>
                  <span style="--i:6;">E</span>
                  <span style="--i:7;">L</span>
                  <span style="--i:8;">O</span>
                  <span style="--i:9;">O</span>
                  <span style="--i:10;">K</span>
                  <span style="--i:11;">•</span>

                </div>

                <span class="sl-badge-arrow">
                  ↗
                </span>

              </div>

            </div>

          {% endif %}

        </div>

      </div>

    {% endfor %}


    <!-- DOTS -->

    {% if looks.size > 1 %}

      <div class="sl-dots">

        {% for block in looks %}

          <button
            type="button"
            class="sl-dot {% if forloop.first %}is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            aria-label="{{ 'sections.shop_the_look.slide' | t: index: forloop.index }}"
          ></button>

        {% endfor %}

      </div>

    {% endif %}


    <!-- FEATURES -->

    {% if s.show_features %}

      <div class="sl-features">

        <div class="sl-feature">

          <div class="sl-feature-icon">
            ♢
          </div>

          <div>

            <h3 class="sl-feature-title">
              {{ s.feature_1_title }}
            </h3>

            <p class="sl-feature-text">
              {{ s.feature_1_text }}
            </p>

          </div>

        </div>


        <div class="sl-feature">

          <div class="sl-feature-icon">
            ♧
          </div>

          <div>

            <h3 class="sl-feature-title">
              {{ s.feature_2_title }}
            </h3>

            <p class="sl-feature-text">
              {{ s.feature_2_text }}
            </p>

          </div>

        </div>


        <div class="sl-feature">

          <div class="sl-feature-icon">
            □
          </div>

          <div>

            <h3 class="sl-feature-title">
              {{ s.feature_3_title }}
            </h3>

            <p class="sl-feature-text">
              {{ s.feature_3_text }}
            </p>

          </div>

        </div>

      </div>

    {% endif %}

  </div>

</section>


{% schema %}
{
  "name": "t:sections.shop_the_look.name",
  "tag": "section",
  "class": "section-shop-look-premium",

  "settings": [

    {
      "type": "header",
      "content": "t:sections.shop_the_look.settings.header__layout.content"
    },

    {
      "type": "range",
      "id": "max_width",
      "label": "t:sections.shop_the_look.settings.max_width.label",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1600
    },

    {
      "type": "range",
      "id": "stage_height",
      "label": "t:sections.shop_the_look.settings.stage_height.label",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 720
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.shop_the_look.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.shop_the_look.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },


    {
      "type": "header",
      "content": "t:sections.shop_the_look.settings.header__top_label.content"
    },

    {
      "type": "text",
      "id": "chapter_number",
      "label": "Chapter number",
      "default": "07"
    },

    {
      "type": "text",
      "id": "chapter_label",
      "label": "Chapter label",
      "default": "Looks / Moments"
    },


    {
      "type": "header",
      "content": "t:sections.shop_the_look.settings.header__typography.content"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "t:sections.shop_the_look.settings.heading_size.label",
      "min": 36,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 72
    },


    {
      "type": "header",
      "content": "t:sections.shop_the_look.settings.header__colors.content"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.shop_the_look.settings.background_color.label",
      "default": "#F7F6F2"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "t:sections.shop_the_look.settings.heading_color.label",
      "default": "#222522"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.shop_the_look.settings.text_color.label",
      "default": "#686B66"
    },

    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.shop_the_look.settings.accent_color.label",
      "default": "#53604E"
    },

    {
      "type": "color",
      "id": "border_color",
      "label": "t:sections.shop_the_look.settings.border_color.label",
      "default": "#D8D7D0"
    },


    {
      "type": "header",
      "content": "t:sections.shop_the_look.settings.header__button.content"
    },

    {
      "type": "color",
      "id": "button_bg",
      "label": "t:sections.shop_the_look.settings.button_bg.label",
      "default": "#273026"
    },

    {
      "type": "color",
      "id": "button_text",
      "label": "t:sections.shop_the_look.settings.button_text.label",
      "default": "#FFFFFF"
    },


    {
      "type": "header",
      "content": "t:sections.shop_the_look.settings.header__badge.content"
    },

    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "t:sections.shop_the_look.settings.show_badge.label",
      "default": true
    },

    {
      "type": "range",
      "id": "badge_size",
      "label": "t:sections.shop_the_look.settings.badge_size.label",
      "min": 64,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 104
    },

    {
      "type": "color",
      "id": "badge_background",
      "label": "t:sections.shop_the_look.settings.badge_background.label",
      "default": "#171A17"
    },

    {
      "type": "color",
      "id": "badge_color",
      "label": "t:sections.shop_the_look.settings.badge_color.label",
      "default": "#FFFFFF"
    },


    {
      "type": "header",
      "content": "t:sections.shop_the_look.settings.header__features.content"
    },

    {
      "type": "checkbox",
      "id": "show_features",
      "label": "t:sections.shop_the_look.settings.show_features.label",
      "default": true
    },

    {
      "type": "text",
      "id": "feature_1_title",
      "label": "t:sections.shop_the_look.settings.feature_1_title.label",
      "default": "Trusted Quality"
    },

    {
      "type": "text",
      "id": "feature_1_text",
      "label": "t:sections.shop_the_look.settings.feature_1_text.label",
      "default": "Carefully selected for happy, healthy pets"
    },

    {
      "type": "text",
      "id": "feature_2_title",
      "label": "t:sections.shop_the_look.settings.feature_2_title.label",
      "default": "Natural Ingredients"
    },

    {
      "type": "text",
      "id": "feature_2_text",
      "label": "t:sections.shop_the_look.settings.feature_2_text.label",
      "default": "Made with love and premium ingredients"
    },

    {
      "type": "text",
      "id": "feature_3_title",
      "label": "t:sections.shop_the_look.settings.feature_3_title.label",
      "default": "Fast Delivery"
    },

    {
      "type": "text",
      "id": "feature_3_text",
      "label": "t:sections.shop_the_look.settings.feature_3_text.label",
      "default": "Quick and reliable delivery to your door"
    }

  ],


  "blocks": [

    {
      "type": "look",
      "name": "t:sections.shop_the_look.blocks.look.name",

      "settings": [

        {
          "type": "product",
          "id": "product",
          "label": "t:sections.shop_the_look.blocks.look.settings.product.label",
          "info": "t:sections.shop_the_look.blocks.look.settings.product.info"
        },

        {
          "type": "image_picker",
          "id": "primary_image",
          "label": "t:sections.shop_the_look.blocks.look.settings.primary_image.label",
          "info": "t:sections.shop_the_look.blocks.look.settings.primary_image.info"
        },

        {
          "type": "image_picker",
          "id": "secondary_image",
          "label": "t:sections.shop_the_look.blocks.look.settings.secondary_image.label",
          "info": "t:sections.shop_the_look.blocks.look.settings.secondary_image.info"
        },

        {
          "type": "url",
          "id": "secondary_link",
          "label": "t:sections.shop_the_look.blocks.look.settings.secondary_link.label"
        },

        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.shop_the_look.blocks.look.settings.eyebrow.label"
        },

        {
          "type": "textarea",
          "id": "heading",
          "label": "t:sections.shop_the_look.blocks.look.settings.heading.label",
          "info": "t:sections.shop_the_look.blocks.look.settings.heading.info"
        },

        {
          "type": "textarea",
          "id": "caption",
          "label": "t:sections.shop_the_look.blocks.look.settings.caption.label",
          "info": "t:sections.shop_the_look.blocks.look.settings.caption.info"
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "t:sections.shop_the_look.blocks.look.settings.button_text.label",
          "default": "Add Look To Cart"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.shop_the_look.blocks.look.settings.button_link.label"
        }

      ]
    }

  ],


  "max_blocks": 5,


  "presets": [
    {
      "name": "t:sections.shop_the_look.presets.name",
      "blocks": [
        {
          "type": "look",
          "settings": {
            "eyebrow": "Looks · Moments",
            "heading": "See Life With Them",
            "caption": "Cozy nights and quiet naps. Add a product above to pull in its own title, description and price automatically."
          }
        },
        {
          "type": "look",
          "settings": {
            "eyebrow": "Everyday · Adventures",
            "heading": "Built For Busy Days",
            "caption": "Built for busy little paws. Add a product above to pull in its own title, description and price automatically."
          }
        }
      ]
    }
  ]

}
{% endschema %}
