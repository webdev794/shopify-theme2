{% comment %}
  Detailed Contact Form Section
{% endcomment %}

{{ 'detailed-contact-form.css' | asset_url | stylesheet_tag }}

{% style %}
  /* Prevents the footer from overlapping this section on short pages.
     Scoped to this instance via Shopify's guaranteed section wrapper ID,
     so it works for every copy of this section on every store. */
  #shopify-section-{{ section.id }} {
    min-height: 60vh;
    padding-bottom: 4rem;
  }
{% endstyle %}

{% liquid
  assign section_heading = section.settings.heading | default: "Get in Touch"
  assign section_subheading = section.settings.subheading | default: "We'd love to hear from you. Please fill out the form below."
  assign section_background = section.settings.background_color
  assign text_color = section.settings.text_color
  assign button_text = section.settings.button_text | default: "Send Message"
  assign form_id = "contact_form_" | append: section.id
%}

<div 
  class="detailed-contact-form section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="detailed-contact-form"
  style="
    --section-bg: {{ section_background }};
    --text-color: {{ text_color }};
  "
>
  <div class="page-width">
    <div class="detailed-contact-form__wrapper">
      {% if section_heading != blank or section_subheading != blank %}
        <div class="detailed-contact-form__header text-center">
          {% if section_heading != blank %}
            <h1 class="detailed-contact-form__heading">{{ section_heading | escape }}</h1>
          {% endif %}
          {% if section_subheading != blank %}
            <p class="detailed-contact-form__subheading">{{ section_subheading | escape }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="detailed-contact-form__grid">
        <div class="detailed-contact-form__form-wrapper">
          {% form "contact", id: form_id, class: "detailed-contact-form__form" %}
            {% if form.posted_successfully? %}
              <div class="form-status form-status--success" role="status">
                <p style="font-weight: 600; font-size: 1.05rem;">✓ {{ 'contact.form.success_heading' | t }}</p>
                <p style="margin: 0; opacity: 0.9;">{{ 'contact.form.success' | t }}</p>
                {% if form.contact.subscribe_to_newsletter == 'yes' %}
                  <p style="margin-top: 0.75rem; font-size: 0.9rem; opacity: 0.9;">
                    ✓ {{ 'contact.form.newsletter_subscribed' | t }}
                  </p>
                {% endif %}
              </div>
            {% endif %}

            {% if form.errors %}
              <div class="form-status form-status--error" role="alert">
                <p style="font-weight: 600; font-size: 1.05rem;">⚠️ {{ 'contact.form.error_heading' | t }}</p>
                <ul>
                  {% for field in form.errors %}
                    <li>
                      {% if field == "form" %}
                        {{ form.errors.messages[field] }}
                      {% else %}
                        <a href="#{{ form_id }}-{{ field }}">
                          {{ form.errors.translated_fields[field] | capitalize }}
                          {{ form.errors.messages[field] }}
                        </a>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <div class="detailed-contact-form__fields">
              <!-- Name - Full Width -->
              <div class="field-group field-group--full">
                <label class="field__label" for="{{ form_id }}-name">
                  {{ 'contact.form.name' | t }}
                  <span class="field__required" aria-hidden="true">*</span>
                </label>
                <input
                  id="{{ form_id }}-name"
                  class="field__input"
                  type="text"
                  name="contact[name]"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  placeholder="{{ 'contact.form.name' | t }}"
                  required
                  autocomplete="name"
                >
              </div>

              <!-- Email - Full Width -->
              <div class="field-group field-group--full">
                <label class="field__label" for="{{ form_id }}-email">
                  {{ 'contact.form.email' | t }}
                  <span class="field__required" aria-hidden="true">*</span>
                </label>
                <input
                  id="{{ form_id }}-email"
                  class="field__input"
                  type="email"
                  name="contact[email]"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  placeholder="{{ 'contact.form.email' | t }}"
                  required
                  autocomplete="email"
                  pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                >
              </div>

              <!-- Phone + Order Number - Half Width -->
              <div class="field-group field-group--half">
                <label class="field__label" for="{{ form_id }}-phone">
                  {{ 'contact.form.phone' | t }}
                </label>
                <input
                  id="{{ form_id }}-phone"
                  class="field__input"
                  type="tel"
                  name="contact[phone]"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  placeholder="{{ 'contact.form.phone' | t }}"
                  autocomplete="tel"
                >
              </div>

              <div class="field-group field-group--half">
                <label class="field__label" for="{{ form_id }}-order-number">
                  {{ 'contact.form.order_number' | t }}
                </label>
                <input
                  id="{{ form_id }}-order-number"
                  class="field__input"
                  type="text"
                  name="contact[order_number]"
                  value="{% if form.order_number %}{{ form.order_number }}{% endif %}"
                  placeholder="{{ 'contact.form.order_number' | t }}"
                >
              </div>

              <!-- Subject + Priority - Half Width -->
              <div class="field-group field-group--half">
                <label class="field__label" for="{{ form_id }}-subject">
                  {{ 'contact.form.subject' | t }}
                  <span class="field__required" aria-hidden="true">*</span>
                </label>
                <select
                  id="{{ form_id }}-subject"
                  class="field__input field__select"
                  name="contact[subject]"
                  required
                >
                  <option value="" disabled selected>
                    {{ 'contact.form.subject_placeholder' | t }}
                  </option>
                  <option value="general-inquiry">
                    {{ 'contact.form.general_inquiry' | t }}
                  </option>
                  <option value="product-question">
                    {{ 'contact.form.product_question' | t }}
                  </option>
                  <option value="order-status">
                    {{ 'contact.form.order_status' | t }}
                  </option>
                  <option value="returns">
                    {{ 'contact.form.returns' | t }}
                  </option>
                  <option value="wholesale">
                    {{ 'contact.form.wholesale' | t }}
                  </option>
                  <option value="other">
                    {{ 'contact.form.other' | t }}
                  </option>
                </select>
              </div>

              <div class="field-group field-group--half">
                <label class="field__label" for="{{ form_id }}-priority">
                  {{ 'contact.form.priority' | t }}
                </label>
                <select
                  id="{{ form_id }}-priority"
                  class="field__input field__select"
                  name="contact[priority]"
                >
                  <option value="low">{{ 'contact.form.priority_low' | t }}</option>
                  <option value="medium" selected>{{ 'contact.form.priority_medium' | t }}</option>
                  <option value="high">{{ 'contact.form.priority_high' | t }}</option>
                  <option value="urgent">{{ 'contact.form.priority_urgent' | t }}</option>
                </select>
              </div>

              <!-- Country - Full Width (Manual Entry) -->
              <div class="field-group field-group--full">
                <label class="field__label" for="{{ form_id }}-country">
                  {{ 'contact.form.country' | t }}
                  <span style="font-weight: 400; opacity: 0.6; font-size: 0.8rem;">({{ 'contact.form.optional' | t }})</span>
                </label>
                <input
                  id="{{ form_id }}-country"
                  class="field__input"
                  type="text"
                  name="contact[country]"
                  value="{% if form.country %}{{ form.country }}{% endif %}"
                  placeholder="{{ 'contact.form.country_placeholder' | t }}"
                  autocomplete="country"
                >
                <!-- HIDDEN FIELD TO OVERRIDE AUTO-DETECTED COUNTRY CODE -->
                <!-- This prevents Shopify from adding Country Code: CA to emails -->
                <input type="hidden" name="contact[country_code]" value="">
              </div>

              <!-- Message - Full Width -->
              <div class="field-group field-group--full">
                <label class="field__label" for="{{ form_id }}-message">
                  {{ 'contact.form.message' | t }}
                  <span class="field__required" aria-hidden="true">*</span>
                </label>
                <textarea
                  id="{{ form_id }}-message"
                  class="field__input field__textarea"
                  name="contact[body]"
                  rows="6"
                  placeholder="{{ 'contact.form.message_placeholder' | t }}"
                  required
                >{% if form.body %}{{ form.body }}{% endif %}</textarea>
                <small class="field__character-count">
                  <span id="char-count-{{ form_id }}">0</span> / 1000
                </small>
              </div>

              <!-- Newsletter Subscription - Full Width -->
              <div class="field-group field-group--full">
                <div class="field__checkbox-wrapper">
                  <input
                    id="{{ form_id }}-subscribe"
                    class="field__checkbox"
                    type="checkbox"
                    name="contact[subscribe_to_newsletter]"
                    value="yes"
                    {% if form.subscribe_to_newsletter %}checked{% endif %}
                  >
                  <label for="{{ form_id }}-subscribe" class="field__checkbox-label">
                    {{ 'contact.form.subscribe_to_newsletter' | t }}
                    <span style="font-weight: 400; opacity: 0.6; font-size: 0.8rem; display: block; margin-top: 0.25rem;">
                      {{ 'contact.form.newsletter_note' | t }}
                    </span>
                  </label>
                </div>
              </div>

              <!-- Submit Button - Full Width -->
              <div class="field-group field-group--full">
                <button
                  type="submit"
                  class="button button--primary detailed-contact-form__submit"
                  aria-label="{{ button_text }}"
                >
                  <span class="button__text">{{ button_text }}</span>
                  <span class="button__spinner hidden" aria-hidden="true"></span>
                </button>
              </div>
            </div>
          {% endform %}
        </div>

        {% if section.settings.show_contact_info %}
          <div class="detailed-contact-form__info">
            <div class="detailed-contact-form__info-content">
              {% if section.settings.info_heading != blank %}
                <h3 class="detailed-contact-form__info-heading">
                  {{ section.settings.info_heading | escape }}
                </h3>
              {% endif %}

              {% if section.settings.info_text != blank %}
                <div class="detailed-contact-form__info-text rte">
                  {{ section.settings.info_text }}
                </div>
              {% endif %}

              <ul class="detailed-contact-form__info-list">
                {% if section.settings.phone != blank %}
                  <li class="detailed-contact-form__info-item">
                    <svg class="icon icon-phone" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M22 16.92V19.92C22.0011 20.1985 21.9441 20.4742 21.8325 20.7293C21.7209 20.9845 21.5573 21.2136 21.352 21.4019C21.1467 21.5901 20.904 21.7335 20.6397 21.8227C20.3754 21.9119 20.0951 21.945 19.816 21.92C16.7426 21.5856 13.7868 20.5341 11.172 18.85C8.75077 17.3144 6.69042 15.2541 5.1548 12.8328C3.47003 10.218 2.41848 7.26218 2.084 4.1888C2.05891 3.90976 2.09195 3.62949 2.18117 3.36527C2.2704 3.10104 2.41373 2.85838 2.60191 2.6531C2.7901 2.44782 3.01917 2.28422 3.27431 2.17259C3.52946 2.06097 3.80513 2.00394 4.0836 2.005H7.0836C7.54536 2.00106 7.99025 2.16818 8.33034 2.46933C8.67043 2.77048 8.87608 3.18046 8.9 3.62C8.97184 4.65856 9.16752 5.68353 9.482 6.67C9.59444 7.00642 9.60344 7.3703 9.50783 7.71207C9.41222 8.05384 9.21666 8.3539 8.95 8.57L7.75 9.52C9.29325 12.4554 11.5454 14.7067 14.481 16.249L15.431 15.049C15.6474 14.7825 15.9474 14.5872 16.289 14.4918C16.6307 14.3964 16.9944 14.4055 17.3306 14.518C18.3173 14.8321 19.3423 15.0277 20.381 15.099C20.8204 15.123 21.2302 15.3286 21.5314 15.6686C21.8326 16.0085 22 16.4532 22 16.92Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <a href="tel:{{ section.settings.phone | handleize }}" class="detailed-contact-form__info-link">
                      {{ section.settings.phone }}
                    </a>
                  </li>
                {% endif %}

                {% if section.settings.email != blank %}
                  <li class="detailed-contact-form__info-item">
                    <svg class="icon icon-email" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M22 5C22 4.46957 21.7893 3.96086 21.4142 3.58579C21.0391 3.21071 20.5304 3 20 3H4C3.46957 3 2.96086 3.21071 2.58579 3.58579C2.21071 3.96086 2 4.46957 2 5M22 5V19C22 19.5304 21.7893 20.0391 21.4142 20.4142C21.0391 20.7893 20.5304 21 20 21H4C3.46957 21 2.96086 20.7893 2.58579 20.4142C2.21071 20.0391 2 19.5304 2 19V5M22 5L12 13L2 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <a href="mailto:{{ section.settings.email }}" class="detailed-contact-form__info-link">
                      {{ section.settings.email }}
                    </a>
                  </li>
                {% endif %}

                {% if section.settings.address != blank %}
                  <li class="detailed-contact-form__info-item">
                    <svg class="icon icon-address" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61305 3.94821 5.32387 5.63604 3.63604C7.32387 1.94821 9.61305 1 12 1C14.3869 1 16.6761 1.94821 18.364 3.63604C20.0518 5.32387 21 7.61305 21 10Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="detailed-contact-form__info-text">
                      {{ section.settings.address }}
                    </span>
                  </li>
                {% endif %}

                {% if section.settings.hours != blank %}
                  <li class="detailed-contact-form__info-item">
                    <svg class="icon icon-hours" aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                      <path d="M12 6V12L16 14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="detailed-contact-form__info-text">
                      {{ section.settings.hours }}
                    </span>
                  </li>
                {% endif %}
              </ul>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.detailed_contact_form.name",
  "tag": "section",
  "class": "section detailed-contact-form-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "t:sections.detailed_contact_form.settings.header__1.content" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.detailed_contact_form.settings.heading.label",
      "default": "Get in Touch"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.detailed_contact_form.settings.subheading.label",
      "default": "We'd love to hear from you. Please fill out the form below."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.detailed_contact_form.settings.button_text.label",
      "default": "Send Message"
    },
    { "type": "header", "content": "t:sections.detailed_contact_form.settings.header__2.content" },
    {
      "type": "checkbox",
      "id": "show_contact_info",
      "label": "t:sections.detailed_contact_form.settings.show_contact_info.label",
      "default": true
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "t:sections.detailed_contact_form.settings.info_heading.label",
      "default": "Contact Information"
    },
    {
      "type": "richtext",
      "id": "info_text",
      "label": "t:sections.detailed_contact_form.settings.info_text.label",
      "default": "<p>Reach out to us through any of these channels</p>"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.detailed_contact_form.settings.phone.label",
      "default": "+1 (555) 123-4567"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.detailed_contact_form.settings.email.label",
      "default": "contact@example.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "t:sections.detailed_contact_form.settings.address.label",
      "default": "123 Main Street, City, State 12345"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "t:sections.detailed_contact_form.settings.hours.label",
      "default": "Mon-Fri 9:00 AM - 6:00 PM"
    },
    { "type": "header", "content": "t:sections.detailed_contact_form.settings.header__3.content" },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.detailed_contact_form.settings.background_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.detailed_contact_form.settings.text_color.label",
      "default": "#333333"
    }
  ],
  "presets": [
    {
      "name": "t:sections.detailed_contact_form.presets.name",
      "category": "Contact"
    }
  ]
}
{% endschema %}
