<div class="contact-page page-width">
  <div class="contact-page__header">
    {% if section.settings.heading != blank %}
      <h1 class="contact-page__title">{{ section.settings.heading }}</h1>
    {% else %}
      <h1 class="contact-page__title">{{ page.title }}</h1>
    {% endif %}

    {% if section.settings.intro != blank %}
      <div class="contact-page__intro rte">
        {{ section.settings.intro }}
      </div>
    {% endif %}
  </div>

  {% form 'contact', id: 'ContactForm', class: 'contact-form' %}
    {% if form.posted_successfully? %}
      <div class="contact-form__message contact-form__message--success" tabindex="-1" autofocus>
        {{ 'templates.contact.form.post_success' | t | default: 'Thanks for contacting us. We will get back to you as soon as possible.' }}
      </div>
    {% endif %}

    {{ form.errors | default_errors }}

    <div class="contact-form__field">
      <label for="ContactForm-name">
        {{ 'templates.contact.form.name' | t | default: 'Name' }}
      </label>
      <input
        type="text"
        id="ContactForm-name"
        name="contact[name]"
        value="{{ form.name }}"
        autocomplete="name"
        required
      >
    </div>

    <div class="contact-form__field">
      <label for="ContactForm-email">
        {{ 'templates.contact.form.email' | t | default: 'Email' }}
      </label>
      <input
        type="email"
        id="ContactForm-email"
        name="contact[email]"
        value="{{ form.email }}"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        required
      >
    </div>

    <div class="contact-form__field">
      <label for="ContactForm-phone">
        {{ 'templates.contact.form.phone' | t | default: 'Phone' }}
      </label>
      <input
        type="tel"
        id="ContactForm-phone"
        name="contact[phone]"
        value="{{ form.phone }}"
        autocomplete="tel"
      >
    </div>

    <div class="contact-form__field">
      <label for="ContactForm-message">
        {{ 'templates.contact.form.comment' | t | default: 'Message' }}
      </label>
      <textarea
        rows="8"
        id="ContactForm-message"
        name="contact[body]"
        required
      >{{ form.body }}</textarea>
    </div>

    <button type="submit" class="button button--primary contact-form__submit">
      {{ 'templates.contact.form.send' | t | default: 'Send message' }}
    </button>
  {% endform %}
</div>

{% stylesheet %}
  .contact-page {
    max-width: 900px;
    margin-inline: auto;
    padding-block: 3rem 5rem;
  }

  .contact-page__header {
    max-width: 680px;
    margin-inline: auto;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .contact-page__title {
    margin: 0 0 1rem;
  }

  .contact-page__intro {
    color: var(--color-foreground-secondary, #777);
  }

  .contact-form {
    max-width: 680px;
    margin-inline: auto;
  }

  .contact-form__field {
    margin-bottom: 1.25rem;
  }

  .contact-form__field label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem;
    border: 1px solid var(--color-border, #ccc);
    border-radius: 0.4rem;
    background: var(--color-background, #fff);
    color: var(--color-foreground, #1a1a1a);
    font: inherit;
  }

  .contact-form__field textarea {
    resize: vertical;
    min-height: 160px;
  }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: 2px solid currentColor;
    outline-offset: 1px;
  }

  .contact-form__message {
    margin-bottom: 1.25rem;
    padding: 1rem;
    border-radius: 0.4rem;
  }

  .contact-form__message--success {
    border: 1px solid #2f7d32;
    background: #f1f8f1;
  }

  .contact-form__submit {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact us"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Have a question? Send us a message and we'll get back to you as soon as possible."
    }
  ]
}
{% endschema %}
