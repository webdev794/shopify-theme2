{{ 'section-burst-effects.css' | asset_url | stylesheet_tag }}

<script src="{{ 'burst-effects.js' | asset_url }}" defer></script>

<div 
  class="burst-effects" 
  data-section-id="{{ section.id }}" 
  data-animation="{{ section.settings.animation_effect }}"
  data-duration="{{ section.settings.animation_duration }}"
  data-delay="{{ section.settings.animation_delay }}"
>
  <div class="burst-effects__container">
    <div class="burst-effects__media">
      {% if section.settings.image %}
        <div class="burst-effects__image-wrapper">
          {{
            section.settings.image
            | image_url: width: 1920
            | image_tag:
              widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000',
              sizes: '100vw',
              class: 'burst-effects__image',
              alt: section.settings.image.alt | default: section.settings.title
          }}
        </div>
      {% endif %}
    </div>
    <div class="burst-effects__content" style="--burst-heading-color: {{ section.settings.heading_color | default: '#ffffff' }}; --burst-text-color: {{ section.settings.text_color | default: '#ffffff' }};">
      <h2 class="burst-effects__title">{{ section.settings.title }}</h2>
      <div class="burst-effects__text">{{ section.settings.text }}</div>
      
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="burst-btn burst-btn--{{ section.settings.button_style }}">
          <span class="burst-btn__text">{{ section.settings.button_label }}</span>
          
          {% if section.settings.show_icon %}
            <svg class="burst-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          {% endif %}
          
          {% if section.settings.button_style == 'glow' %}
            <span class="burst-btn__glow"></span>
          {% endif %}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.burst_effects.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "t:sections.burst_effects.settings.header__1.content" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.burst_effects.settings.image.label",
      "info": "t:sections.burst_effects.settings.image.info"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.burst_effects.settings.title.label",
      "default": "Elevate Your Brand"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.burst_effects.settings.text.label",
      "default": "<p>Combine stunning visuals with powerful animation to create a store that captivates and converts.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.burst_effects.settings.button_label.label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.burst_effects.settings.button_link.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#ffffff"
    },
    { "type": "header", "content": "t:sections.burst_effects.settings.header__2.content" },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.burst_effects.settings.button_style.label",
      "options": [
        { "value": "gradient", "label": "t:sections.burst_effects.settings.button_style.options__1.label" },
        { "value": "outline", "label": "t:sections.burst_effects.settings.button_style.options__2.label" },
        { "value": "glow", "label": "t:sections.burst_effects.settings.button_style.options__3.label" },
        { "value": "slide", "label": "t:sections.burst_effects.settings.button_style.options__4.label" },
        { "value": "pulse", "label": "t:sections.burst_effects.settings.button_style.options__5.label" }
      ],
      "default": "gradient"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "t:sections.burst_effects.settings.show_icon.label",
      "default": true
    },
    { "type": "header", "content": "t:sections.burst_effects.settings.header__3.content" },
    {
      "type": "select",
      "id": "animation_effect",
      "label": "t:sections.burst_effects.settings.animation_effect.label",
      "options": [
        { "value": "fade-in", "label": "t:sections.burst_effects.settings.animation_effect.options__1.label" },
        { "value": "slide-up", "label": "t:sections.burst_effects.settings.animation_effect.options__2.label" },
        { "value": "scale-up", "label": "t:sections.burst_effects.settings.animation_effect.options__3.label" },
        { "value": "parallax", "label": "t:sections.burst_effects.settings.animation_effect.options__4.label" }
      ],
      "default": "fade-in"
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "unit": "s",
      "label": "t:sections.burst_effects.settings.animation_duration.label",
      "default": 1.0
    },
    {
      "type": "range",
      "id": "animation_delay",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "unit": "s",
      "label": "t:sections.burst_effects.settings.animation_delay.label",
      "default": 0.2
    }
  ],
  "presets": [
    { "name": "t:sections.burst_effects.presets.name" }
  ]
}
{% endschema %}
