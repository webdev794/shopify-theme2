{{ 'lookbook-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lookbook-gallery.js' | asset_url }}" defer></script>
<div class="lookbook-gallery" data-section-type="lookbook-gallery" data-section-id="{{ section.id }}"
  style="--lg-bg: {{ section.settings.background_color }}; --lg-text: {{ section.settings.text_color }}; --lg-dot: {{ section.settings.dot_color }};">
  <div class="lookbook-gallery__container{% if section.settings.full_width %} lookbook-gallery__container--full{% endif %}">
    {% if section.settings.heading != blank %}<div class="lookbook-gallery__header">
      {% if section.settings.subheading != blank %}<p class="lookbook-gallery__subheading">{{ section.settings.subheading | escape }}</p>{% endif %}
      <h2 class="lookbook-gallery__heading">{{ section.settings.heading | escape }}</h2>
    </div>{% endif %}
    <div class="lookbook-gallery__viewport" data-lg-viewport>
      <div class="lookbook-gallery__track" data-lg-track>
        {% for block in section.blocks %}
          <div class="lookbook-gallery__slide{% if forloop.first %} is-active{% endif %}" data-lg-slide data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="lookbook-gallery__image-wrap">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'lookbook-gallery__image', loading: 'lazy', widths: '750, 1100, 1500, 2000', sizes: '100vw' }}
              {% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook-gallery__placeholder' }}{% endif %}
              {% if block.settings.product_1 != blank %}
                <button type="button" class="lookbook-gallery__hotspot" style="left: {{ block.settings.x1 }}%; top: {{ block.settings.y1 }}%;" data-lg-hotspot data-product-handle="{{ block.settings.product_1.handle }}" aria-label="{{ block.settings.product_1.title | escape }}"><span class="lookbook-gallery__hotspot-dot"></span></button>
              {% endif %}
              {% if block.settings.product_2 != blank %}
                <button type="button" class="lookbook-gallery__hotspot" style="left: {{ block.settings.x2 }}%; top: {{ block.settings.y2 }}%;" data-lg-hotspot data-product-handle="{{ block.settings.product_2.handle }}" aria-label="{{ block.settings.product_2.title | escape }}"><span class="lookbook-gallery__hotspot-dot"></span></button>
              {% endif %}
              {% if block.settings.product_3 != blank %}
                <button type="button" class="lookbook-gallery__hotspot" style="left: {{ block.settings.x3 }}%; top: {{ block.settings.y3 }}%;" data-lg-hotspot data-product-handle="{{ block.settings.product_3.handle }}" aria-label="{{ block.settings.product_3.title | escape }}"><span class="lookbook-gallery__hotspot-dot"></span></button>
              {% endif %}
            </div>
            {% if block.settings.caption != blank %}<p class="lookbook-gallery__caption">{{ block.settings.caption | escape }}</p>{% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
    {% if section.blocks.size > 1 %}
      <div class="lookbook-gallery__nav">
        <button type="button" class="lookbook-gallery__nav-btn" data-lg-prev aria-label="Previous">‹</button>
        <div class="lookbook-gallery__dots" data-lg-dots role="tablist">
          {% for block in section.blocks %}
            <button type="button" class="lookbook-gallery__dot{% if forloop.first %} is-active{% endif %}" data-lg-dot data-index="{{ forloop.index0 }}" aria-label="Look {{ forloop.index }}" role="tab"></button>
          {% endfor %}
        </div>
        <button type="button" class="lookbook-gallery__nav-btn" data-lg-next aria-label="Next">›</button>
      </div>
    {% endif %}
    <div class="lookbook-gallery__product-card" data-lg-card hidden>
      <button type="button" class="lookbook-gallery__card-close" data-lg-card-close aria-label="Close">&times;</button>
      <div data-lg-card-content></div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.lookbook_gallery.name",
  "tag": "section",
  "class": "section-lookbook-gallery",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.lookbook_gallery.settings.heading.label",
      "default": "Shop the looks"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.lookbook_gallery.settings.subheading.label",
      "default": "Lookbook"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.lookbook_gallery.settings.full_width.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.lookbook_gallery.settings.header__colors.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.lookbook_gallery.settings.background_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.lookbook_gallery.settings.text_color.label",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "t:sections.lookbook_gallery.settings.dot_color.label",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "t:sections.lookbook_gallery.blocks.look.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.image.label"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.caption.label"
        },
        {
          "type": "header",
          "content": "t:sections.lookbook_gallery.blocks.look.settings.header__hotspot1.content"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.product_1.label"
        },
        {
          "type": "range",
          "id": "x1",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.x1.label",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 30,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "y1",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.y1.label",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 40,
          "unit": "%"
        },
        {
          "type": "header",
          "content": "t:sections.lookbook_gallery.blocks.look.settings.header__hotspot2.content"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.product_2.label"
        },
        {
          "type": "range",
          "id": "x2",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.x2.label",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 60,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "y2",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.y2.label",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 55,
          "unit": "%"
        },
        {
          "type": "header",
          "content": "t:sections.lookbook_gallery.blocks.look.settings.header__hotspot3.content"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.product_3.label"
        },
        {
          "type": "range",
          "id": "x3",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.x3.label",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 45,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "y3",
          "label": "t:sections.lookbook_gallery.blocks.look.settings.y3.label",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 70,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook_gallery.presets.name",
      "category": "Image",
      "blocks": [
        { "type": "look" },
        { "type": "look" }
      ]
    }
  ]
}
{% endschema %}