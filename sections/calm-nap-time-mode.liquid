{% comment %}
  Calm / Nap-Time Mode - Adaptive mood toggle for the whole page
{% endcomment %}

{{ 'calm-nap-time-mode.css' | asset_url | stylesheet_tag }}

<section class="calm-mode-section section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="calm__bar">
      <div class="calm__info">
        {% if section.settings.heading != blank %}
          <h2 class="calm__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="calm__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
      <div class="calm__toggle-wrap">
        <span class="calm__label" data-label-off>{{ section.settings.label_off | default: 'Normal' }}</span>
        <button type="button" 
                class="calm__toggle" 
                data-calm-toggle 
                aria-pressed="false"
                aria-label="Toggle Calm Mode">
          <span class="calm__toggle-knob"></span>
        </button>
        <span class="calm__label" data-label-on>{{ section.settings.label_on | default: 'Nap Time' }}</span>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'calm-nap-time-mode.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Calm / Nap-Time Mode",
  "tag": "section",
  "class": "section-calm-mode",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feeling a little tired?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Switch to Nap-Time Mode for a calmer, quieter shopping experience — perfect for late-night browsing with sleepy pets."
    },
    {
      "type": "text",
      "id": "label_off",
      "label": "Label when off",
      "default": "Normal"
    },
    {
      "type": "text",
      "id": "label_on",
      "label": "Label when on",
      "default": "Nap Time 😴"
    }
  ],
  "presets": [
    {
      "name": "Calm / Nap-Time Mode"
    }
  ]
}
{% endschema %}
