{%- comment -%}
  Single Quick View modal, shared by every product card on the page.
  Opened via [data-quick-view-open] buttons (see snippets/featured-products.liquid).
  Content is fetched from /products/{handle}.js and built by assets/quick-view.js.
  Render this once near the end of theme.liquid (already present in theme.liquid).
{%- endcomment -%}

{{ 'quick-view.css' | asset_url | stylesheet_tag }}

<dialog
  id="QuickViewModal"
  class="quick-view-modal"
  aria-label="{{ 'products.product.quick_view' | t | default: 'Quick view' }}"
>
  <div class="quick-view-modal__overlay" data-quick-view-close tabindex="-1"></div>
  <div class="quick-view-modal__dialog" role="document">
    <button
      type="button"
      class="quick-view-modal__close"
      data-quick-view-close
      aria-label="{{ 'general.close' | t | default: 'Close' }}"
    >
      &times;
    </button>

    <div class="quick-view-modal__loading" data-quick-view-loading hidden>
      <div class="quick-view-modal__spinner"></div>
    </div>

    <div class="quick-view-modal__content" data-quick-view-content hidden></div>
  </div>
</dialog>

<script src="{{ 'quick-view.js' | asset_url }}" defer></script>