{% comment %}
  Media with Text Overlay Section
  Version: 1.0
  Description: A full-width section with background media (image/video) and overlaid text content
{% endcomment %}

{{ 'media-with-text-overlay.css' | asset_url | stylesheet_tag }}

<div class="media-with-text-overlay" 
     data-section-id="{{ section.id }}" 
     data-section-type="media-with-text-overlay"
     role="region"
     aria-label="{{ section.settings.aria_label | escape }}"
     style="
       --mwto-height: {{ section.settings.section_height }}px;
       --mwto-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
       --mwto-overlay-color: {{ section.settings.overlay_color }};
       --mwto-preheading-color: {{ section.settings.preheading_color | default: '#ffffff' }};
       --mwto-heading-color: {{ section.settings.heading_color | default: '#ffffff' }};
       --mwto-text-color: {{ section.settings.text_color }};
       --mwto-content-width: {{ section.settings.content_width }}%;
       --mwto-content-position: {{ section.settings.content_position }};
       --mwto-button-bg: {{ section.settings.button_background }};
       --mwto-button-text-color: {{ section.settings.button_text_color }};
     ">
  
  <div class="media-with-text-overlay__wrapper">
    {%- if section.settings.media_type == 'image' -%}
      {%- if section.settings.image != blank -%}
        <div class="media-with-text-overlay__media">
          {%- liquid
            assign focal_style = ''
            if section.settings.image.presentation.focal_point
              assign focal_style = 'object-position: ' | append: section.settings.image.presentation.focal_point | append: ';'
            endif
          -%}
          <img
            src="{{ section.settings.image | image_url: width: 2000 }}"
            srcset="{{ section.settings.image | image_url: width: 2000 }} 1x, {{ section.settings.image | image_url: width: 4000 }} 2x"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
            width="2000"
            height="800"
            class="media-with-text-overlay__image"
            style="{{ focal_style }}"
          >
        </div>
      {%- else -%}
        <div class="media-with-text-overlay__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'media-with-text-overlay__placeholder-svg' }}
        </div>
      {%- endif -%}
    {%- else -%}
      {%- if section.settings.video_url != blank -%}
        <div class="media-with-text-overlay__media media-with-text-overlay__media--video">
          <video
            class="media-with-text-overlay__video"
            src="{{ section.settings.video_url }}"
            poster="{{ section.settings.image | image_url: width: 2000 }}"
            muted
            loop
            playsinline
            autoplay
          ></video>
          <button class="media-with-text-overlay__video-control" type="button" aria-label="{{ 'sections.media_with_text_overlay.play_pause_video' | t }}">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
        </div>
      {%- else -%}
        <div class="media-with-text-overlay__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'media-with-text-overlay__placeholder-svg' }}
        </div>
      {%- endif -%}
    {%- endif -%}

    <div class="media-with-text-overlay__overlay"></div>

    <div class="media-with-text-overlay__content">
      <div class="media-with-text-overlay__content-inner page-width text-{{ section.settings.content_alignment | default: 'center' }}">
        {%- if section.settings.preheading != blank -%}
          <p class="media-with-text-overlay__preheading">{{ section.settings.preheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="media-with-text-overlay__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="media-with-text-overlay__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_text != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="media-with-text-overlay__button btn">
            {{ section.settings.button_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'media-with-text-overlay.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.media_with_text_overlay.name",
  "tag": "section",
  "class": "media-with-text-overlay-section",
  "settings": [
    { "type": "header", "content": "t:sections.media_with_text_overlay.settings.header__1.content" },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:sections.media_with_text_overlay.settings.media_type.label",
      "options": [
        { "value": "image", "label": "t:sections.media_with_text_overlay.settings.media_type.options__1.label" },
        { "value": "video", "label": "t:sections.media_with_text_overlay.settings.media_type.options__2.label" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.media_with_text_overlay.settings.image.label",
      "info": "t:sections.media_with_text_overlay.settings.image.info"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "t:sections.media_with_text_overlay.settings.video_url.label",
      "info": "t:sections.media_with_text_overlay.settings.video_url.info"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "t:sections.media_with_text_overlay.settings.section_height.label",
      "min": 400,
      "max": 900,
      "step": 50,
      "default": 600,
      "unit": "px"
    },
    { "type": "header", "content": "t:sections.media_with_text_overlay.settings.header__2.content" },
    {
      "type": "text",
      "id": "preheading",
      "label": "t:sections.media_with_text_overlay.settings.preheading.label",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.media_with_text_overlay.settings.heading.label",
      "default": "Elevate Your Style"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.media_with_text_overlay.settings.text.label",
      "default": "<p>Discover our latest collection of premium products designed for modern living.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.media_with_text_overlay.settings.button_text.label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.media_with_text_overlay.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.media_with_text_overlay.settings.content_position.label",
      "options": [
        { "value": "flex-start", "label": "t:sections.media_with_text_overlay.settings.content_position.options__1.label" },
        { "value": "center", "label": "t:sections.media_with_text_overlay.settings.content_position.options__2.label" },
        { "value": "flex-end", "label": "t:sections.media_with_text_overlay.settings.content_position.options__3.label" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:sections.media_with_text_overlay.settings.content_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.media_with_text_overlay.settings.content_alignment.options__1.label" },
        { "value": "center", "label": "t:sections.media_with_text_overlay.settings.content_alignment.options__2.label" },
        { "value": "right", "label": "t:sections.media_with_text_overlay.settings.content_alignment.options__3.label" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "t:sections.media_with_text_overlay.settings.content_width.label",
      "min": 30,
      "max": 80,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    { "type": "header", "content": "t:sections.media_with_text_overlay.settings.header__3.content" },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:sections.media_with_text_overlay.settings.overlay_color.label",
      "default": "rgba(0, 0, 0, 0.4)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.media_with_text_overlay.settings.overlay_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "preheading_color",
      "label": "Preheading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.media_with_text_overlay.settings.text_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "t:sections.media_with_text_overlay.settings.button_background.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "t:sections.media_with_text_overlay.settings.button_text_color.label",
      "default": "#1a1a1a"
    },
    { "type": "header", "content": "t:sections.media_with_text_overlay.settings.header__4.content" },
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.media_with_text_overlay.settings.aria_label.label",
      "default": "Media with text overlay"
    }
  ],
  "presets": [
    {
      "name": "t:sections.media_with_text_overlay.presets.name",
      "category": "Hero"
    }
  ]
}
{% endschema %}
