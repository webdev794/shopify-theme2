{% comment %}
  Enhanced Cart Template with Full Discount Support
  Displays discounts on individual items and entire orders
{% endcomment %}

<div class="cart" id="cart-{{ section.id }}">
  {% if cart.item_count == 0 %}
    <div class="cart__empty page-width">
      <h1 class="cart__title">{{ 'cart.title' | t }}</h1>
      <p>{{ 'cart.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
        {{ 'cart.continue_shopping' | t }}
      </a>
    </div>
  {% else %}
    <div class="cart__container page-width">
      <h1 class="cart__title">{{ 'cart.title' | t }}</h1>

      {% assign cart_form_id = 'cart-form-' | append: section.id %}
      {% form 'cart', cart, class: 'cart__form', id: cart_form_id %}
        <div class="cart__layout">
          <div class="cart__items">
            <table class="cart-table">
              <caption class="visually-hidden">{{ 'cart.title' | t }}</caption>
              <thead>
                <tr>
                  <th scope="col" class="visually-hidden">{{ 'cart.product' | t }}</th>
                  <th scope="col">{{ 'cart.price' | t }}</th>
                  <th scope="col">{{ 'cart.quantity' | t }}</th>
                  <th scope="col">{{ 'cart.total' | t }}</th>
                </tr>
              </thead>
              <tbody>
                {% for item in cart.items %}
                  <tr class="cart-item" 
                      data-unit-price="{{ item.final_price }}"
                      data-original-price="{{ item.original_price }}"
                      data-line-key="{{ item.key }}"
                      data-quantity="{{ item.quantity }}">
                    <td class="cart-item__media-cell">
                      <a href="{{ item.url }}" class="cart-item__image-link">
                        {% if item.image %}
                          {{
                            item.image
                            | image_url: width: 200
                            | image_tag:
                              widths: '100,150,200',
                              sizes: '80px',
                              alt: item.image.alt | default: item.product.title,
                              loading: 'lazy',
                              class: 'cart-item__image'
                          }}
                        {% endif %}
                      </a>
                      <div class="cart-item__details">
                        <a href="{{ item.url }}" class="cart-item__title">{{ item.title }}</a>

                        {% assign has_real_options = false %}
                        {% for option in item.options_with_values %}
                          {% unless option.value == 'Default Title' %}
                            {% assign has_real_options = true %}
                          {% endunless %}
                        {% endfor %}

                        {% if has_real_options %}
                          <dl class="cart-item__options">
                            {% for option in item.options_with_values %}
                              <div>
                                <dt>{{ option.name }}:</dt>
                                <dd>{{ option.value }}</dd>
                              </div>
                            {% endfor %}
                          </dl>
                        {% endif %}

                        {% if item.selling_plan_allocation %}
                          <p class="cart-item__selling-plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                        {% endif %}

                        {% if item.properties.size > 0 %}
                          <dl class="cart-item__properties">
                            {% for property in item.properties %}
                              {% unless property.last == blank %}
                                <div>
                                  <dt>{{ property.first }}:</dt>
                                  <dd>{{ property.last }}</dd>
                                </div>
                              {% endunless %}
                            {% endfor %}
                          </dl>
                        {% endif %}

                        {% if item.message %}
                          <p class="cart-item__message">{{ item.message }}</p>
                        {% endif %}

                        <!-- Enhanced Line-Level Discount Display -->
                        {% if item.line_level_discount_allocations.size > 0 %}
                          <div class="cart-item__discounts-wrapper">
                            <ul class="cart-item__discounts" role="list">
                              {% for discount_allocation in item.line_level_discount_allocations %}
                                <li class="cart-item__discount">
                                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M20 12L12 20 4 12l8-8 8 8z"/>
                                    <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>
                                  </svg>
                                  {{ discount_allocation.discount_application.title }}
                                  <span class="cart-item__discount-amount">
                                    &minus;{{ discount_allocation.amount | money }}
                                  </span>
                                </li>
                              {% endfor %}
                            </ul>
                            
                            {% assign total_line_discount = 0 %}
                            {% for discount_allocation in item.line_level_discount_allocations %}
                              {% assign total_line_discount = total_line_discount | plus: discount_allocation.amount %}
                            {% endfor %}
                            <p class="cart-item__total-discount">
                              <span class="cart-item__discount-label">Total discount on this item:</span>
                              <span class="cart-item__discount-total">&minus;{{ total_line_discount | money }}</span>
                            </p>
                          </div>
                        {% endif %}

                        <a href="{{ item.url_to_remove }}" class="cart-item__remove">
                          {{ 'cart.remove' | t }}
                        </a>
                      </div>
                    </td>

                    <td class="cart-item__price-cell" data-label="{{ 'cart.price' | t }}">
                      {% if item.original_price != item.final_price %}
                        <div class="cart-item__prices">
                          <span class="price price--sale">{{ item.final_price | money }}</span>
                          <span class="price price--compare"><s>{{ item.original_price | money }}</s></span>
                          {% assign savings_percent = item.original_price | minus: item.final_price | times: 100 | divided_by: item.original_price %}
                          <span class="price__savings-badge">Save {{ savings_percent }}%</span>
                        </div>
                      {% else %}
                        <span class="price">{{ item.final_price | money }}</span>
                      {% endif %}
                      {% if item.unit_price %}
                        <div class="cart-item__unit-price">
                          {% render 'unit-price', object: item %}
                        </div>
                      {% endif %}
                    </td>

                    <td class="cart-item__quantity-cell" data-label="{{ 'cart.quantity' | t }}">
                      <div class="quantity-input">
                        <button
                          type="button"
                          class="quantity-input__button"
                          data-quantity-decrease
                          aria-label="{{ 'products.product.quantity.decrease' | t }}"
                        >&minus;</button>
                        <input
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="0"
                          {% if item.variant.inventory_management != blank and item.variant.inventory_policy == 'deny' %}
                            max="{{ item.variant.inventory_quantity }}"
                          {% endif %}
                          aria-label="{{ 'cart.quantity' | t }}"
                          data-line-key="{{ item.key }}"
                        >
                        <button
                          type="button"
                          class="quantity-input__button"
                          data-quantity-increase
                          aria-label="{{ 'products.product.quantity.increase' | t }}"
                        >+</button>
                      </div>
                    </td>

                    <td class="cart-item__total-cell" data-label="{{ 'cart.total' | t }}">
                      <span data-line-total>{{ item.final_line_price | money }}</span>
                      {% if item.original_line_price != item.final_line_price %}
                        <span class="cart-item__original-line-total"><s>{{ item.original_line_price | money }}</s></span>
                      {% endif %}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>

            <a href="{{ routes.all_products_collection_url }}" class="cart__continue-shopping">
              {{ 'cart.continue_shopping' | t }}
            </a>
          </div>

          <div class="cart__summary">
            {% if section.settings.enable_note %}
              <div class="cart__note">
                <label for="cart-note-{{ section.id }}">{{ 'cart.note' | t }}</label>
                <textarea name="note" id="cart-note-{{ section.id }}" rows="3">{{ cart.note }}</textarea>
              </div>
            {% endif %}

            <div class="cart__totals" data-money-format="{{ shop.money_format | escape }}">
              <!-- Subtotal with discount awareness -->
              <div class="cart__row cart__row--subtotal">
                <span>{{ 'cart.subtotal' | t }}</span>
                <span data-subtotal-amount>{{ cart.total_price | money }}</span>
              </div>

              <!-- Display total discounts if any -->
              {% assign total_discount_amount = 0 %}
              
              {%- if cart.taxes_included -%}
                <p class="cart__tax-note">
                  {{ 'cart.taxes_included' | t | default: 'Tax included.' }}
                </p>
              {%- endif -%}

              <!-- Cart-Level Discount Applications -->
              {% if cart.cart_level_discount_applications.size > 0 %}
                <div class="cart__discounts">
                  <p class="cart__discounts-label">Discounts applied:</p>
                  {% for discount_application in cart.cart_level_discount_applications %}
                    <div class="cart__row cart__row--discount">
                      <span class="cart__discount-name">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path d="M20 12L12 20 4 12l8-8 8 8z"/>
                          <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>
                        </svg>
                        {{ discount_application.title }}
                        <span class="cart__discount-code">
                          {% if discount_application.code %}
                            ({{ discount_application.code }})
                          {% endif %}
                        </span>
                      </span>
                      <span class="cart__discount-amount">&minus;{{ discount_application.total_allocated_amount | money }}</span>
                    </div>
                    {% assign total_discount_amount = total_discount_amount | plus: discount_application.total_allocated_amount %}
                  {% endfor %}
                </div>
              {% endif %}

              <!-- Show total savings -->
              {% if total_discount_amount > 0 or cart.total_discount > 0 %}
                <div class="cart__row cart__row--savings">
                  <span>Total savings</span>
                  <span class="cart__savings-amount">&minus;{{ cart.total_discount | money }}</span>
                </div>
              {% endif %}

              <p class="cart__taxes-note">{{ 'cart.taxes_and_shipping_at_checkout' | t }}</p>
              <p class="cart__estimate-note">{{ 'cart.recalculated_note' | t }}</p>
            </div>

            <div class="cart__actions">
              <button type="submit" class="button button--secondary cart__update-button">
                {{ 'cart.update' | t }}
              </button>
              <button type="submit" name="checkout" class="button button--primary cart__checkout-button">
                {{ 'cart.checkout' | t }}
              </button>
            </div>

            <!-- Accelerated Checkout Buttons - Enabled by default -->
            <div class="cart__accelerated-checkout">
              {% if additional_checkout_buttons %}
                {{ content_for_additional_checkout_buttons }}
              {% endif %}
            </div>
          </div>
        </div>
      {% endform %}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .cart {
    padding-block: 2rem;
  }

  .cart__empty,
  .cart__container {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .cart__empty {
    text-align: center;
    padding-block: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cart__title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    margin-bottom: 1.5rem;
  }

  .cart__layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  @media screen and (min-width: 900px) {
    .cart__layout {
      grid-template-columns: 1fr 320px;
    }

    .cart__summary {
      position: sticky;
      top: 2rem;
    }
  }

  /* ---------- Table ---------- */
  .cart-table {
    width: 100%;
    border-collapse: collapse;
  }

  .cart-table thead {
    border-bottom: 1px solid var(--color-border, #e5e5e5);
  }

  .cart-table th {
    text-align: left;
    padding-block: 0.75rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-foreground-secondary, #888);
  }

  .cart-table td {
    padding-block: 1.25rem;
    vertical-align: top;
    border-bottom: 1px solid var(--color-border, #eee);
  }

  .cart-item__media-cell {
    display: flex;
    gap: 1rem;
    width: 55%;
  }

  .cart-item__image-link {
    flex: 0 0 80px;
    width: 80px;
    height: 80px;
    border-radius: 0.4rem;
    overflow: hidden;
    background: var(--color-background-secondary, #f4f4f4);
  }

  .cart-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-item__details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cart-item__title {
    font-weight: 500;
    color: inherit;
    text-decoration: none;
  }

  .cart-item__title:hover {
    text-decoration: underline;
  }

  .cart-item__options {
    font-size: 0.85rem;
    color: var(--color-foreground-secondary, #777);
    margin: 0;
  }

  .cart-item__options div {
    display: flex;
    gap: 0.25rem;
  }

  .cart-item__options dt,
  .cart-item__options dd {
    margin: 0;
  }

  .cart-item__unit-price {
    font-size: 0.75rem;
    color: var(--color-foreground-secondary, #777);
    margin-top: 0.25rem;
  }

  .cart-item__selling-plan {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-foreground, #1a1a1a);
  }

  .cart-item__properties {
    font-size: 0.8rem;
    color: var(--color-foreground-secondary, #777);
  }

  .cart-item__properties div {
    display: flex;
    gap: 0.25rem;
  }

  .cart-item__properties dt,
  .cart-item__properties dd {
    margin: 0;
  }

  .cart-item__message {
    font-size: 0.8rem;
    color: var(--color-sale, #c0392b);
  }

  /* Enhanced Discount Styles */
  .cart-item__discounts-wrapper {
    margin-top: 0.5rem;
    padding: 0.5rem;
    background: #f8f4f0;
    border-radius: 0.4rem;
    border-left: 3px solid var(--color-sale, #c0392b);
  }

  .cart-item__discounts {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cart-item__discount {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--color-sale, #c0392b);
  }

  .cart-item__discount svg {
    flex-shrink: 0;
  }

  .cart-item__discount-amount {
    font-weight: 600;
  }

  .cart-item__total-discount {
    margin: 0.3rem 0 0;
    padding-top: 0.3rem;
    border-top: 1px dashed rgba(192, 57, 43, 0.2);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-sale, #c0392b);
  }

  .cart-item__remove {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-foreground-secondary, #888);
    width: fit-content;
  }

  .cart-item__remove:hover {
    color: var(--color-foreground, #1a1a1a);
  }

  .cart-item__price-cell .price--compare {
    display: block;
    color: var(--color-foreground-secondary, #999);
    font-size: 0.85rem;
  }

  .cart-item__price-cell .price--sale {
    color: var(--color-sale, #c0392b);
    font-weight: 600;
  }

  .cart-item__prices {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .price__savings-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    background: var(--color-sale, #c0392b);
    color: white;
    border-radius: 2rem;
    width: fit-content;
  }

  .cart-item__total-cell {
    font-weight: 600;
  }

  .cart-item__original-line-total {
    display: block;
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--color-foreground-secondary, #888);
  }

  /* ---------- Quantity ---------- */
  .quantity-input {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border, #ccc);
    border-radius: 0.4rem;
    overflow: hidden;
  }

  .quantity-input__button {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1rem;
  }

  .quantity-input__button:hover {
    background: var(--color-background-secondary, #f4f4f4);
  }

  .quantity-input input[type='number'] {
    width: 2.75rem;
    height: 2.25rem;
    text-align: center;
    border: none;
    border-left: 1px solid var(--color-border, #ccc);
    border-right: 1px solid var(--color-border, #ccc);
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .quantity-input input[type='number']::-webkit-outer-spin-button,
  .quantity-input input[type='number']::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart__continue-shopping {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: var(--color-foreground-secondary, #666);
  }

  .cart__continue-shopping:hover {
    color: var(--color-foreground, #1a1a1a);
  }

  /* ---------- Summary ---------- */
  .cart__summary {
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 0.5rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .cart__note label {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
  }

  .cart__note textarea {
    width: 100%;
    border: 1px solid var(--color-border, #ccc);
    border-radius: 0.4rem;
    padding: 0.5rem;
    font: inherit;
    resize: vertical;
  }

  .cart__totals {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart__row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
  }

  .cart__row--subtotal {
    font-size: 1.1rem;
    font-weight: 600;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-border, #eee);
  }

  .cart__tax-note {
    font-size: 0.8rem;
    color: var(--color-foreground-secondary, #777);
    margin: 0.25rem 0 0;
  }

  /* Cart-level Discount Styles */
  .cart__discounts {
    background: #f8f4f0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.4rem;
    border-left: 3px solid var(--color-sale, #c0392b);
  }

  .cart__discounts-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-foreground-secondary, #666);
    margin: 0 0 0.2rem 0;
  }

  .cart__row--discount {
    color: var(--color-sale, #c0392b);
    font-weight: 500;
  }

  .cart__discount-name {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .cart__discount-code {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-foreground-secondary, #666);
  }

  .cart__discount-amount {
    font-weight: 600;
  }

  .cart__row--savings {
    font-weight: 600;
    color: var(--color-sale, #c0392b);
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(192, 57, 43, 0.2);
  }

  .cart__taxes-note {
    font-size: 0.8rem;
    color: var(--color-foreground-secondary, #888);
  }

  .cart__estimate-note {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--color-foreground-secondary, #999);
  }

  .cart__actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* Accelerated Checkout Styles */
  .cart__accelerated-checkout {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border, #e5e5e5);
  }

  .cart__accelerated-checkout > * {
    margin: 0;
  }

  .cart__accelerated-checkout shopify-accelerated-checkout {
    display: block;
  }

  .cart__update-button,
  .cart__checkout-button {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: 0.4rem;
    font-size: 0.95rem;
    cursor: pointer;
    border: 1px solid var(--color-foreground, #1a1a1a);
    transition: opacity 0.2s;
  }

  .cart__update-button:hover,
  .cart__checkout-button:hover {
    opacity: 0.85;
  }

  .cart__update-button {
    background: var(--color-background, #fff);
    color: var(--color-foreground, #1a1a1a);
  }

  .cart__checkout-button {
    background: var(--color-foreground, #1a1a1a);
    color: var(--color-background, #fff);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Mobile: table becomes stacked, centered cards ---------- */
  @media screen and (max-width: 749px) {
    .cart-table thead {
      display: none;
    }

    .cart-table,
    .cart-table tbody,
    .cart-table tr,
    .cart-table td {
      display: block;
      width: 100%;
    }

    .cart-item {
      padding-block: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .cart-item__media-cell {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      gap: 0.5rem;
    }

    .cart-item__image-link {
      margin: 0 auto;
    }

    .cart-item__details {
      align-items: center;
      text-align: center;
    }

    .cart-item__options div,
    .cart-item__properties div,
    .cart-item__discount {
      justify-content: center;
    }

    .cart-item__discounts-wrapper {
      width: 100%;
      text-align: left;
    }

    .cart-item__price-cell,
    .cart-item__quantity-cell,
    .cart-item__total-cell {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.3rem;
      border-bottom: none;
      padding-block: 0.4rem;
      padding-left: 0;
    }

    .cart-item__price-cell::before,
    .cart-item__quantity-cell::before,
    .cart-item__total-cell::before {
      content: attr(data-label);
      font-size: 0.8rem;
      color: var(--color-foreground-secondary, #888);
      font-weight: 500;
    }

    .price__savings-badge {
      margin: 0 auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  function submitCartQuantityUpdate(form) {
    if (!form) return;

    if (typeof form.requestSubmit === 'function') {
      form.requestSubmit();
    } else {
      form.submit();
    }
  }

  document.addEventListener('click', (event) => {
    const decreaseButton = event.target.closest('[data-quantity-decrease]');
    const increaseButton = event.target.closest('[data-quantity-increase]');
    if (!decreaseButton && !increaseButton) return;

    const wrapper = event.target.closest('.quantity-input');
    const input = wrapper.querySelector('input[type="number"]');
    const form = event.target.closest('form.cart__form');
    const min = parseInt(input.min, 10) || 0;
    const max = input.max ? parseInt(input.max, 10) : Infinity;
    let value = parseInt(input.value, 10) || min;

    value = increaseButton ? Math.min(max, value + 1) : Math.max(min, value - 1);
    input.value = value;
    input.dispatchEvent(new Event('input', { bubbles: true }));
    submitCartQuantityUpdate(form);
  });

  // Refresh the complete cart when a quantity field is changed manually.
  // Submitting the cart form lets Shopify recalculate every line item, discounts,
  // inventory limits, and the cart total before rendering the updated cart.
  document.addEventListener('change', (event) => {
    const input = event.target.closest('.cart-item input[type="number"]');
    if (!input) return;

    const form = input.closest('form.cart__form');
    if (!form) return;

    const min = parseInt(input.min, 10) || 0;
    const max = input.max ? parseInt(input.max, 10) : Infinity;
    let value = parseInt(input.value, 10);

    if (Number.isNaN(value)) value = min;
    value = Math.max(min, Math.min(max, value));
    input.value = value;

    submitCartQuantityUpdate(form);
  });

  // ---------- Live line-total and subtotal estimate ----------
  function formatMoney(cents, format) {
    function withDelimiters(number, precision, thousands, decimalSep) {
      if (isNaN(number) || number === null) return 0;
      const fixed = (number / 100).toFixed(precision);
      const parts = fixed.split('.');
      const wholePart = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, `$1${thousands}`);
      const decimalPart = parts[1] ? decimalSep + parts[1] : '';
      return wholePart + decimalPart;
    }

    if (!format) return withDelimiters(cents, 2, ',', '.');
    const match = format.match(/\{\{\s*(\w+)\s*\}\}/);
    if (!match) return format;

    let value;
    switch (match[1]) {
      case 'amount_no_decimals':
        value = withDelimiters(cents, 0, ',', '.');
        break;
      case 'amount_with_comma_separator':
        value = withDelimiters(cents, 2, '.', ',');
        break;
      case 'amount_no_decimals_with_comma_separator':
        value = withDelimiters(cents, 0, '.', ',');
        break;
      case 'amount_with_apostrophe_separator':
        value = withDelimiters(cents, 2, "'", '.');
        break;
      default:
        value = withDelimiters(cents, 2, ',', '.');
    }

    return format.replace(/\{\{\s*\w+\s*\}\}/, value);
  }

  function updateLineTotal(row) {
    const unitPrice = parseInt(row.dataset.unitPrice, 10);
    const quantityInput = row.querySelector('input[type="number"]');
    const totalEl = row.querySelector('[data-line-total]');
    const originalTotalEl = row.querySelector('.cart-item__original-line-total');
    const totalsWrapper = document.querySelector('.cart__totals');
    if (!unitPrice || !quantityInput || !totalEl || !totalsWrapper) return;

    const quantity = parseInt(quantityInput.value, 10) || 0;
    const lineTotal = unitPrice * quantity;
    totalEl.textContent = formatMoney(lineTotal, totalsWrapper.dataset.moneyFormat);

    // Update original line total if it exists
    if (originalTotalEl && row.dataset.originalPrice) {
      const originalUnitPrice = parseInt(row.dataset.originalPrice, 10);
      const originalLineTotal = originalUnitPrice * quantity;
      originalTotalEl.textContent = formatMoney(originalLineTotal, totalsWrapper.dataset.moneyFormat);
    }
  }

  function updateSubtotal() {
    const totalsWrapper = document.querySelector('.cart__totals');
    const subtotalEl = document.querySelector('[data-subtotal-amount]');
    if (!totalsWrapper || !subtotalEl) return;

    let subtotal = 0;
    document.querySelectorAll('.cart-item').forEach((row) => {
      const unitPrice = parseInt(row.dataset.unitPrice, 10) || 0;
      const quantityInput = row.querySelector('input[type="number"]');
      const quantity = parseInt(quantityInput.value, 10) || 0;
      subtotal += unitPrice * quantity;
    });

    subtotalEl.textContent = formatMoney(subtotal, totalsWrapper.dataset.moneyFormat);
  }

  document.addEventListener('input', (event) => {
    const input = event.target.closest('.cart-item input[type="number"]');
    if (!input) return;

    const row = input.closest('.cart-item');
    updateLineTotal(row);
    updateSubtotal();
  });
{% endjavascript %}

