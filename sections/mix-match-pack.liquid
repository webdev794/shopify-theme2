{% comment %}
  Mix & Match Pack Section
  Version: 2.0 — "Build your pack" redesign
{% endcomment %}

{{ 'mix-match-pack.css' | asset_url | stylesheet_tag }}

<div class="mix-match-pack"
     data-section-id="{{ section.id }}"
     data-section-type="mix-match-pack"
     data-max-items="{{ section.settings.max_items }}"
     role="region"
     aria-label="{{ section.settings.aria_label | escape }}"
     style="background-color: {{ section.settings.background_color }};"
     data-background-color="{{ section.settings.background_color }}">

  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="mix-match-pack__header">
        <h2 class="mix-match-pack__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="mix-match-pack__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="mix-match-pack__wrapper">
      <div class="mix-match-pack__info">
        <div class="mix-match-pack__selection-info">
          <span class="mix-match-pack__selection-label">{{ section.settings.selection_label | default: 'Your Selection' | escape }}</span>
          <span class="mix-match-pack__selection-count">
            <span class="mix-match-pack__selected-count" id="selected-count-{{ section.id }}">0</span> / {{ section.settings.max_items | default: 4 }} {{ 'products.product.items' | t | default: 'items' }}
          </span>
        </div>

        <div class="mix-match-pack__progress" aria-hidden="true">
          <div class="mix-match-pack__progress-fill" id="progress-fill-{{ section.id }}" style="width: 0%;"></div>
        </div>

        <div class="mix-match-pack__tray" id="tray-{{ section.id }}">
          <p class="mix-match-pack__tray-empty" id="tray-empty-{{ section.id }}">{{ section.settings.tray_empty_text | default: 'Tap products to start building your pack' | escape }}</p>
        </div>

        <div class="mix-match-pack__total">
          <span class="mix-match-pack__total-label">{{ section.settings.total_label | default: 'Total' | escape }}:</span>
          <span class="mix-match-pack__total-price" id="pack-total-price-{{ section.id }}">{{ 0 | money }}</span>
        </div>

        <p class="mix-match-pack__savings" id="pack-savings-{{ section.id }}" hidden></p>

        <button class="mix-match-pack__add-pack btn btn--primary" type="button" disabled>
          {{ section.settings.add_pack_text | default: 'Add Pack to Cart' | escape }}
        </button>

        {%- if section.settings.free_shipping_text != blank -%}
          <p class="mix-match-pack__free-shipping">
            <span class="mix-match-pack__free-shipping-icon">✓</span>
            {{ section.settings.free_shipping_text | escape }}
          </p>
        {%- endif -%}
      </div>

      <div class="mix-match-pack__products">
        <div class="mix-match-pack__products-grid">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              <div class="mix-match-pack__product" data-product-id="{{ product.id }}" {{ block.shopify_attributes }}>
                <div class="mix-match-pack__product-card">
                  <div class="mix-match-pack__product-image-wrapper">
                    {%- if product.featured_image != blank -%}
                      {%- liquid
                        assign focal_style = ''
                        if product.featured_image.presentation.focal_point
                          assign focal_style = 'object-position: ' | append: product.featured_image.presentation.focal_point | append: ';'
                        endif
                      -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 300 }}"
                        srcset="{{ product.featured_image | image_url: width: 300 }} 1x, {{ product.featured_image | image_url: width: 600 }} 2x"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="300"
                        height="300"
                        class="mix-match-pack__product-image"
                        style="object-fit: cover; {{ focal_style }}"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'mix-match-pack__product-image mix-match-pack__product-image--placeholder' }}
                    {%- endif -%}
                    <div class="mix-match-pack__product-check">
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                      </svg>
                    </div>
                  </div>

                  <div class="mix-match-pack__product-info">
                    <h3 class="mix-match-pack__product-title">{{ product.title }}</h3>

                    {%- if section.settings.show_vendor and product.vendor != blank -%}
                      <p class="mix-match-pack__product-vendor">{{ product.vendor }}</p>
                    {%- endif -%}

                    <div class="mix-match-pack__product-price">
                      <span class="mix-match-pack__product-price-current" data-price="{{ product.price }}">
                        {{ product.price | money }}
                      </span>
                      {%- if product.compare_at_price > product.price -%}
                        <span class="mix-match-pack__product-price-compare">{{ product.compare_at_price | money }}</span>
                      {%- endif -%}
                    </div>

                    {%- if section.settings.show_variant_selector and product.has_only_default_variant == false -%}
                      <div class="mix-match-pack__product-options">
                        <select class="mix-match-pack__variant-selector" data-product-id="{{ product.id }}">
                          {%- for variant in product.variants -%}
                            <option value="{{ variant.id }}"
                                    data-price="{{ variant.price }}"
                                    {%- if forloop.first %}selected{% endif -%}>
                              {{ variant.title }} - {{ variant.price | money }}
                            </option>
                          {%- endfor -%}
                        </select>
                      </div>
                    {%- endif -%}

                    <button class="mix-match-pack__select-product btn btn--secondary btn--small"
                            data-product-id="{{ product.id }}"
                            data-variant-id="{{ product.first_available_variant.id }}"
                            data-price="{{ product.price }}"
                            data-compare-price="{{ product.compare_at_price | default: 0 }}"
                            data-title="{{ product.title | escape }}"
                            data-image="{{ product.featured_image | image_url: width: 120, height: 120, crop: 'center' }}"
                            type="button">
                      <span class="mix-match-pack__select-product-label">{{ section.settings.select_button_text | default: 'Select' | escape }}</span>
                    </button>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="mix-match-pack__empty">
              <p>{{ 'sections.mix_match_pack.empty' | t }}</p>
              {%- if shop.editor_mode -%}
                <p><small>Click "Add block" to add products</small></p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'mix-match-pack.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.mix_match_pack.name",
  "tag": "section",
  "class": "mix-match-pack-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.mix_match_pack.settings.heading.label",
      "default": "Build Your Own Pack"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.mix_match_pack.settings.subheading.label",
      "default": "Mix and match your favorite items"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "t:sections.mix_match_pack.settings.max_items.label",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    { "type": "header", "content": "t:sections.mix_match_pack.settings.header__1.content" },
    {
      "type": "text",
      "id": "selection_label",
      "label": "t:sections.mix_match_pack.settings.selection_label.label",
      "default": "Your Selection"
    },
    {
      "type": "text",
      "id": "tray_empty_text",
      "label": "Empty tray text",
      "default": "Tap products to start building your pack"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "t:sections.mix_match_pack.settings.total_label.label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "add_pack_text",
      "label": "t:sections.mix_match_pack.settings.add_pack_text.label",
      "default": "Add Pack to Cart"
    },
    {
      "type": "text",
      "id": "select_button_text",
      "label": "t:sections.mix_match_pack.settings.select_button_text.label",
      "default": "Select"
    },
    {
      "type": "text",
      "id": "free_shipping_text",
      "label": "t:sections.mix_match_pack.settings.free_shipping_text.label",
      "default": "Free shipping on this pack"
    },
    { "type": "header", "content": "t:sections.mix_match_pack.settings.header__2.content" },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.mix_match_pack.settings.show_vendor.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_variant_selector",
      "label": "t:sections.mix_match_pack.settings.show_variant_selector.label",
      "default": true
    },
    { "type": "header", "content": "t:sections.mix_match_pack.settings.header__3.content" },
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.mix_match_pack.settings.aria_label.label",
      "default": "Mix and match pack builder"
    },
    { "type": "header", "content": "t:sections.mix_match_pack.settings.header__4.content" },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.mix_match_pack.settings.background_color.label",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.mix_match_pack.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.mix_match_pack.blocks.product.settings.product.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.mix_match_pack.presets.name",
      "category": "Product"
    }
  ]
}
{% endschema %}
