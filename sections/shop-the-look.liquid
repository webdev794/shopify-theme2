{%- liquid
  assign section_id = section.id
  assign s = section.settings
  assign heading_font = s.heading_font
  assign body_font = s.body_font
  assign looks = section.blocks | where: 'type', 'look'
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #ShopLook-{{ section_id }} {
    --sl-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --sl-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    position: relative;
    background-color: {{ s.background_color }};
    padding-top: {{ s.section_padding_top }}px;
    padding-bottom: {{ s.section_padding_bottom }}px;
    font-family: var(--sl-body-font);
    overflow: hidden;
  }

  #ShopLook-{{ section_id }} .sl-wrap {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header */
  #ShopLook-{{ section_id }} .sl-header {
    text-align: center;
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.8s ease, transform 0.8s ease;
    margin-bottom: {{ s.gap_header_to_nav }}px;
  }

  #ShopLook-{{ section_id }}.is-inview .sl-header {
    opacity: 1;
    transform: translateY(0);
  }

  #ShopLook-{{ section_id }} .sl-eyebrow-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: {{ s.text_color }};
    opacity: 0.65;
    margin: 0 0 10px;
  }

  #ShopLook-{{ section_id }} .sl-eyebrow-top::before,
  #ShopLook-{{ section_id }} .sl-eyebrow-top::after {
    content: "";
    width: 32px;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  #ShopLook-{{ section_id }} .sl-eyebrow-bottom {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ s.accent_color }};
    margin: 0 0 14px;
  }

  #ShopLook-{{ section_id }} .sl-heading {
    font-family: var(--sl-heading-font);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.08;
    color: {{ s.heading_color }};
    margin: 0 0 18px;
    font-size: {{ s.heading_size | times: 0.5 | round }}px;
  }

  @media screen and (min-width: 750px) {
    #ShopLook-{{ section_id }} .sl-heading {
      font-size: {{ s.heading_size }}px;
    }
  }

  #ShopLook-{{ section_id }} .sl-divider {
    width: 64px;
    height: 1px;
    background: {{ s.divider_color }};
    margin: 0 auto;
  }

  /* Nav row (per look) */
  #ShopLook-{{ section_id }} .sl-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    margin-bottom: {{ s.gap_nav_to_stage }}px;
    flex-wrap: wrap;
  }

  #ShopLook-{{ section_id }} .sl-arrow {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid {{ s.divider_color }};
    background: transparent;
    color: {{ s.heading_color }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }

  #ShopLook-{{ section_id }} .sl-arrow:hover {
    background-color: {{ s.accent_color }};
    border-color: {{ s.accent_color }};
    color: #fff;
    transform: scale(1.06);
  }

  #ShopLook-{{ section_id }} .sl-nav-center {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    justify-content: center;
  }

  #ShopLook-{{ section_id }} .sl-caption {
    font-size: {{ s.body_size }}px;
    color: {{ s.text_color }};
    margin: 0;
    white-space: nowrap;
  }

  #ShopLook-{{ section_id }} .sl-look-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ s.button_padding_y }}px {{ s.button_padding_x }}px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: {{ s.button_radius }}px;
    background-color: {{ s.button_bg_color }};
    color: {{ s.button_text_color }};
    transition: background-color 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
    font-family: var(--sl-heading-font);
  }

  #ShopLook-{{ section_id }} .sl-look-button:hover {
    background-color: {{ s.accent_color }};
    transform: translateY(-2px);
  }

  /* Looks wrapper + stage */
  #ShopLook-{{ section_id }} .sl-looks-wrap {
    position: relative;
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.8s ease 0.12s, transform 0.8s ease 0.12s;
  }

  #ShopLook-{{ section_id }}.is-inview .sl-looks-wrap {
    opacity: 1;
    transform: translateY(0);
  }

  #ShopLook-{{ section_id }} .sl-look {
    display: none;
  }

  #ShopLook-{{ section_id }} .sl-look.is-active {
    display: block;
  }

  #ShopLook-{{ section_id }} .sl-stage {
    position: relative;
    min-height: {{ s.stage_height }}px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  #ShopLook-{{ section_id }} .sl-look.is-active .sl-stage {
    opacity: 1;
    transform: translateY(0);
  }

  #ShopLook-{{ section_id }} .sl-look.is-leaving .sl-stage {
    opacity: 0;
    transform: translateY(-8px);
  }

  {%- if s.show_corner_accents -%}
  #ShopLook-{{ section_id }} .sl-ring {
    position: absolute;
    border: 1px solid {{ s.divider_color }};
    border-radius: 50%;
    z-index: 0;
  }
  #ShopLook-{{ section_id }} .sl-ring--tl { width: 26px; height: 26px; top: 6%; left: 2%; }
  #ShopLook-{{ section_id }} .sl-ring--br { width: 34px; height: 34px; bottom: 4%; right: 3%; }
  {%- endif -%}

  #ShopLook-{{ section_id }} .sl-img-primary {
    position: absolute;
    top: 0;
    left: 8%;
    width: 62%;
    height: 82%;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 20px 45px rgba(0,0,0,0.14);
    z-index: 1;
  }

  #ShopLook-{{ section_id }} .sl-img-secondary {
    position: absolute;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 24px 50px rgba(0,0,0,0.2);
    z-index: 2;
    border: 4px solid {{ s.background_color }};
  }

  #ShopLook-{{ section_id }} .sl-img-primary img,
  #ShopLook-{{ section_id }} .sl-img-secondary img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #ShopLook-{{ section_id }} .sl-img-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, {{ s.accent_color }}22, {{ s.divider_color }});
    color: {{ s.accent_color }};
  }

  /* Hotspots */
  #ShopLook-{{ section_id }} .sl-hotspot {
    position: absolute;
    z-index: 5;
    transform: translate(-50%, -50%);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  #ShopLook-{{ section_id }} .sl-hotspot-dot {
    position: relative;
    display: block;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }

  #ShopLook-{{ section_id }} .sl-hotspot-dot::before {
    content: "";
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    background: {{ s.accent_color }};
  }

  #ShopLook-{{ section_id }} .sl-hotspot-dot::after {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid {{ s.accent_color }};
    opacity: 0.6;
    animation: sl-pulse-{{ section_id }} 2.2s ease-out infinite;
  }

  @keyframes sl-pulse-{{ section_id }} {
    0% { transform: scale(0.7); opacity: 0.6; }
    100% { transform: scale(1.9); opacity: 0; }
  }

  #ShopLook-{{ section_id }} .sl-hotspot-tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 14px);
    transform: translate(-50%, 6px) scale(0.92);
    width: 176px;
    background: {{ s.tooltip_bg_color }};
    border-radius: 8px;
    box-shadow: 0 16px 34px rgba(0,0,0,0.22);
    padding: 10px;
    display: flex;
    gap: 10px;
    align-items: center;
    text-align: left;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #ShopLook-{{ section_id }} .sl-hotspot[data-flip-y="true"] .sl-hotspot-tooltip {
    bottom: auto;
    top: calc(100% + 14px);
    transform: translate(-50%, -6px) scale(0.92);
  }

  #ShopLook-{{ section_id }} .sl-hotspot[data-flip-x="true"] .sl-hotspot-tooltip {
    left: auto;
    right: -12px;
    transform: translate(0, 6px) scale(0.92);
  }

  #ShopLook-{{ section_id }} .sl-hotspot[data-flip-x="true"][data-flip-y="true"] .sl-hotspot-tooltip {
    transform: translate(0, -6px) scale(0.92);
  }

  #ShopLook-{{ section_id }} .sl-hotspot.is-open .sl-hotspot-tooltip {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
  }

  #ShopLook-{{ section_id }} .sl-hotspot[data-flip-x="true"].is-open .sl-hotspot-tooltip {
    transform: translate(0, 0) scale(1);
  }

  #ShopLook-{{ section_id }} .sl-tooltip-img {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    overflow: hidden;
    background: {{ s.divider_color }};
  }

  #ShopLook-{{ section_id }} .sl-tooltip-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #ShopLook-{{ section_id }} .sl-tooltip-name {
    font-size: 12px;
    font-weight: 700;
    color: {{ s.heading_color }};
    margin: 0 0 2px;
    line-height: 1.25;
  }

  #ShopLook-{{ section_id }} .sl-tooltip-price {
    font-size: 12px;
    font-weight: 600;
    color: {{ s.accent_color }};
    margin: 0;
  }

  /* Dots */
  #ShopLook-{{ section_id }} .sl-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: {{ s.gap_stage_to_dots }}px;
  }

  #ShopLook-{{ section_id }} .sl-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: {{ s.divider_color }};
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  #ShopLook-{{ section_id }} .sl-dot.is-active {
    background: {{ s.accent_color }};
    transform: scale(1.3);
  }

  /* Footer note */
  #ShopLook-{{ section_id }} .sl-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: {{ s.gap_dots_to_footer }}px;
    padding-top: 16px;
    border-top: 1px solid {{ s.divider_color }};
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: {{ s.text_color }};
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    #ShopLook-{{ section_id }} .sl-stage {
      min-height: {{ s.stage_height | times: 0.85 | round }}px;
    }
    #ShopLook-{{ section_id }} .sl-img-primary {
      left: 0;
      width: 68%;
    }
    #ShopLook-{{ section_id }} .sl-caption {
      white-space: normal;
      text-align: center;
    }
    #ShopLook-{{ section_id }} .sl-footer {
      justify-content: center;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ShopLook-{{ section_id }} .sl-header,
    #ShopLook-{{ section_id }} .sl-looks-wrap,
    #ShopLook-{{ section_id }} .sl-stage {
      transition: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    #ShopLook-{{ section_id }} .sl-hotspot-dot::after {
      animation: none;
    }
  }
</style>

<section id="ShopLook-{{ section_id }}" data-autoplay="{{ s.enable_autoplay }}" data-autoplay-interval="{{ s.autoplay_interval }}">
  <div class="sl-wrap">

    <div class="sl-header">
      {%- if s.eyebrow_top != blank -%}
        <p class="sl-eyebrow-top">{{ s.eyebrow_top }}</p>
      {%- endif -%}
      {%- if s.eyebrow_bottom != blank -%}
        <p class="sl-eyebrow-bottom">{{ s.eyebrow_bottom }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="sl-heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.show_divider -%}
        <div class="sl-divider"></div>
      {%- endif -%}
    </div>

    {%- if looks.size > 0 -%}
      <div class="sl-looks-wrap">
        {%- for block in looks -%}
          {%- assign bs = block.settings -%}
          <div class="sl-look {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>

            <div class="sl-nav">
              <button type="button" class="sl-arrow sl-arrow-prev" aria-label="Previous look">‹</button>
              <div class="sl-nav-center">
                {%- if bs.caption != blank -%}
                  <p class="sl-caption">{{ bs.caption }}</p>
                {%- endif -%}
                {%- if bs.button_text != blank -%}
                  <a href="{{ bs.button_link | default: '#' }}" class="sl-look-button">{{ bs.button_text }}</a>
                {%- endif -%}
              </div>
              <button type="button" class="sl-arrow sl-arrow-next" aria-label="Next look">›</button>
            </div>

            <div class="sl-stage">
              {%- if s.show_corner_accents -%}
                <span class="sl-ring sl-ring--tl" aria-hidden="true"></span>
                <span class="sl-ring sl-ring--br" aria-hidden="true"></span>
              {%- endif -%}

              <div class="sl-img-primary">
                {%- if bs.primary_image != blank -%}
                  {{ bs.primary_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 40vw, 70vw' }}
                {%- else -%}
                  <div class="sl-img-fallback">
                    <svg viewBox="0 0 40 40" width="40" height="40" fill="none"><circle cx="20" cy="20" r="16" stroke="currentColor" stroke-width="1.5"/></svg>
                  </div>
                {%- endif -%}
              </div>

              {%- if bs.secondary_image != blank -%}
                <div class="sl-img-secondary" style="left:{{ bs.secondary_left }}%; top:{{ bs.secondary_top }}%; width:{{ bs.secondary_width }}%; height:{{ bs.secondary_height }}%;">
                  {{ bs.secondary_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 30vw, 55vw' }}
                </div>
              {%- endif -%}

              {%- for i in (1..3) -%}
                {%- assign enable_key = 'hotspot_' | append: i | append: '_enable' -%}
                {%- assign enabled = bs[enable_key] -%}
                {%- if enabled -%}
                  {%- assign x_key = 'hotspot_' | append: i | append: '_x' -%}
                  {%- assign y_key = 'hotspot_' | append: i | append: '_y' -%}
                  {%- assign name_key = 'hotspot_' | append: i | append: '_name' -%}
                  {%- assign price_key = 'hotspot_' | append: i | append: '_price' -%}
                  {%- assign image_key = 'hotspot_' | append: i | append: '_image' -%}
                  {%- assign link_key = 'hotspot_' | append: i | append: '_link' -%}
                  {%- assign hx = bs[x_key] -%}
                  {%- assign hy = bs[y_key] -%}
                  {%- assign flip_x = false -%}
                  {%- assign flip_y = false -%}
                  {%- if hx > 62 -%}{%- assign flip_x = true -%}{%- endif -%}
                  {%- if hy < 30 -%}{%- assign flip_y = true -%}{%- endif -%}
                  <button
                    type="button"
                    class="sl-hotspot"
                    style="left:{{ hx }}%; top:{{ hy }}%;"
                    data-flip-x="{{ flip_x }}"
                    data-flip-y="{{ flip_y }}"
                    aria-label="{{ bs[name_key] }}"
                  >
                    <span class="sl-hotspot-dot"></span>
                    <span class="sl-hotspot-tooltip">
                      <span class="sl-tooltip-img">
                        {%- if bs[image_key] != blank -%}
                          {{ bs[image_key] | image_url: width: 120 | image_tag: loading: 'lazy' }}
                        {%- endif -%}
                      </span>
                      <span>
                        <span class="sl-tooltip-name">{{ bs[name_key] }}</span>
                        <span class="sl-tooltip-price">{{ bs[price_key] }}</span>
                      </span>
                    </span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if s.show_nav_dots and looks.size > 1 -%}
        <div class="sl-dots">
          {%- for block in looks -%}
            <button type="button" class="sl-dot {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to look {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if s.footer_left_text != blank or s.footer_right_text != blank -%}
      <div class="sl-footer">
        <span>{{ s.footer_left_text }}</span>
        <span>{{ s.footer_right_text }}</span>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('ShopLook-{{ section_id }}');
    if (!root || root.dataset.slInit) return;
    root.dataset.slInit = 'true';

    var looks = Array.prototype.slice.call(root.querySelectorAll('.sl-look'));
    var dots = Array.prototype.slice.call(root.querySelectorAll('.sl-dot'));
    var total = looks.length;
    var activeIndex = 0;
    var autoplayTimer = null;

    function updateDots() {
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === activeIndex);
      });
    }

    function activate(newIndex) {
      if (total === 0 || newIndex === activeIndex) return;
      var current = looks[activeIndex];
      var next = looks[newIndex];

      current.classList.add('is-leaving');
      current.classList.remove('is-active');

      window.setTimeout(function () {
        current.classList.remove('is-leaving');
        current.style.display = 'none';
        next.style.display = '';
        void next.offsetWidth;
        next.classList.add('is-active');
      }, 260);

      activeIndex = newIndex;
      updateDots();
    }

    root.addEventListener('click', function (e) {
      var prevBtn = e.target.closest('.sl-arrow-prev');
      var nextBtn = e.target.closest('.sl-arrow-next');
      var dot = e.target.closest('.sl-dot');
      var hotspot = e.target.closest('.sl-hotspot');

      if (prevBtn) {
        activate((activeIndex - 1 + total) % total);
      } else if (nextBtn) {
        activate((activeIndex + 1) % total);
      } else if (dot) {
        activate(parseInt(dot.getAttribute('data-index'), 10));
      } else if (hotspot) {
        var wasOpen = hotspot.classList.contains('is-open');
        root.querySelectorAll('.sl-hotspot.is-open').forEach(function (h) { h.classList.remove('is-open'); });
        if (!wasOpen) hotspot.classList.add('is-open');
      } else {
        root.querySelectorAll('.sl-hotspot.is-open').forEach(function (h) { h.classList.remove('is-open'); });
      }
    });

    document.addEventListener('click', function (e) {
      if (!root.contains(e.target)) {
        root.querySelectorAll('.sl-hotspot.is-open').forEach(function (h) { h.classList.remove('is-open'); });
      }
    });

    // Entrance animation
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            root.classList.add('is-inview');
            io.unobserve(root);
          }
        });
      }, { threshold: 0.2 });
      io.observe(root);
    } else {
      root.classList.add('is-inview');
    }

    // Autoplay
    var autoplay = root.getAttribute('data-autoplay') === 'true';
    var interval = parseInt(root.getAttribute('data-autoplay-interval'), 10) || 5;
    if (autoplay && total > 1) {
      function startAutoplay() {
        autoplayTimer = window.setInterval(function () {
          activate((activeIndex + 1) % total);
        }, interval * 1000);
      }
      function stopAutoplay() {
        if (autoplayTimer) window.clearInterval(autoplayTimer);
      }
      startAutoplay();
      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', startAutoplay);
    }
  })();
</script>

{% schema %}
{
  "name": "Shop The Look",
  "tag": "section",
  "class": "section-shop-the-look",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section max width",
      "min": 700,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "stage_height",
      "label": "Stage height",
      "min": 280,
      "max": 640,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "checkbox",
      "id": "show_corner_accents",
      "label": "Show corner ring accents",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_nav_dots",
      "label": "Show navigation dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Autoplay through looks",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section padding bottom",
      "min": 0,
