{{ 'lookbook-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lookbook-gallery.js' | asset_url }}" defer></script>

<section
  class="lookbook-gallery"
  data-section-type="lookbook-gallery"
  data-section-id="{{ section.id }}"
  style="
    --lbg-background: {{ section.settings.background_color }};
    --lbg-text: {{ section.settings.text_color }};
    --lbg-dot: {{ section.settings.dot_color }};
  "
>
  <div class="lookbook-gallery__container">

    <header class="lookbook-gallery__header">

      <div class="lookbook-gallery__chapter">
        <span class="lookbook-gallery__chapter-number">05</span>
        <span class="lookbook-gallery__chapter-line"></span>
        <span class="lookbook-gallery__chapter-label">
          LOOKS / MOMENTS
        </span>
      </div>

      {% if section.settings.subheading != blank %}
        <p class="lookbook-gallery__eyebrow">
          {{ section.settings.subheading | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="lookbook-gallery__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      <div class="lookbook-gallery__intro">
        <span></span>
        <p>Little combinations made for life together.</p>
        <span></span>
      </div>

    </header>

    <div class="lookbook-gallery__looks">

      {% for block in section.blocks %}

        <article
          class="
            lookbook-gallery__look
            {% if forloop.index == 2 %}lookbook-gallery__look--offset{% endif %}
          "
          data-look
          data-look-index="{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          {% assign product_1 = block.settings.product_1 %}
          {% assign product_2 = block.settings.product_2 %}
          {% assign product_3 = block.settings.product_3 %}
          {%- liquid
            assign look_variant_ids = ''
            if product_1 != blank
              assign v1 = product_1.selected_or_first_available_variant
              if v1 != blank and v1.available and v1.id != blank
                assign look_variant_ids = v1.id | append: ''
              endif
            endif
            if product_2 != blank
              assign v2 = product_2.selected_or_first_available_variant
              if v2 != blank and v2.available and v2.id != blank
                if look_variant_ids != blank
                  assign look_variant_ids = look_variant_ids | append: ','
                endif
                assign look_variant_ids = look_variant_ids | append: v2.id
              endif
            endif
            if product_3 != blank
              assign v3 = product_3.selected_or_first_available_variant
              if v3 != blank and v3.available and v3.id != blank
                if look_variant_ids != blank
                  assign look_variant_ids = look_variant_ids | append: ','
                endif
                assign look_variant_ids = look_variant_ids | append: v3.id
              endif
            endif
          -%}

          <div class="lookbook-gallery__look-header">

            <div class="lookbook-gallery__look-header-main">
              <div class="lookbook-gallery__look-number">
                0{{ forloop.index }}
              </div>

              {% if block.settings.caption != blank %}
                <p class="lookbook-gallery__caption">
                  {{ block.settings.caption | escape }}
                </p>
              {% else %}
                <p class="lookbook-gallery__caption">
                  Everyday, their way.
                </p>
              {% endif %}
            </div>

            {%- if look_variant_ids != blank -%}
              <button
                type="button"
                class="lookbook-gallery__add-look lookbook-gallery__add-look--header"
                data-look-add-all
                data-variant-ids="{{ look_variant_ids }}"
              >
                Add look to cart
              </button>
            {%- else -%}
              <span class="lookbook-gallery__look-arrow" aria-hidden="true">↘</span>
            {%- endif -%}

          </div>

          <div class="lookbook-gallery__stage">

            <div class="lookbook-gallery__stage-glow"></div>

            <div class="lookbook-gallery__stage-label">
              <span>THE LOOK</span>
              <span>0{{ forloop.index }}</span>
            </div>

            {% if product_1 != blank %}

              <button
                type="button"
                class="
                  lookbook-gallery__product
                  lookbook-gallery__product--one
                "
                data-look-product
                data-look-add
                data-product-id="{{ product_1.id }}"
                data-variant-id="{{ product_1.selected_or_first_available_variant.id }}"
                data-available="{{ product_1.selected_or_first_available_variant.available }}"
                style="
                  --product-x: {{ block.settings.x1 }}%;
                  --product-y: {{ block.settings.y1 }}%;
                "
                aria-label="Add {{ product_1.title | escape }} to cart"
              >

                <span class="lookbook-gallery__product-image">

                  {% if product_1.featured_image %}
                    {{
                      product_1.featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 900',
                        sizes: '(max-width: 749px) 48vw, 28vw',
                        alt: product_1.title
                    }}
                  {% endif %}

                </span>

                <span class="lookbook-gallery__hotspot">
                  <span></span>
                </span>

                <span class="lookbook-gallery__product-info">
                  <strong>{{ product_1.title }}</strong>
                  <small>{{ product_1.price | money }}</small>
                </span>

              </button>

            {% endif %}


            {% if product_2 != blank %}

              <button
                type="button"
                class="
                  lookbook-gallery__product
                  lookbook-gallery__product--two
                "
                data-look-product
                data-look-add
                data-product-id="{{ product_2.id }}"
                data-variant-id="{{ product_2.selected_or_first_available_variant.id }}"
                data-available="{{ product_2.selected_or_first_available_variant.available }}"
                style="
                  --product-x: {{ block.settings.x2 }}%;
                  --product-y: {{ block.settings.y2 }}%;
                "
                aria-label="Add {{ product_2.title | escape }} to cart"
              >

                <span class="lookbook-gallery__product-image">

                  {% if product_2.featured_image %}
                    {{
                      product_2.featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 900',
                        sizes: '(max-width: 749px) 48vw, 28vw',
                        alt: product_2.title
                    }}
                  {% endif %}

                </span>

                <span class="lookbook-gallery__hotspot">
                  <span></span>
                </span>

                <span class="lookbook-gallery__product-info">
                  <strong>{{ product_2.title }}</strong>
                  <small>{{ product_2.price | money }}</small>
                </span>

              </button>

            {% endif %}


            {% if product_3 != blank %}

              <button
                type="button"
                class="
                  lookbook-gallery__product
                  lookbook-gallery__product--three
                "
                data-look-product
                data-look-add
                data-product-id="{{ product_3.id }}"
                data-variant-id="{{ product_3.selected_or_first_available_variant.id }}"
                data-available="{{ product_3.selected_or_first_available_variant.available }}"
                style="
                  --product-x: {{ block.settings.x3 }}%;
                  --product-y: {{ block.settings.y3 }}%;
                "
                aria-label="Add {{ product_3.title | escape }} to cart"
              >

                <span class="lookbook-gallery__product-image">

                  {% if product_3.featured_image %}
                    {{
                      product_3.featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '400, 600, 800, 900',
                        sizes: '(max-width: 749px) 48vw, 28vw',
                        alt: product_3.title
                    }}
                  {% endif %}

                </span>

                <span class="lookbook-gallery__hotspot">
                  <span></span>
                </span>

                <span class="lookbook-gallery__product-info">
                  <strong>{{ product_3.title }}</strong>
                  <small>{{ product_3.price | money }}</small>
                </span>

              </button>

            {% endif %}


            {% if product_1 == blank and product_2 == blank and product_3 == blank %}

              <div class="lookbook-gallery__empty">

                <span class="lookbook-gallery__empty-number">
                  0{{ forloop.index }}
                </span>

                <p>
                  Add products to this look
                  from the Theme Editor.
                </p>

              </div>

            {% endif %}

            <div class="lookbook-gallery__decor lookbook-gallery__decor--one"></div>
            <div class="lookbook-gallery__decor lookbook-gallery__decor--two"></div>

          </div>

          <div class="lookbook-gallery__look-footer">

            <span>
              {% if block.settings.caption != blank %}
                {{ block.settings.caption | escape }}
              {% else %}
                A little more life, together.
              {% endif %}
            </span>

            <span class="lookbook-gallery__discover">
              Tap a piece to add it · or use Add look above
            </span>

          </div>

        </article>

      {% endfor %}

    </div>

    <footer class="lookbook-gallery__footer">

      <div class="lookbook-gallery__footer-line"></div>

      <p>
        See something they love?
        Make it part of their everyday.
      </p>

      <div class="lookbook-gallery__footer-line"></div>

    </footer>

  </div>
</section>

{% schema %}
{
  "name": "Lookbook Gallery",
  "tag": "section",
  "class": "section-lookbook-gallery",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lookbook"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Shop the looks"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Hotspot",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Everyday, their way."
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "range",
          "id": "x1",
          "label": "Product 1 horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 30
        },
        {
          "type": "range",
          "id": "y1",
          "label": "Product 1 vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 40
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "range",
          "id": "x2",
          "label": "Product 2 horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 60
        },
        {
          "type": "range",
          "id": "y2",
          "label": "Product 2 vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 55
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "range",
          "id": "x3",
          "label": "Product 3 horizontal position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 45
        },
        {
          "type": "range",
          "id": "y3",
          "label": "Product 3 vertical position",
          "min": 5,
          "max": 95,
          "step": 1,
          "default": 70
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook Gallery",
      "blocks": [
        {
          "type": "look"
        },
        {
          "type": "look"
        }
      ]
    }
  ]
}
{% endschema %}