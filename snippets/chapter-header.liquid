{% comment %}
  Petlio shared chapter framing.
  Use across homepage and key sections so the site reads as sequential
  chapters of life with pets instead of a generic section stack.

  Accepts:
  - number: chapter number (string or number), e.g. "02"
  - label: short uppercase label, e.g. "Everyday essentials"
  - compact: boolean (optional)
{% endcomment %}

{%- liquid
  assign chapter_number = number | default: ''
  assign chapter_label = label | default: ''
  assign is_compact = compact | default: false
-%}

{%- if chapter_number != blank or chapter_label != blank -%}
  <div class="petlio-chapter{% if is_compact %} petlio-chapter--compact{% endif %}" aria-hidden="true">
    {%- if chapter_number != blank -%}
      <span class="petlio-chapter__number">{{ chapter_number }}</span>
    {%- endif -%}
    <span class="petlio-chapter__line"></span>
    {%- if chapter_label != blank -%}
      <span class="petlio-chapter__label">{{ chapter_label | escape }}</span>
    {%- endif -%}
  </div>
{%- endif -%}
