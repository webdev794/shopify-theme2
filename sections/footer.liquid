{%- comment -%}
  Footer — Premium redesign
  • Refined brand column with gradient logo text
  • Elegant menu columns with hover animations
  • Premium newsletter with underline-only field
  • Contact information with icons
  • Decorative elements and refined spacing
{%- endcomment -%}

{{ 'footer.css' | asset_url | stylesheet_tag }}

<footer class="footer color-scheme-{{ section.settings.color_scheme | default: 'default' }}">
  {%- comment -%} Signature ornament: hairline with diamond mark {%- endcomment -%}
  <div class="footer__ornament" aria-hidden="true">
    <span class="footer__ornament-mark"></span>
  </div>

  <div class="footer__inner page-width">

    {%- comment -%} ── Top: brand / menus / newsletter ── {%- endcomment -%}
    <div class="footer__top">

      <!-- Brand Column -->
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo">
          {%- if section.settings.logo -%}
            {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name, widths: '150, 300', sizes: '150px', class: 'footer__logo-img' }}
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>

        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.show_contact_info -%}
          <div class="footer__contact-info">
            {%- if section.settings.phone != blank -%}
              <div class="footer__contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.574 2.81.7A2 2 0 0122 16.92z"/>
                </svg>
                <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
              </div>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <div class="footer__contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
                <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
              </div>
            {%- endif -%}
            {%- if section.settings.address != blank -%}
              <div class="footer__contact-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
                <span>{{ section.settings.address }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <ul class="footer__social" role="list">
            {%- if settings.social_instagram_link != blank -%}
              <li>
                <a href="{{ settings.social_instagram_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
                  {% render 'icon-instagram' %}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_facebook_link != blank -%}
              <li>
                <a href="{{ settings.social_facebook_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Facebook">
                  {% render 'icon-facebook' %}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}
              <li>
                <a href="{{ settings.social_tiktok_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="TikTok">
                  {% render 'icon-tiktok' %}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_youtube_link != blank -%}
              <li>
                <a href="{{ settings.social_youtube_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="YouTube">
                  {% render 'icon-youtube' %}
                </a>
              </li>
            {%- endif -%}
            {%- if settings.social_twitter_link != blank -%}
              <li>
                <a href="{{ settings.social_twitter_link }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Twitter">
                  {% render 'icon-twitter' %}
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      <!-- Menus -->
      <div class="footer__menus">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_list' -%}
              <nav class="footer__menu" aria-label="{{ block.settings.heading | default: block.settings.menu.title }}" {{ block.shopify_attributes }}>
                {%- assign col_heading = block.settings.heading | default: block.settings.menu.title -%}
                {%- if col_heading != blank -%}
                  <h2 class="footer__heading">{{ col_heading }}</h2>
                {%- endif -%}
                <ul class="footer__menu-list" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>

            {%- when 'text' -%}
              <div class="footer__menu footer__text-block" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <div class="footer__richtext">{{ block.settings.text }}</div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <!-- Newsletter -->
      {%- if section.settings.show_newsletter -%}
        <div class="footer__newsletter">
          <h2 class="footer__heading">{{ section.settings.newsletter_heading | default: 'Stay in the loop' }}</h2>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}

          {%- form 'customer', class: 'footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="footer__field">
              <label for="Footer-NewsletterEmail" class="visually-hidden">{{ 'general.newsletter.email_label' | t | default: 'Email' }}</label>
              <input
                id="Footer-NewsletterEmail"
                type="email"
                name="contact[email]"
                class="footer__input"
                value="{{ form.email }}"
                placeholder="{{ 'general.newsletter.email_placeholder' | t | default: 'Your email address' }}"
                required
                autocomplete="email"
              >
              <button type="submit" class="footer__submit" aria-label="{{ 'general.newsletter.submit' | t | default: 'Subscribe' }}">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </button>
            </div>

            {%- if form.errors -%}
              <p class="footer__form-message footer__form-message--error" role="alert">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="footer__form-message footer__form-message--success" role="status">
                {{ 'general.newsletter.success' | t | default: 'Thanks for subscribing!' }}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── Bottom bar: copyright / payments / links ── {%- endcomment -%}
    <div class="footer__bottom">
      <div class="footer__copyright">
        <span>&copy; {{ 'now' | date: '%Y' }}</span>
        <span class="footer__copyright-separator">|</span>
        <span>{{ shop.name | link_to: routes.root_url }}</span>
        <span class="footer__copyright-separator">|</span>
        <span class="footer__powered">{{ powered_by_link }}</span>
      </div>

      {%- if section.settings.show_bottom_links -%}
        <div class="footer__bottom-links">
          {%- for link in section.settings.bottom_menu.links -%}
            <a href="{{ link.url }}" class="footer__bottom-link">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment" role="list" aria-label="{{ 'general.payment_methods' | t | default: 'Payment methods' }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "shopify-section--footer",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.footer.settings.logo.label"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "t:sections.footer.settings.tagline.label",
      "default": "Quality products, thoughtfully made."
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__contact.content"
    },
    {
      "type": "checkbox",
      "id": "show_contact_info",
      "label": "t:sections.footer.settings.show_contact_info.label",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.footer.settings.phone.label",
      "default": "+1 (555) 123-4567"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.footer.settings.email.label",
      "default": "hello@example.com"
    },
    {
      "type": "text",
      "id": "address",
      "label": "t:sections.footer.settings.address.label",
      "default": "123 Design District, New York, NY 10001"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.footer.settings.show_newsletter.label",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "t:sections.footer.settings.newsletter_heading.label",
      "default": "Stay in the loop"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "t:sections.footer.settings.newsletter_text.label",
      "default": "New arrivals, exclusive offers, and more — straight to your inbox."
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__3.content"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.footer.settings.show_social.label",
      "default": true,
      "info": "t:sections.footer.settings.show_social.info"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__4.content"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__bottom.content"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_links",
      "label": "t:sections.footer.settings.show_bottom_links.label",
      "default": true
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "t:sections.footer.settings.bottom_menu.label",
      "info": "t:sections.footer.settings.bottom_menu.info",
      "default": "footer"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label",
          "info": "t:sections.footer.blocks.link_list.settings.heading.info"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:labels.menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.footer.blocks.text.settings.text.label",
          "default": "<p>Share store details, contact info, or brand values with your customers.</p>"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}