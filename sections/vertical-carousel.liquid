{% comment %}
  Vertical Carousel Section
  Version: 1.2
{% endcomment %}

{{ 'vertical-carousel.css' | asset_url | stylesheet_tag }}

<div class="vertical-carousel"
     data-section-id="{{ section.id }}"
     data-section-type="vertical-carousel"
     data-autoplay="{{ section.settings.autoplay }}"
     data-autoplay-speed="{{ section.settings.autoplay_speed }}"
     data-transition-speed="{{ section.settings.transition_speed }}"
     data-stop-on-hover="{{ section.settings.stop_on_hover }}"
     style="
       --vc-height: {{ section.settings.height }}px;
       --vc-bg: {{ section.settings.background_color }};
       --vc-text-color: {{ section.settings.text_color }};
       --vc-title-color: {{ section.settings.title_color | default: section.settings.text_color }};
       --vc-icon-color: {{ section.settings.icon_color | default: section.settings.text_color }};
       --vc-button-bg: {{ section.settings.button_background_color }};
       --vc-button-text: {{ section.settings.button_text_color }};
       --vc-nav-color: {{ section.settings.nav_color }};
       --vc-nav-bg: {{ section.settings.nav_background }};
       --vc-indicator-color: {{ section.settings.indicator_color }};
       --vc-indicator-active: {{ section.settings.indicator_active_color }};
     ">

  <div class="vertical-carousel__container">
    <div class="vertical-carousel__wrapper">
      <div class="vertical-carousel__track" role="list" aria-label="{{ section.settings.aria_label | default: 'Carousel slides' }}">
        {%- for block in section.blocks -%}
          <div class="vertical-carousel__slide"
               role="listitem"
               data-index="{{ forloop.index0 }}"
               style="background-color: {{ block.settings.slide_background | default: 'transparent' }};"
               {{ block.shopify_attributes }}>

            <div class="vertical-carousel__content">
              {%- if block.settings.icon != 'none' -%}
                <div class="vertical-carousel__icon">
                  {%- render 'vertical-carousel-icon', icon: block.settings.icon -%}
                </div>
              {%- endif -%}

              <div class="vertical-carousel__text-wrapper">
                {%- if block.settings.title != blank -%}
                  <h3 class="vertical-carousel__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="vertical-carousel__text">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}" class="vertical-carousel__button">
                    {{ block.settings.button_text | escape }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Navigation Arrows -->
    <button class="vertical-carousel__nav vertical-carousel__nav--prev" aria-label="{{ 'sections.vertical_carousel.previous_slide' | t }}" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M7.41 15.41L12 10.83L16.59 15.41L18 14L12 8L6 14L7.41 15.41Z"/>
      </svg>
    </button>

    <button class="vertical-carousel__nav vertical-carousel__nav--next" aria-label="{{ 'sections.vertical_carousel.next_slide' | t }}" type="button">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M7.41 8.59L12 13.17L16.59 8.59L18 10L12 16L6 10L7.41 8.59Z"/>
      </svg>
    </button>

    {%- if section.settings.show_indicators -%}
      <div class="vertical-carousel__indicators" role="tablist">
        {%- for block in section.blocks -%}
          <button class="vertical-carousel__indicator{% if forloop.first %} vertical-carousel__indicator--active{% endif %}"
                  role="tab"
                  aria-label="{{ 'sections.vertical_carousel.go_to_slide' | t: index: forloop.index }}"
                  data-index="{{ forloop.index0 }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  type="button">
            <span class="vertical-carousel__indicator-dot"></span>
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'vertical-carousel.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.vertical_carousel.name",
  "tag": "section",
  "class": "vertical-carousel-section",
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "t:sections.vertical_carousel.settings.header__1.content" },
    {
      "type": "range", "id": "height", "label": "t:sections.vertical_carousel.settings.height.label", "min": 200, "max": 600, "step": 10, "default": 400, "unit": "px"
    },
    { "type": "checkbox", "id": "autoplay", "label": "t:sections.vertical_carousel.settings.autoplay.label", "default": true },
    {
      "type": "range", "id": "autoplay_speed", "label": "t:sections.vertical_carousel.settings.autoplay_speed.label", "min": 2000, "max": 9000, "step": 500, "default": 5000, "unit": "ms"
    },
    {
      "type": "range", "id": "transition_speed", "label": "t:sections.vertical_carousel.settings.transition_speed.label", "min": 300, "max": 1500, "step": 100, "default": 600, "unit": "ms"
    },
    { "type": "checkbox", "id": "stop_on_hover", "label": "t:sections.vertical_carousel.settings.stop_on_hover.label", "default": true },
    { "type": "checkbox", "id": "show_indicators", "label": "t:sections.vertical_carousel.settings.show_indicators.label", "default": true },
    { "type": "header", "content": "t:sections.vertical_carousel.settings.header__2.content" },
    { "type": "color", "id": "background_color", "label": "t:sections.vertical_carousel.settings.background_color.label", "default": "#f5f5f5" },
    { "type": "color", "id": "text_color", "label": "Slide text color", "default": "#1a1a1a" },
    { "type": "color", "id": "title_color", "label": "Title color", "default": "#1a1a1a" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#1a1a1a" },
    { "type": "color", "id": "button_background_color", "label": "Button background color", "default": "#1a1a1a" },
    { "type": "color", "id": "button_text_color", "label": "Button text color", "default": "#f5f5f5" },
    { "type": "color", "id": "nav_color", "label": "t:sections.vertical_carousel.settings.nav_color.label", "default": "#ffffff" },
    { "type": "color", "id": "nav_background", "label": "t:sections.vertical_carousel.settings.nav_background.label", "default": "rgba(0, 0, 0, 0.5)" },
    { "type": "color", "id": "indicator_color", "label": "t:sections.vertical_carousel.settings.indicator_color.label", "default": "rgba(255, 255, 255, 0.5)" },
    { "type": "color", "id": "indicator_active_color", "label": "t:sections.vertical_carousel.settings.indicator_active_color.label", "default": "#ffffff" },
    { "type": "header", "content": "t:sections.vertical_carousel.settings.header__3.content" },
    { "type": "text", "id": "aria_label", "label": "t:sections.vertical_carousel.settings.aria_label.label", "default": "Vertical carousel of content" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.vertical_carousel.blocks.slide.name",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.vertical_carousel.blocks.slide.settings.title.label", "default": "Slide Title" },
        { "type": "richtext", "id": "text", "label": "t:sections.vertical_carousel.blocks.slide.settings.text.label", "default": "<p>Add your content here.</p>" },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.label",
          "default": "star",
          "options": [
            { "value": "none", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__1.label" },
            { "value": "star", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__2.label" },
            { "value": "heart", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__3.label" },
            { "value": "sparkle", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__4.label" },
            { "value": "arrow", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__5.label" },
            { "value": "cart", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__6.label" },
            { "value": "tag", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__7.label" },
            { "value": "truck", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__8.label" },
            { "value": "gift", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__9.label" },
            { "value": "check", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__10.label" },
            { "value": "shield", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__11.label" },
            { "value": "clock", "label": "t:sections.vertical_carousel.blocks.slide.settings.icon.options__12.label" }
          ]
        },
        { "type": "color", "id": "slide_background", "label": "t:sections.vertical_carousel.blocks.slide.settings.slide_background.label", "default": "transparent" },
        { "type": "text", "id": "button_text", "label": "t:sections.vertical_carousel.blocks.slide.settings.button_text.label", "default": "Learn More" },
        { "type": "url", "id": "button_link", "label": "t:sections.vertical_carousel.blocks.slide.settings.button_link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.vertical_carousel.presets.name",
      "category": "Promotional",
      "blocks": [
        { "type": "slide", "settings": { "title": "Welcome to Our Store", "text": "<p>Discover our amazing collection of products designed just for you.</p>", "icon": "star", "button_text": "Shop Now", "button_link": "/collections/all" } },
        { "type": "slide", "settings": { "title": "Free Shipping", "text": "<p>Enjoy free shipping on all orders over $50. No code needed!</p>", "icon": "truck", "button_text": "Learn More", "button_link": "/pages/shipping" } },
        { "type": "slide", "settings": { "title": "New Collection", "text": "<p>Explore our latest arrivals and find your perfect style.</p>", "icon": "sparkle", "button_text": "View Collection", "button_link": "/collections/new" } }
      ]
    }
  ]
}
{% endschema %}
