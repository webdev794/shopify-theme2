{% comment %} Featured Collections Tabs {% endcomment %}

<link rel="stylesheet" href="{{ 'section-featured-collections-tabs.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'section-featured-collections-tabs.css' | asset_url }}"></noscript>

{%- liquid
  case section.settings.heading_alignment
    when 'left'
      assign tabs_justify = 'flex-start'
    when 'right'
      assign tabs_justify = 'flex-end'
    else
      assign tabs_justify = 'center'
  endcase
-%}

<div
  class="featured-collections-tabs section-{{ section.id }} page-width"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; --tabs-justify: {{ tabs_justify }};"
>
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="section-header text-{{ section.settings.heading_alignment }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Count usable tabs (blocks with a real collection) {%- endcomment -%}
  {%- assign has_real_collections = false -%}
  {%- for block in section.blocks -%}
    {%- assign c = collections[block.settings.collection] -%}
    {%- if c != empty and c.products.size > 0 -%}
      {%- assign has_real_collections = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_real_collections -%}
    <div class="tabs-nav" role="tablist">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        {%- if collection != empty and collection.products.size > 0 -%}
          <button
            class="tab-button{% if forloop.first %} active{% endif %}"
            data-tab="{{ block.id }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="tab-content-{{ block.id }}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_title | default: collection.title | escape }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="tabs-content">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        {%- if collection != empty and collection.products.size > 0 -%}
          <div
            id="tab-content-{{ block.id }}"
            class="tab-panel{% if forloop.first %} active{% endif %}"
            role="tabpanel"
            data-tab="{{ block.id }}"
          >
            {%- assign cols_tablet = section.settings.columns_desktop | at_most: 2 -%}
            <div
              class="products-grid"
              style="--cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: {{ cols_tablet }}; --cols-desktop: {{ section.settings.columns_desktop }};"
            >
              {%- for product in collection.products limit: section.settings.products_to_show -%}
                {% render 'card-product',
                  card_product: product,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  media_aspect_ratio: section.settings.image_ratio,
                  show_quick_add: false
                %}
              {%- endfor -%}
            </div>

            {%- if section.settings.show_view_all -%}
              <div class="view-all-wrapper text-center">
                <a href="{{ collection.url }}" class="button button--secondary">
                  {{ 'sections.featured_collection.view_all' | t }} {{ collection.title | escape }}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  {%- else -%}
    {%- comment -%} Fresh install / no collections selected: show placeholders so the section is never blank {%- endcomment -%}
    <div class="tabs-nav" role="tablist">
      <button class="tab-button active" role="tab" aria-selected="true" tabindex="0">New arrivals</button>
      <button class="tab-button" role="tab" aria-selected="false" tabindex="-1" disabled>Best sellers</button>
    </div>

    <div class="tabs-content">
      <div class="tab-panel active" role="tabpanel">
        {%- assign cols_tablet = section.settings.columns_desktop | at_most: 2 -%}
        <div
          class="products-grid"
          style="--cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: {{ cols_tablet }}; --cols-desktop: {{ section.settings.columns_desktop }};"
        >
          {%- for i in (1..section.settings.products_to_show) -%}
            {%- assign placeholder_index = forloop.index | modulo: 6 | plus: 1 -%}
            <div class="card-wrapper">
              <div class="card">
                <div class="card__media">
                  {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'card__image placeholder-svg' }}
                </div>
                <div class="card__content">
                  <h3 class="card__title">Example product</h3>
                  <div class="card__price">$29.99</div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

<script src="{{ 'section-featured-collections-tabs.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.featured_collections_tabs.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collections_tabs.settings.heading",
      "default": "Featured Collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.featured_collections_tabs.settings.subheading",
      "default": "Shop our curated selections"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.featured_collections_tabs.settings.heading_size",
      "options": [
        { "value": "heading--medium", "label": "Default" },
        { "value": "heading--large", "label": "Large" },
        { "value": "heading--small", "label": "Small" }
      ],
      "default": "heading--medium"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.featured_collections_tabs.settings.heading_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collections_tabs.settings.products_to_show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:sections.featured_collections_tabs.settings.columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "t:sections.featured_collections_tabs.settings.columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.featured_collections_tabs.settings.show_vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:sections.featured_collections_tabs.settings.show_rating",
      "default": false
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.featured_collections_tabs.settings.image_ratio",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collections_tabs.settings.show_view_all",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.featured_collections_tabs.settings.padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.featured_collections_tabs.settings.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.featured_collections_tabs.blocks.collection.name",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "t:sections.featured_collections_tabs.blocks.collection.settings.tab_title",
          "info": "Optional. Defaults to collection title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.featured_collections_tabs.blocks.collection.settings.collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collections_tabs.presets.name",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
