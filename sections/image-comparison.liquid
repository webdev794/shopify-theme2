{% comment %}
  Image Comparison Section
  Version: 1.0
  Description: A before/after image comparison slider with drag functionality
{% endcomment %}

{{ 'image-comparison.css' | asset_url | stylesheet_tag }}

<div class="image-comparison" 
     data-section-id="{{ section.id }}" 
     data-section-type="image-comparison"
     data-default-position="{{ section.settings.default_position }}"
     style="
       --ic-height: {{ section.settings.section_height }}px;
       --ic-border-radius: {{ section.settings.border_radius }}px;
     ">
  
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="image-comparison__header">
        <h2 class="image-comparison__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="image-comparison__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="image-comparison__wrapper">
      <div class="image-comparison__container">
        <!-- Before Image -->
        <div class="image-comparison__before">
          {%- if section.settings.before_image != blank -%}
            <img
              src="{{ section.settings.before_image | image_url: width: 1200, height: 800, crop: 'center' }}"
              srcset="{{ section.settings.before_image | image_url: width: 1200, height: 800, crop: 'center' }} 1x, {{ section.settings.before_image | image_url: width: 2400, height: 1600, crop: 'center' }} 2x"
              alt="{{ section.settings.before_label | default: 'Before' | escape }}"
              loading="lazy"
              width="1200"
              height="800"
              class="image-comparison__image"
            >
            {%- if section.settings.show_labels -%}
              <span class="image-comparison__label image-comparison__label--before">
                {{ section.settings.before_label | default: 'Before' | escape }}
              </span>
            {%- endif -%}
          {%- else -%}
            <div class="image-comparison__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'image-comparison__placeholder-svg' }}
              <span class="image-comparison__placeholder-label">{{ section.settings.before_label | default: 'Before' | escape }}</span>
            </div>
          {%- endif -%}
        </div>

        <!-- After Image -->
        <div class="image-comparison__after">
          {%- if section.settings.after_image != blank -%}
            <img
              src="{{ section.settings.after_image | image_url: width: 1200, height: 800, crop: 'center' }}"
              srcset="{{ section.settings.after_image | image_url: width: 1200, height: 800, crop: 'center' }} 1x, {{ section.settings.after_image | image_url: width: 2400, height: 1600, crop: 'center' }} 2x"
              alt="{{ section.settings.after_label | default: 'After' | escape }}"
              loading="lazy"
              width="1200"
              height="800"
              class="image-comparison__image"
            >
            {%- if section.settings.show_labels -%}
              <span class="image-comparison__label image-comparison__label--after">
                {{ section.settings.after_label | default: 'After' | escape }}
              </span>
            {%- endif -%}
          {%- else -%}
            <div class="image-comparison__placeholder">
              {{ 'lifestyle-2' | placeholder_svg_tag: 'image-comparison__placeholder-svg' }}
              <span class="image-comparison__placeholder-label">{{ section.settings.after_label | default: 'After' | escape }}</span>
            </div>
          {%- endif -%}
        </div>

        <!-- Comparison Slider -->
        <div class="image-comparison__slider" role="slider" aria-label="{{ section.settings.aria_label | escape }}">
          <div class="image-comparison__handle">
            <div class="image-comparison__handle-line"></div>
            <div class="image-comparison__handle-circle">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M8 5v14l-4-4M16 5v14l4-4"/>
              </svg>
            </div>
          </div>
        </div>
      </div>

      {%- if section.settings.show_description -%}
        <div class="image-comparison__description">
          <div class="image-comparison__description-item">
            <span class="image-comparison__description-dot image-comparison__description-dot--before"></span>
            <span class="image-comparison__description-label">{{ section.settings.before_label | default: 'Before' | escape }}</span>
          </div>
          <div class="image-comparison__description-item">
            <span class="image-comparison__description-dot image-comparison__description-dot--after"></span>
            <span class="image-comparison__description-label">{{ section.settings.after_label | default: 'After' | escape }}</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'image-comparison.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.image_comparison.name",
  "tag": "section",
  "class": "image-comparison-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image_comparison.settings.heading.label",
      "default": "Before & After"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.image_comparison.settings.subheading.label",
      "default": "See the transformation for yourself"
    },
    { "type": "header", "content": "t:sections.image_comparison.settings.header__1.content" },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "t:sections.image_comparison.settings.before_image.label",
      "info": "t:sections.image_comparison.settings.before_image.info"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "t:sections.image_comparison.settings.after_image.label",
      "info": "t:sections.image_comparison.settings.after_image.info"
    },
    { "type": "header", "content": "t:sections.image_comparison.settings.header__2.content" },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "t:sections.image_comparison.settings.show_labels.label",
      "default": true
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "t:sections.image_comparison.settings.before_label.label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "t:sections.image_comparison.settings.after_label.label",
      "default": "After"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.image_comparison.settings.show_description.label",
      "default": true
    },
    { "type": "header", "content": "t:sections.image_comparison.settings.header__3.content" },
    {
      "type": "range",
      "id": "default_position",
      "label": "t:sections.image_comparison.settings.default_position.label",
      "min": 10,
      "max": 90,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "t:sections.image_comparison.settings.section_height.label",
      "min": 300,
      "max": 800,
      "step": 50,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:sections.image_comparison.settings.border_radius.label",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    { "type": "header", "content": "t:sections.image_comparison.settings.header__4.content" },
    {
      "type": "text",
      "id": "aria_label",
      "label": "t:sections.image_comparison.settings.aria_label.label",
      "default": "Image comparison slider showing before and after"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_comparison.presets.name",
      "category": "Media"
    }
  ]
}
{% endschema %}
